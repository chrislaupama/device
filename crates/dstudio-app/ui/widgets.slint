// Reusable widgets for the Device Studio shell.
// All icons are simple vector drawings (16x16 viewbox).
import { Tokens } from "tokens.slint";

// Rounded panel with a 0.5 pt top highlight.
export component Panel inherits Rectangle {
    background: Tokens.bg-panel;
    border-radius: Tokens.panel-radius;
    border-width: 0.5px;
    border-color: @linear-gradient(180deg, Tokens.panel-edge-top 0%, Tokens.panel-edge-bottom 100%);
    clip: true;
}

// ---- Depth: the soft raised / inset look of the controls -------------------------------------
// Raised: 1 px light top lip that thins out down the sides, soft
// shadow just below. Inset: 1 px dark top lip, a short inner shadow, 1 px light bottom lip.
//
// Both are built from stacked solid rounded rectangles offset by a lip, not from gradient
// brushes: in FemtoVG every gradient fill or stroke costs far more than a solid one
// (measured +0.75 ms/frame for ~20 controls, against ~0 for the stacked version).

// Raised control surface (pills, dropdowns, value boxes, buttons).
export component Raised inherits Rectangle {
    in property <brush> fill: Tokens.bg-control;
    in property <color> rim: Tokens.raised-rim;
    /// Even outline (value boxes) instead of a top-only highlight.
    in property <bool> outline: false;
    /// Soft shadow underneath.
    in property <bool> lifted: true;
    property <length> r: min(self.border-radius, self.height / 2);
    background: root.rim;
    drop-shadow-offset-y: root.lifted ? 1.2px : 0px;
    drop-shadow-blur: root.lifted ? 3px : 0px;
    drop-shadow-color: root.lifted ? Tokens.raised-shadow : transparent;
    // face: shifted down by the lip (top-only highlight), or inset on all sides (outline)
    Rectangle {
        x: root.outline ? Tokens.hairline : 0px;
        y: Tokens.hairline;
        width: root.outline ? root.width - 2 * Tokens.hairline : root.width;
        height: root.height - (root.outline ? 2 : 1) * Tokens.hairline;
        border-radius: max(0px, root.r - (root.outline ? Tokens.hairline : 0px));
        background: root.fill;
    }
}

// Search / text field: flat fill with an even hairline outline.
export component Field inherits Rectangle {
    background: Tokens.bg-control;
    border-width: Tokens.hairline;
    border-color: Tokens.field-rim;
}

// Inset well (slider grooves, the transport bar, the fader slot).
export component Inset inherits Rectangle {
    in property <color> fill: Tokens.bg-slider-track;
    /// Lip thickness: 1 device px on small grooves, 2 on the transport bar.
    in property <length> lip: Tokens.hairline;
    /// Depth of the inner shadow below the top lip.
    in property <length> shade: 1.2px;
    in property <color> top: Tokens.inset-top;
    in property <color> bottom: Tokens.inset-bottom;
    property <length> r: min(self.border-radius, self.height / 2);
    // light bottom lip shows below the dark layer
    background: root.bottom;
    Rectangle { y: 0; width: root.width; height: root.height - root.lip; border-radius: root.r; background: root.top; }
    // inner shadow in two steps, then the face
    Rectangle { y: root.lip; width: root.width; height: root.height - 2 * root.lip; border-radius: root.r; background: Tokens.inset-shade; }
    Rectangle { y: root.lip + root.shade / 2; width: root.width; height: root.height - 2 * root.lip - root.shade / 2; border-radius: root.r; background: Tokens.inset-shade.mix(root.fill, 0.5); }
    Rectangle { y: root.lip + root.shade; width: root.width; height: root.height - 2 * root.lip - root.shade; border-radius: root.r; background: root.fill; }
}

// Stroked line icon. `d` is an SVG path in a 16x16 box.
export component Icon inherits Rectangle {
    in property <string> d;
    in property <color> ink: Tokens.icon;
    in property <bool> filled: false;
    in property <length> stroke-width: 1.3px;
    width: 16px;
    height: 16px;
    Path {
        width: root.width;
        height: root.height;
        commands: root.d;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.filled ? transparent : root.ink;
        fill: root.filled ? root.ink : transparent;
        stroke-width: root.stroke-width;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

