// Fully rounded pill button (Returns, Master, Smart Fill, Report a bug).
export component Pill inherits Raised {
    in property <string> text;
    in property <string> icon: "";
    in property <int> weight: 600;
    in property <bool> active: false;
    in property <length> font-size: 9px;
    in property <length> letter-spacing: 0;
    in property <color> text-color: active ? Tokens.on-accent : #c9c9cc;
    callback clicked;
    border-radius: self.height / 2;
    fill: active ? Tokens.accent : Tokens.bg-control;
    rim: active ? Tokens.raised-rim-accent : Tokens.raised-rim;
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        if root.icon != "": Rectangle {
            width: 12px;
            Icon { d: root.icon; width: 12px; height: 12px; ink: root.text-color; }
        }
        Text { text: root.text; color: root.text-color; font-size: root.font-size; font-weight: root.weight; letter-spacing: root.letter-spacing; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Square icon toggle/button.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink: Tokens.icon;
    in property <length> icon-size: 16px;
    in property <bool> filled: false;
    in property <string> tooltip;
    /// Toggle state: drawn in the accent colour when on.
    in property <bool> active: false;
    callback clicked;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-checked: active;
    Icon { d: root.icon; width: root.icon-size; height: root.icon-size; ink: root.active ? Tokens.accent : (ta.has-hover ? Tokens.text-primary : root.ink); filled: root.filled; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Tiny M/S/R/I button (11x11 in track headers, 19x18 in the inspector).
export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> on: false;
    in property <color> on-color: Tokens.text-bright;
    in property <length> font-size: 6px;
    /// Inspector size: softer, slightly darker cap with a feathered shadow (track headers stay flat).
    in property <bool> soft: false;
    callback clicked;
    border-radius: 2px;
    background: on ? on-color : root.soft ? #2f3032 : Tokens.small-button;
    drop-shadow-blur: root.soft ? 1.5px : 0px;
    drop-shadow-color: root.soft ? #00000066 : transparent;
    Text { text: root.text; color: root.on ? #18191c : #afafb1; font-size: root.font-size; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// Horizontal volume slider: groove + white handle. `pos` is 0..1, mapping done in Rust.
export component HSlider inherits Rectangle {
    in property <float> pos;
    in property <length> handle-size: 7px;
    in property <color> handle-color: Tokens.handle;
    /// Groove lip: 1 device px on track sliders, 2 on the header volume.
    in property <length> lip: Tokens.hairline;
    callback moved(float);
    callback released();
    callback reset();
    property <length> travel: self.width - self.handle-size;
    groove := Inset {
        height: root.height;
        border-radius: self.height / 2;
        lip: root.lip;
        fill: root.lip > Tokens.hairline ? Tokens.bg-raised : Tokens.bg-slider-track;
        bottom: root.lip > Tokens.hairline ? Tokens.inset-bottom : #3f4044;
    }
    Rectangle {
        x: root.pos * root.travel;
        width: root.handle-size;
        height: root.handle-size;
        border-radius: self.width / 2;
        background: root.handle-color;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.moved(max(0, min(1, (self.mouse-x - root.handle-size / 2) / root.travel)));
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { root.moved(max(0, min(1, (self.mouse-x - root.handle-size / 2) / root.travel))); }
        double-clicked => { root.reset(); }
    }
}

// Rotary knob: dark body, value tick, optional value arc. Angles in degrees, 0 = up, clockwise.
export component Knob inherits Rectangle {
    in property <float> value-angle: 0;
    in property <bool> show-arc: false;
    in property <float> arc-from: -135;
    in property <length> body: 15.5px;
    /// Distance of the value arc outside the body.
    in property <float> arc-gap: 2.5;
    /// Soft dark outer ring (header/inspector knobs); mixer strips use a flat body.
    in property <bool> ring: true;
    /// Inspector style: flat face lifted by a soft shadow inside a 270° groove ring that
    /// carries the value arc (overrides `ring`). Bipolar knobs get a centre marker.
    in property <bool> groove: false;
    in property <float> groove-radius: 12.5;
    in property <color> groove-color: Tokens.knob-groove;
    in property <color> tick-color: #b9d3e4;
    in property <color> arc-color: Tokens.value-blue;
    in property <brush> ring-brush: @radial-gradient(circle, #111214 55%, #1c1d20 100%);
    in property <brush> body-brush: root.ring ? @linear-gradient(180deg, #202125 0%, Tokens.bg-knob 100%) : #222327;
    in property <length> arc-width: 1.5px;
    in property <float> value;      // current value forwarded to drags
    in property <float> min-value: -1;
    in property <float> max-value: 1;
    in property <float> sensitivity: 150; // px for the full range
    callback value-changed(float);
    callback released();
    callback reset();
    property <float> start-value;
    property <float> cx: self.width / 1px / 2;
    property <float> cy: self.height / 1px / 2;
    property <float> r: self.body / 1px / 2;
    property <float> arc-r: root.groove ? root.groove-radius : root.r + root.arc-gap;
    // groove ring (270°, open at the bottom)
    if root.groove: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.groove-color; stroke-width: 1.5px; fill: transparent;
        MoveTo { x: root.cx + root.groove-radius * sin(-135deg); y: root.cy - root.groove-radius * cos(-135deg); }
        ArcTo { x: root.cx + root.groove-radius * sin(135deg); y: root.cy - root.groove-radius * cos(135deg); radius-x: root.groove-radius; radius-y: root.groove-radius; large-arc: true; sweep: true; }
    }
    if root.groove: Rectangle {
        width: root.body; height: root.body;
        border-radius: self.width / 2;
        background: Tokens.knob-face;
        border-width: 0.45px; border-color: #262729;
        drop-shadow-offset-y: 2px; drop-shadow-blur: 5px; drop-shadow-color: #000000a6;
    }
    if root.groove && !root.show-arc: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.arc-color; stroke-width: 1.2px;
        MoveTo { x: root.cx; y: root.cy - root.groove-radius + 1.2; }
        LineTo { x: root.cx; y: root.cy - root.groove-radius - 1.5; }
    }
    // soft outer ring
    if root.ring && !root.groove: Rectangle {
        width: root.body + 7px; height: root.body + 7px;
        border-radius: self.width / 2;
        background: root.ring-brush;
    }
    if !root.groove: Rectangle {
        width: root.body; height: root.body;
        border-radius: self.width / 2;
        background: root.body-brush;
        border-width: root.ring ? 0.5px : 1px;
        border-color: root.ring ? #2e2f33 : #1b1c1f;
    }
    if root.show-arc: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.arc-color;
        stroke-width: root.arc-width;
        fill: transparent;
        MoveTo {
            x: root.cx + root.arc-r * sin(root.arc-from * 1deg);
            y: root.cy - root.arc-r * cos(root.arc-from * 1deg);
        }
        ArcTo {
            x: root.cx + root.arc-r * sin(root.value-angle * 1deg);
            y: root.cy - root.arc-r * cos(root.value-angle * 1deg);
            radius-x: root.arc-r;
            radius-y: root.arc-r;
            large-arc: abs(root.value-angle - root.arc-from) > 180;
            sweep: root.value-angle > root.arc-from;
        }
    }
    Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.tick-color;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        MoveTo { x: root.cx + root.r * 0.5 * sin(root.value-angle * 1deg); y: root.cy - root.r * 0.5 * cos(root.value-angle * 1deg); }
        LineTo { x: root.cx + root.r * 0.95 * sin(root.value-angle * 1deg); y: root.cy - root.r * 0.95 * cos(root.value-angle * 1deg); }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.start-value = root.value; }
            // A cancelled drag ends its gesture too.
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.released(); }
        }
        moved => {
            root.value-changed(max(root.min-value, min(root.max-value,
                root.start-value + (self.pressed-y - self.mouse-y) / 1px / root.sensitivity * (root.max-value - root.min-value))));
        }
        double-clicked => { root.reset(); }
    }
}

// On/off switch (Mono "Fold to mono").
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 20px; height: 11px;
    border-radius: self.height / 2;
    background: on ? Tokens.value-blue : #3a3b40;
    Rectangle {
        x: root.on ? root.width - self.width - 1px : 1px;
        width: 9px; height: 9px; border-radius: 4.5px;
        background: #ffffff;
    }
    TouchArea { clicked => { root.toggled(); } }
}

// A text label positioned at an AX rect (x, y, height) with vertical centring.
export component Label inherits Text {
    color: Tokens.text-primary;
    font-size: 9.5px;
    font-weight: 600;
    vertical-alignment: center;
    height: 14.5px; // fallback system font sits ~0.75 pt higher than Inter when centred in 13 pt
}

