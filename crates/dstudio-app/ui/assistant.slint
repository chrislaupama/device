// Assistant panel (right-docked, 252.5 pt) and the Point overlay.
// Docked chat.
// Our units are 0.85 of a CSS px at 100 % zoom (zoom.rs scales them back
// to 100 %), so every length below is CSS px x 0.85. Saturated colours are the Display P3
// values (sRGB #1253ff shows as #2752f5, #d0ff41 as #d9fe65).
// The transcript, mode, notice and context chip come from Rust; the composer text is
// transient input (Studio.chat-draft) sent through Studio.chat-send.
import { Tokens } from "tokens.slint";
import { Panel, Icon, Icons, Raised } from "widgets.slint";
import { Studio, ChatEntry, HighlightRect } from "studio.slint";

global Chat {
    // Ink (white at an alpha) and greys of the dark theme.
    out property <color> menu-text: #ffffff;
    out property <color> text: #81838a;          // --flow-text / gray-40
    out property <color> gray-30: #a6a8ad;
    out property <color> text-dim: #63656d;      // also --flow-chrome-icon
    out property <color> icon-hover: #8a8b91;
    out property <color> card: #212227;          // --flow-surface-card
    out property <color> disc: #292a2f;          // --flow-surface-raised (composer discs)
    out property <color> disc-hover: #48494f;    // --flow-bg-light
    out property <color> accent: #2752f5;
    out property <color> accent-hover: #608df7;
    out property <color> point: #d9fe65;         // Point mode lime
    out property <color> on-point: #1c2601;      // dark text on lime
    out property <color> alarm: #e57666;
    out property <color> step-done: #77db89;
    // Type: 12 px / 500, line 18 (x 0.85).
    out property <length> fs: 10.2px;
    out property <length> line: 15.3px;
    out property <length> ls: -0.204px;
}

// Point glyph: a pointer arrow (16 box).
global ChatIcons {
    out property <string> pointer: "M3.2 2.6L13.2 7.1L8.9 8.5L7.4 12.9Z";
}

// Disclosure chevron, 10 px compact (points down at rest, up when open).
component Chevron inherits Rectangle {
    in property <bool> open;
    in property <color> ink;
    width: 8.5px; height: 8.5px;
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 10; viewbox-height: 10;
        commands: root.open ? "M2 6.5L5 3.5L8 6.5" : "M2 3.5L5 6.5L8 3.5";
        stroke: root.ink; stroke-width: 1.3px; fill: transparent;
        stroke-line-cap: round; stroke-line-join: round;
    }
}

// Spinning sparkle of the live row (14 px, 1.2 s per turn).
component Spinner inherits Rectangle {
    in property <color> ink;
    width: 11.9px; height: 11.9px;
    Rectangle {
        width: parent.width; height: parent.height;
        cache-rendering-hint: true;
        transform-rotation: (animation-tick() / 1ms * 0.3) * 1deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Path {
            width: parent.width; height: parent.height;
            viewbox-width: 16; viewbox-height: 16;
            commands: "M8 1.5v4 M8 10.5v4 M1.5 8h4 M10.5 8h4 M3.4 3.4l2.2 2.2 M10.4 10.4l2.2 2.2 M12.6 3.4l-2.2 2.2 M5.6 10.4l-2.2 2.2";
            stroke: root.ink; stroke-width: 1.2px; fill: transparent; stroke-line-cap: round;
        }
    }
}

// Text with a band of light sweeping across it every 2 s (shimmer).
component Shimmer inherits Rectangle {
    in property <string> text;
    in property <color> base;
    in property <color> band;
    property <length> tw: t.preferred-width;
    property <float> phase: mod(animation-tick() / 1ms, 2000) / 2000;
    width: self.tw; height: Chat.line;
    property <float> s1: root.phase * 1.6 - 0.3;
    property <float> s2: root.phase * 1.6 - 0.15;
    property <float> s3: root.phase * 1.6;
    t := Text {
        text: root.text; font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls; vertical-alignment: center; height: parent.height;
        color: @linear-gradient(90deg, root.base 0%, root.base root.s1, root.band root.s2, root.base root.s3, root.base 100%);
    }
}

component ChatItem inherits Rectangle {
    in property <ChatEntry> e;
    in property <int> index;
    property <length> w: self.width;
    // Entry pop: 6 px rise + fade, 260 ms, only for entries added since the last rebuild.
    property <float> t: root.e.fresh ? 0 : 1;
    animate t { duration: 260ms; easing: cubic-bezier(0.22, 0.61, 0.36, 1); }
    init => { root.t = 1; }
    min-height: lay.preferred-height;
    lay := VerticalLayout {
        y: (1 - root.t) * 5.1px;
        opacity: root.t;
        padding-top: root.e.kind == 0 && root.index > 0 ? 8.5px : 0px;
        padding-bottom: root.e.kind == 0 ? 5.1px : 0px;
        spacing: 6.8px;
        // User prompt: right-aligned bubble (max 85 %), mode tag under it in Point mode.
        if root.e.kind == 0: HorizontalLayout {
            alignment: end;
            Rectangle {
                width: min(root.w * 0.85, user-text.preferred-width + 20.4px);
                height: user-text.preferred-height + 13.6px;
                border-radius: 13.6px;
                background: Chat.card;
                user-text := Text {
                    x: 10.2px; y: 6.8px; width: parent.width - 20.4px;
                    text: root.e.text; color: Chat.menu-text; font-size: Chat.fs; font-weight: 500;
                    letter-spacing: Chat.ls; wrap: word-wrap;
                }
            }
        }
        if root.e.kind == 0 && root.e.point: HorizontalLayout {
            alignment: end;
            padding-right: 3.4px;
            spacing: 3.4px;
            height: 11.9px;
            Icon { y: 1.7px; width: 8.5px; height: 8.5px; d: ChatIcons.pointer; filled: true; ink: Chat.point; }
            Text { text: "Point"; color: Chat.text-dim; font-size: 8.5px; font-weight: 600; vertical-alignment: center; }
        }
        // Assistant turn: step log ("Worked for …", collapsed), then the reply.
        if root.e.kind == 1 && root.e.lines.length > 0: VerticalLayout {
            spacing: 1.7px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: sum-text.preferred-width + 8.5px + 4.25px + 6.8px;
                    height: Chat.line;
                    property <color> ink: sum-ta.has-hover ? #ffffffb3 : #ffffff57;
                    Chevron { x: 3.4px; y: (parent.height - self.height) / 2; open: root.e.expanded; ink: parent.ink; }
                    sum-text := Text {
                        x: 3.4px + 8.5px + 4.25px; height: parent.height;
                        text: root.e.worked; color: parent.ink; font-size: Chat.fs; font-weight: 500;
                        letter-spacing: Chat.ls; vertical-alignment: center;
                    }
                    sum-ta := TouchArea { clicked => { Studio.chat-toggle-entry(root.index); } }
                }
            }
            if root.e.expanded: VerticalLayout {
                padding-top: 1.7px;
                for line in root.e.lines: Rectangle {
                    min-height: step-text.preferred-height + 5.1px;
                    border-radius: 5.1px;
                    Rectangle { x: 5.1px; y: 7.65px; width: 5.1px; height: 5.1px; border-radius: 2.55px; background: Chat.step-done.with-alpha(0.85); }
                    step-text := Text {
                        x: 18.7px; y: 2.55px; width: parent.width - 18.7px - 10.2px;
                        text: line; color: #ffffff9e; font-size: Chat.fs; font-weight: 500;
                        letter-spacing: Chat.ls; wrap: word-wrap;
                    }
                }
            }
        }
        if root.e.kind == 1: VerticalLayout {
            padding-left: 3.4px;
            padding-right: 3.4px;
            padding-bottom: 3.4px;
            Text {
                text: root.e.text;
                color: Chat.menu-text; font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls; wrap: word-wrap;
            }
        }
        // Error (plan rejected, network error...). Nothing was executed.
        if root.e.kind == 2: HorizontalLayout {
            padding-left: 3.4px;
            padding-right: 3.4px;
            Text { text: root.e.text; color: Chat.alarm; font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls; wrap: word-wrap; }
        }
        // Live row while a request runs: spinning sparkle + shimmering label (28 px).
        if root.e.kind == 3: Rectangle {
            height: 23.8px;
            Spinner { x: 0.85px; y: (parent.height - self.height) / 2; ink: #ffffff61; }
            Shimmer { x: 0.85px + 11.9px + 3.4px; y: (parent.height - self.height) / 2; text: root.e.text; base: #ffffff61; band: #ffffffb0; }
        }
    }
}

// Header button (24 px, radius 4): dim icon, lighter on hover.
component HeaderButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <length> icon-size: 14.85px;
    callback clicked;
    width: 20.4px; height: 20.4px; border-radius: 3.4px;
    accessible-role: button;
    accessible-label: root.tooltip;
    Icon { d: root.icon; width: root.icon-size; height: root.icon-size; stroke-width: 1.1px; ink: ta.has-hover ? #ffffffb3 : Chat.text-dim; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// One option of the mode switch: its own pill fades in when chosen (200 ms), ink follows.
component ModeOption inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> glyph-filled;
    in property <bool> chosen;
    in property <color> fill;
    in property <color> fill-hover;
    in property <color> rim;
    in property <color> on-fill;
    callback picked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.chosen;
    Raised {
        y: 1.7px; height: parent.height - 3.4px; border-radius: self.height / 2;
        fill: ta.has-hover ? root.fill-hover : root.fill;
        rim: root.rim;
        opacity: root.chosen ? 1 : 0;
        animate opacity { duration: 200ms; easing: ease; }
    }
    property <color> ink: root.chosen ? root.on-fill : (ta.has-hover ? #ffffffeb : Chat.gray-30);
    animate ink { duration: 200ms; easing: ease; }
    HorizontalLayout {
        alignment: center;
        spacing: 3.4px;
        Icon { y: (root.height - self.height) / 2; width: 10.2px; height: 10.2px; d: root.glyph; filled: root.glyph-filled; stroke-width: 1.275px; ink: root.ink; }
        Text { text: root.label; color: root.ink; font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.picked(); } }
}

// Assist / Point switch: 132 x 24 track, two equal options, 2 px gap.
component ModeSwitch inherits Raised {
    width: 112.2px; height: 20.4px; border-radius: self.height / 2;
    fill: Chat.disc;
    accessible-role: tab-list;
    accessible-label: "Assistant mode";
    property <length> ow: (self.width - 0.85px - 3.4px - 1.7px) / 2;
    ModeOption {
        x: 2.125px; y: 0.425px; width: root.ow; height: root.height - 0.85px;
        label: "Assist"; glyph: Icons.assistant; glyph-filled: true;
        chosen: !Studio.teach-mode;
        fill: Chat.accent; fill-hover: #4167f6; rim: Tokens.raised-rim-accent; on-fill: #fffffff5;
        picked => { Studio.chat-set-mode(false); }
    }
    ModeOption {
        x: 2.125px + root.ow + 1.7px; y: 0.425px; width: root.ow; height: root.height - 0.85px;
        label: "Point"; glyph: ChatIcons.pointer; glyph-filled: Studio.teach-mode;
        chosen: Studio.teach-mode;
        fill: Chat.point; fill-hover: #ddfe77; rim: #defe7c; on-fill: Chat.on-point;
        picked => { Studio.chat-set-mode(true); }
    }
}

// Round 24 px composer disc (mic / send / stop).
component Disc inherits Rectangle {
    in property <bool> enabled: true;
    in property <color> fill;
    in property <color> fill-hover;
    in property <string> tooltip;
    callback clicked;
    width: 20.4px; height: 20.4px; border-radius: 10.2px;
    accessible-role: button;
    accessible-label: root.tooltip;
    background: root.enabled && ta.has-hover ? root.fill-hover : root.fill;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    @children
}

export component AssistantPanel inherits Panel {
    callback focus-main();   // give keyboard focus back to the window after sending

    // ---- header (32 px, padding 4 x 10) ----
    Icon { x: 8.5px; y: (27.2px - 10.2px) / 2; width: 10.2px; height: 10.2px; d: Icons.assistant; ink: Chat.menu-text; filled: true; }
    Text { x: 8.5px + 10.2px + 3.4px; y: 0; height: 27.2px; text: "Assistant"; color: Chat.menu-text; font-size: 10.2px; font-weight: 700; letter-spacing: -0.408px; vertical-alignment: center; }
    HeaderButton { x: root.width - 8.5px - 20.4px - 3.4px - 20.4px; y: 3.4px; icon: Icons.plus-circle; tooltip: "New chat"; clicked => { Studio.chat-new(); } }
    // Medium/full height layout: PLACEHOLDER (the panel always spans the timeline row)
    HeaderButton { x: root.width - 8.5px - 20.4px; y: 3.4px; icon: Icons.panel-right; icon-size: 13.6px; tooltip: "Full height (not implemented)"; clicked => { Studio.chat-placeholder("Full height"); } }
    Rectangle { x: 0; y: 27.2px - 0.425px; width: root.width; height: 0.425px; background: #2c2d30; }

    // ---- composer card geometry (bottom-anchored, 8 px inset) ----
    property <length> notice-h: Studio.chat-notice ? 28.05px : 0px;   // 6 + 20 + 6 + 1 px rule
    property <length> chips-h: 27.2px;                                 // 8 + 24
    property <length> text-h: max(Chat.line, min(input.preferred-height, 115.6px - 11.9px));
    property <length> text-row-h: 8.5px + 11.9px + root.text-h + 3.4px; // margins 10 / 4, padding 7 / 7
    property <length> card-h: root.notice-h + root.chips-h + root.text-row-h + 27.2px;
    property <bool> can-send: Studio.chat-available && !Studio.chat-busy && Studio.chat-draft != "";

    // ---- transcript (padding 16 / 0 + 8 px gutter / 8, 8 px between items) ----
    flick := Flickable {
        x: 0; y: 27.2px; width: root.width; height: root.height - 27.2px - root.card-h - 13.6px;
        content-height: max(self.height, col.preferred-height);
        changed content-height => { self.content-y = min(0px, self.height - self.content-height); }
        col := VerticalLayout {
            width: flick.width;
            padding-left: 6.8px;
            padding-right: 6.8px;
            padding-top: 13.6px;
            spacing: 6.8px;
            alignment: start;
            for entry[i] in Studio.chat: ChatItem { e: entry; index: i; }
        }
    }
    // Empty state: the greeting (12 px / 500, 16 px in from the panel edge's content box).
    if Studio.chat.length == 0: Text {
        x: 10.2px; y: 27.2px + 17px; width: root.width - 20.4px;
        text: "Hi there. What would you like to make?"; color: Chat.menu-text;
        font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls; wrap: word-wrap;
    }
    // Scroll shade under the header once the transcript is scrolled.
    Rectangle {
        x: 0; y: 27.2px; width: root.width; height: 11.05px;
        opacity: min(1, -flick.content-y / 13.6px);
        background: @linear-gradient(180deg, #10111480 0%, #10111400 100%);
    }

    Rectangle {
        x: 6.8px; y: root.height - 6.8px - root.card-h; width: root.width - 13.6px; height: root.card-h;
        border-radius: 8.5px; background: Chat.card; clip: true;
        border-width: input.has-focus ? 0.85px : 0.425px;
        border-color: input.has-focus ? #ffffff38 : #ffffff0e;
        animate border-color { duration: 200ms; easing: ease-out; }
        opacity: Studio.chat-available ? 1 : 0.4;

        // AI notice (11 px / 500, padding 6 x 10, 1 px rule under it)
        if Studio.chat-notice: Rectangle {
            x: 0; y: 0; width: parent.width; height: 28.05px;
            Text { x: 8.5px; width: parent.width - 8.5px - 3.4px - 17px - 8.5px; height: 27.2px; text: "The assistant is AI and may make mistakes."; color: Chat.text; font-size: 9.35px; font-weight: 500; letter-spacing: -0.204px; vertical-alignment: center; overflow: elide; }
            Rectangle {
                x: parent.width - 8.5px - 17px; y: 5.1px; width: 17px; height: 17px;
                accessible-role: button; accessible-label: "Close AI notice";
                Icon { width: 10.2px; height: 10.2px; d: Icons.close; ink: close-ta.has-hover ? Chat.menu-text : Chat.icon-hover; stroke-width: 1.275px; }
                close-ta := TouchArea { clicked => { Studio.chat-dismiss-notice(); } }
            }
            Rectangle { y: 27.2px; height: 0.85px; background: #ffffff14; }
        }
        // Context chip row: the current selection (track or clip) and its type, or "Nothing selected".
        Rectangle {
            x: 0; y: root.notice-h; width: parent.width; height: root.chips-h;
            if Studio.chat-context-visible: Rectangle {
                x: 6.8px; y: 6.8px; height: 20.4px; width: min(chip-text.preferred-width + 6.8px + 13.6px - 1.7px + 6.8px, parent.width - 70px);
                border-radius: 10.2px; border-width: 0.85px; border-color: Studio.chat-context-color.with-alpha(0.4);
                chip-ta := TouchArea { clicked => { Studio.chat-remove-context(); } }
                Icon {
                    x: 6.8px - 1.7px; y: (parent.height - self.height) / 2; width: 13.6px; height: 13.6px;
                    d: Studio.chat-context-instrument ? Icons.keys : Icons.wave; ink: Studio.chat-context-color; stroke-width: 1.0px;
                    opacity: chip-ta.has-hover ? 0 : 1;
                }
                if chip-ta.has-hover: Icon { x: 6.8px; y: (parent.height - self.height) / 2; width: 10.2px; height: 10.2px; d: Icons.close; ink: Chat.menu-text; stroke-width: 1.275px; }
                chip-text := Text { x: 6.8px + 13.6px - 1.7px; width: parent.width - self.x - 6.8px; height: parent.height; text: Studio.chat-context-name; color: Chat.menu-text; font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px; vertical-alignment: center; overflow: elide; }
            }
            if Studio.chat-context-visible: Text {
                x: parent.width - 13.6px - 60px; y: 6.8px; width: 60px; height: 20.4px;
                text: Studio.chat-context-scope; color: Chat.text; font-size: 9.35px; font-weight: 600; letter-spacing: -0.34px;
                horizontal-alignment: right; vertical-alignment: center;
            }
            if !Studio.chat-context-visible: Rectangle {
                x: 6.8px; y: 6.8px; height: 20.4px; width: empty-text.preferred-width + 13.6px;
                border-radius: 10.2px; border-width: 0.85px; border-color: #ffffff1f;
                empty-text := Text { x: 6.8px; height: parent.height; text: "Nothing selected"; color: Chat.gray-30; font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px; vertical-alignment: center; }
            }
        }
        // Multi-line input (12 px / 500, padding 7 0 7 10). Enter sends, Shift+Enter inserts a newline.
        input := TextInput {
            x: 8.5px; y: root.notice-h + root.chips-h + 8.5px + 5.95px; width: parent.width - 8.5px - 10.2px; height: root.text-h;
            text <=> Studio.chat-draft;
            enabled: Studio.chat-available;
            single-line: false; wrap: word-wrap;
            color: Chat.menu-text; font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls;
            changed has-focus => { Studio.chat-focused = self.has-focus; }
            key-pressed(event) => {
                if (event.text == Key.Return && !event.modifiers.shift) {
                    if (root.can-send) {
                        Studio.chat-send(Studio.chat-draft);
                        Studio.chat-draft = "";
                        root.focus-main();
                    }
                    return accept;
                }
                reject
            }
        }
        if Studio.chat-draft == "": Text {
            x: input.x + 1.7px; y: input.y; height: Chat.line; width: input.width - 1.7px;
            text: !Studio.chat-available ? "Set ANTHROPIC_API_KEY to enable the assistant"
                : Studio.teach-mode ? "Ask the assistant to show you how…" : "Ask the assistant to do anything…";
            overflow: elide; color: Chat.text; font-size: Chat.fs; font-weight: 500; letter-spacing: Chat.ls; vertical-alignment: center;
        }
        // Composer row (32 px, padding 0 8 8): mode switch, then mic and send on the right.
        ModeSwitch { x: 6.8px; y: parent.height - 6.8px - 20.4px; }
        // Mic: PLACEHOLDER (voice input not implemented)
        Disc {
            x: parent.width - 6.8px - 20.4px - 3.4px - 20.4px; y: parent.height - 6.8px - 20.4px;
            fill: Chat.disc; fill-hover: Chat.disc-hover; tooltip: "Voice input (not implemented)";
            clicked => { Studio.chat-placeholder("Voice input"); }
            Icon { width: 11.9px; height: 11.9px; d: Icons.mic; ink: Chat.menu-text; stroke-width: 1.275px; }
        }
        // Send (accent when there is text), or a bare stop square while busy.
        Disc {
            x: parent.width - 6.8px - 20.4px; y: parent.height - 6.8px - 20.4px;
            enabled: root.can-send;
            fill: Studio.chat-busy ? transparent : (root.can-send ? Chat.accent : Chat.disc);
            fill-hover: Chat.accent-hover;
            tooltip: Studio.chat-busy ? "Working" : "Send";
            clicked => { Studio.chat-send(Studio.chat-draft); Studio.chat-draft = ""; root.focus-main(); }
            if !Studio.chat-busy: Icon { width: 11.9px; height: 11.9px; d: Icons.arrow-up; ink: Chat.menu-text; stroke-width: 1.275px; }
            if Studio.chat-busy: Rectangle { width: 8.5px; height: 8.5px; border-radius: 0.85px; background: Chat.menu-text; }
        }
    }
}

// Point overlay: a lime ring around each target, a glow that breathes every 2.6 s, and a
// light bubble with the note beside it. Ring and bubble geometry come from highlight.rs.
export component HighlightOverlay inherits Rectangle {
    for h in Studio.highlights: Rectangle {
        x: h.x; y: h.y; width: h.w; height: h.h;
        property <float> breathe: 0.5 - 0.5 * cos(animation-tick() / 1ms * 360deg / 2600);
        accessible-role: text;
        accessible-label: h.note;
        // 4 px halo band (lime 8 %) and the 20 px glow (18 %, breathing up)
        Rectangle {
            x: -3.4px; y: -3.4px; width: parent.width + 6.8px; height: parent.height + 6.8px;
            border-radius: h.r + 3.4px; border-width: 3.4px; border-color: Chat.point.with-alpha(0.08);
            drop-shadow-blur: 17px; drop-shadow-color: Chat.point.with-alpha(0.18 + 0.1 * parent.breathe);
        }
        Rectangle {
            border-radius: h.r; border-width: 1.275px; border-color: Chat.point.with-alpha(0.9);
            background: Chat.point.with-alpha(0.03 + 0.03 * parent.breathe);
        }
    }
    // Bubble: max-content up to 280 px, padding 12 x 14, radius 12; kept inside the window.
    for h in Studio.highlights: Rectangle {
        width: min(238px, max(title-t.preferred-width, note-t.preferred-width) + 23.8px);
        height: bubble-col.preferred-height;
        x: max(6.8px, min(h.bx, root.width - self.width - 6.8px));
        y: h.above ? h.by - self.height : h.by;
        visible: h.note != "";
        border-radius: 10.2px; background: #f4f5f6;
        border-width: 0.425px; border-color: #00000014;
        drop-shadow-offset-y: 6.8px; drop-shadow-blur: 21.25px; drop-shadow-color: #00000080;
        bubble-col := VerticalLayout {
            padding-left: 11.9px; padding-right: 11.9px; padding-top: 10.2px; padding-bottom: 10.2px;
            spacing: 3.4px;
            title-t := Text { text: h.title; color: #16171a; font-size: 11.9px; font-weight: 600; letter-spacing: -0.12px; wrap: word-wrap; }
            note-t := Text { text: h.note; color: #4a4e57; font-size: 10.2px; font-weight: 400; wrap: word-wrap; }
        }
    }
}
