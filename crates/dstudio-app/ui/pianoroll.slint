// Clip tab of the bottom panel: clip sidebar (Patterns list / Shape rack), the
// piano roll (toolbar, wgpu note grid + keyboard from src/pianoroll.rs, footer),
// the empty state, and the clip context menu.
//
// Panel-relative
// coordinates; the panel is as tall as the Devices tab's (306 pt by default).
import { Tokens } from "tokens.slint";
import { Icon, Icons, Label } from "widgets.slint";
import { Studio, MenuItem } from "studio.slint";
import { TrackName } from "track_header.slint";

// Track title row at the top of the left column ("2 ‖ Instrument").
// A toolbar zoom slider: pressing the track jumps to that point and dragging follows (0..1).
component ZoomSlider inherits Rectangle {
    in property <float> value;
    in property <bool> fill;
    callback changed(float);
    y: 4px; height: 20px;
    Rectangle { y: 9px; height: 2px; border-radius: 1px; background: #2f3036; }
    if root.fill: Rectangle { x: 0; y: 9px; width: root.value * root.width; height: 2px; background: #e5e5e8; }
    Rectangle { x: max(0px, min(root.width - 8px, root.value * root.width - 4px)); y: 6px; width: 8px; height: 8px; border-radius: 4px; background: #f2f2f2; }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.changed(max(0, min(1, self.mouse-x / self.width))); }
        }
        moved => { if (self.pressed) { root.changed(max(0, min(1, self.mouse-x / self.width))); } }
    }
}

export component TrackTitle inherits Rectangle {
    callback focus-main();
    Rectangle { x: 0.5px; y: 15px; width: 3px; height: 15px; border-radius: 1.5px; background: Studio.sel-color; }
    Text { visible: Studio.has-selection; x: 10.5px; y: 7px; height: 13px; text: Studio.sel-number; color: Tokens.text-bright; font-size: 9px; font-weight: 700; vertical-alignment: center; }
    Icon { visible: Studio.has-selection; x: 21px; y: 8px; width: 11px; height: 11px; d: Studio.sel-instrument ? Icons.keys : Icons.wave; ink: #a8a8ab; stroke-width: 1.1px; }
    if !Studio.has-selection: Label { x: 37px; y: 7px; text: "No track selected"; color: Tokens.text-bright; font-size: 10px; }
    if Studio.has-selection: TrackName { x: 37px; y: 7px; width: 120px; height: 14.5px; track-id: Studio.sel-id; text: Studio.sel-name; text-color: Tokens.text-bright; font-size: 10px; font-weight: 600; letter-spacing: 0; edit-done => { root.focus-main(); } }
}

// One Shape rack row (src/composer.rs SHAPE_ROWS): label, then a slider, stepper or
// segments. Sliders drag across (double-click resets); a disabled row shows its tip on hover.
component ShapeRack inherits Rectangle {
    property <length> pitch: Studio.composer-shape-rows.length > 14 ? 15.5px : 17.5px;
    for r[i] in Studio.composer-shape-rows: Rectangle {
        x: 0; y: i * root.pitch; width: root.width; height: 15px;
        property <color> ink: r.enabled ? Studio.clip-color : #3c3d43;
        // The row whose curve the piano roll draws: its label lit, a bar in the curve's colour.
        if r.selected && r.enabled: Rectangle { x: 0; y: 3px; width: 2px; height: 9px; border-radius: 1px; background: r.color; }
        if r.curved: Rectangle { x: 60px; y: 5.5px; width: 4px; height: 4px; border-radius: 2px; background: r.color; }
        Text {
            x: 7px; text: r.label; font-size: 9.5px; font-weight: r.selected ? 600 : 500; vertical-alignment: center;
            color: !r.enabled ? #4a4b51 : r.selected ? Tokens.text-bright : #a6a8ac;
        }
        if r.enabled: TouchArea { x: 0; width: 66px; clicked => { Studio.composer-shape(i, 6, 0); } }
        if r.kind == 0: Rectangle {
            x: 72px; y: 5px; width: 118px; height: 5px; border-radius: 2.5px; background: #2a2b30;
            Rectangle {
                x: r.bipolar ? min(r.norm, 0.5) * parent.width : 0; y: 0; height: parent.height; border-radius: 2.5px; background: ink;
                width: r.bipolar ? abs(r.norm - 0.5) * parent.width : r.norm * parent.width;
            }
            if r.enabled: Rectangle { x: r.norm * parent.width - 1px; y: -2.5px; width: 2px; height: 10px; border-radius: 1px; background: #ffffff; }
            if r.enabled: TouchArea {
                x: -4px; y: -5px; width: parent.width + 8px; height: 15px; mouse-cursor: MouseCursor.ew-resize;
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.composer-shape(i, 0, (self.mouse-x - 4px) / (self.width - 8px)); }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.composer-shape(i, 2, 0); }
                }
                moved => { Studio.composer-shape(i, 1, (self.mouse-x - 4px) / (self.width - 8px)); }
                double-clicked => { Studio.composer-shape(i, 5, 0); }
            }
        }
        if r.kind == 0: Text { x: 196px; width: 34px; text: r.value; color: ink; font-size: 9px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
        if r.kind == 1: Rectangle {
            x: 72px; y: 0; width: 158px; height: 15px; border-radius: 7.5px; background: #2a2b30;
            Text { x: 0; width: 18px; text: "‹"; color: ink; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 18px; width: parent.width - 36px; text: r.value; color: ink; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: parent.width - 18px; width: 18px; text: "›"; color: ink; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            if r.enabled: TouchArea { x: 0; width: parent.width / 2; clicked => { Studio.composer-shape(i, 3, -1); } double-clicked => { Studio.composer-shape(i, 5, 0); } }
            if r.enabled: TouchArea { x: parent.width / 2; width: parent.width / 2; clicked => { Studio.composer-shape(i, 3, 1); } double-clicked => { Studio.composer-shape(i, 5, 0); } }
        }
        if r.kind == 2: Rectangle {
            x: 72px; y: 0; width: 158px; height: 15px;
            for k in r.segs: Rectangle {
                x: k * (parent.width + 2px) / r.segs; y: 0; width: (parent.width + 2px) / r.segs - 2px; height: parent.height; border-radius: 4px;
                background: r.enabled && k == r.seg ? #484a4f : #2a2b30;
                Text { text: k + 1; color: r.enabled ? (k == r.seg ? Tokens.text-bright : #a6a8ac) : #3c3d43; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                if r.enabled: TouchArea { clicked => { Studio.composer-shape(i, 4, k); } }
            }
        }
        if !r.enabled: Rectangle {
            tta := TouchArea { }
            if tta.has-hover: Rectangle {
                x: 60px; y: -17px; width: tt.preferred-width + 14px; height: 16px; border-radius: 4px; background: #34353a;
                tt := Text { text: r.tip; color: #e5e5e8; font-size: 8.75px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

// Left column of the Clip tab. The card's Patterns tab lists DStudio's library patterns
// (src/composer.rs); its Shape tab holds the Shape rack.
export component ClipSidebar inherits Rectangle {
    callback focus-main();
    TrackTitle { x: 0; y: 0; width: root.width; height: 26px; focus-main => { root.focus-main(); } }
    if !Studio.pr-visible && !Studio.ac-visible: Rectangle {
        Text { x: 0; y: 193px; width: root.width; height: 15px; text: "Patterns"; color: #a5a6aa; font-size: 9.75px; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 0; y: 210px; width: root.width; height: 14px; text: "Select a clip to create some patterns."; color: #6c6e74; font-size: 8.75px; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Audio clip: Resample in the title row, clip chip with Fits / Similar / Variations
    // (PLACEHOLDERS: no sample search behind them).
    if Studio.ac-visible: Rectangle {
        Rectangle {
            x: 191.25px; y: 4.85px; width: 53.5px; height: 17.85px; border-radius: 8.9px; background: #292a2f;
            Text { text: "Resample"; color: #d0d0d1; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { Studio.chat-placeholder("Resample"); } }
        }
        Rectangle {
            x: 10.5px; y: 38px; width: 234px; height: 60.5px; border-radius: 8px; background: #212227;
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 30.5px; border-radius: 8px; background: Studio.clip-color;
                Rectangle { y: parent.height - 8px; height: 8px; background: Studio.clip-color; }
                Icon { x: 11px; y: 9px; width: 13px; height: 13px; d: Icons.wave; ink: Studio.clip-ink; stroke-width: 1.4px; }
                Text { x: 42px; text: Studio.clip-name; color: Studio.clip-ink; font-size: 10px; font-weight: 500; vertical-alignment: center; }
            }
            for t[i] in ["Fits", "Similar", "Variations"]: Text {
                x: [4.8px, 79.6px, 155.25px][i]; y: 35.7px; width: 73.5px; height: 20.4px; text: t;
                color: #a6a8ac; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    if Studio.pr-visible: prv := Rectangle {
        // clip chip + Patterns / Shape card (a drum pattern clip: the chip alone)
        Rectangle {
            x: 10.5px; y: 38px; width: 234px; height: Studio.composer-drums ? 30.5px : 60.5px; border-radius: 8px; background: #212227;
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 30.5px; border-radius: 8px; background: Studio.clip-color;
                Rectangle { y: parent.height - 8px; height: 8px; background: Studio.clip-color; }
                Icon { x: 11px; y: 9px; width: 13px; height: 13px; d: Icons.keys; ink: Studio.clip-ink; stroke-width: 1.4px; }
                Text { x: 42px; text: Studio.clip-name; color: Studio.clip-ink; font-size: 10px; font-weight: 500; vertical-alignment: center; }
                // Original: the clip's kept notes, shown while a pattern plays in their place.
                if Studio.composer-original: Rectangle {
                    x: parent.width - 8px - self.width; y: 7px; width: ot.preferred-width + 26px; height: 16.5px; border-radius: 8.25px;
                    border-width: 1px; border-color: Studio.clip-ink; background: ota.has-hover ? #00000014 : transparent;
                    Icon { x: 6px; y: 4.25px; width: 8px; height: 8px; d: "M6 4L3 7l3 3 M3 7h7a3 3 0 0 0 0-6"; ink: Studio.clip-ink; stroke-width: 1.4px; }
                    ot := Text { x: 17px; text: "Original"; color: Studio.clip-ink; font-size: 8.5px; font-weight: 600; vertical-alignment: center; }
                    ota := TouchArea { clicked => { Studio.composer-original-pick(); } }
                }
            }
            if !Studio.composer-drums: Rectangle {
                x: Studio.composer-shape-tab ? 119.5px : 5px; y: 35.5px; width: 110.5px; height: 20px; border-radius: 10px; background: #484a4f;
            }
            if !Studio.composer-drums: Rectangle {
                x: 5px; y: 35.5px; width: 110.5px; height: 20px;
                Text {
                    text: "Patterns"; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
                    color: !Studio.composer-shape-tab ? Tokens.text-bright : pta.has-hover ? #a6a8ac : #6c6e74;
                }
                pta := TouchArea { clicked => { Studio.composer-tab(false); } }
            }
            if !Studio.composer-drums: Rectangle {
                x: 119.5px; y: 35.5px; width: 110.5px; height: 20px;
                Text {
                    text: "Shape"; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
                    color: Studio.composer-shape-tab ? Tokens.text-bright : !Studio.composer-shape-ok ? #3c3d43 : sta.has-hover ? #a6a8ac : #6c6e74;
                }
                sta := TouchArea { enabled: Studio.composer-shape-ok; clicked => { Studio.composer-tab(true); } }
            }
        }
        // Type / Genre (a drum clip: Genre alone, under the chip)
        property <length> fy: Studio.composer-drums ? 71.5px : 104px;
        if !Studio.composer-drums: Text { x: 17.5px; y: 104px; height: 17px; text: "Type"; color: #6c6e74; font-size: 9.5px; font-weight: 500; vertical-alignment: center; }
        if !Studio.composer-drums: Rectangle {
            x: 46.5px; y: 104px; width: 63px; height: 17px; border-radius: 8.5px; background: #2a2b30;
            Text { x: 7.5px; text: Studio.composer-part-text; color: #d6d6d9; font-size: 9.5px; font-weight: 500; vertical-alignment: center; }
            Icon { x: parent.width - 14px; y: 4.5px; width: 8px; height: 8px; d: Icons.chevron-down; ink: #9a9ba0; }
            TouchArea { clicked => { Studio.clip-menu-open(4); } }
        }
        Text { x: Studio.composer-drums ? 17.5px : 117.5px; y: parent.fy; height: 17px; text: "Genre"; color: #6c6e74; font-size: 9.5px; font-weight: 500; vertical-alignment: center; }
        Rectangle {
            x: Studio.composer-drums ? 52px : 151.5px; y: parent.fy; width: 89.5px; height: 17px; border-radius: 8.5px; background: #2a2b30;
            Text { x: 7.5px; width: parent.width - 22px; text: Studio.composer-genre-text; overflow: elide; color: #d6d6d9; font-size: 9.5px; font-weight: 500; vertical-alignment: center; }
            Icon { x: parent.width - 14px; y: 4.5px; width: 8px; height: 8px; d: Icons.chevron-down; ink: #9a9ba0; }
            TouchArea { clicked => { Studio.clip-menu-open(5); } }
        }
        if Studio.composer-shape-tab: Flickable {
            x: 0; y: prv.fy + 26px; width: prv.width; height: max(0px, prv.height - 8px - self.y);
            property <length> rack-h: Studio.composer-shape-rows.length * (Studio.composer-shape-rows.length > 14 ? 15.5px : 17.5px);
            content-height: self.rack-h;
            ShapeRack { x: 10.5px; y: 0; width: 234px; height: parent.rack-h; }
        }
        if !Studio.composer-shape-tab && Studio.composer-rows.length == 0: Rectangle {
            Text { x: 0; y: 151px; width: root.width; height: 15px; text: "No patterns"; color: #a5a6aa; font-size: 9.75px; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0; y: 169px; width: root.width; height: 14px; text: "Create some with the button below."; color: #6c6e74; font-size: 8.75px; horizontal-alignment: center; vertical-alignment: center; }
        }
        // Pattern list: six rows, each named, with its notes in miniature; the playing one is lit.
        if !Studio.composer-shape-tab: Flickable {
            x: 0; y: prv.fy + 25px; width: prv.width; height: max(0px, prv.height - 37.5px - 4px - self.y);
            content-height: Studio.composer-rows.length * 35px;
            for row[i] in Studio.composer-rows: Rectangle {
                x: 10.5px; y: i * 35px; width: 234px; height: 32px; border-radius: 6px;
                background: row.playing ? #2c2d32 : rta.has-hover ? #222328 : transparent;
                border-width: row.playing ? 1px : 0; border-color: Studio.clip-color;
                Text { x: 10px; width: 112px; text: row.name; overflow: elide; color: row.playing ? #ffffff : #c9c9cc; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    x: 126px; y: 6px; width: 100px; height: 20px; border-radius: 3px; background: #1a1b1e; clip: true;
                    for n in row.notes: Rectangle {
                        x: n.x * parent.width; y: 2px + n.y * (parent.height - 6px); width: max(1.5px, n.w * parent.width - 0.5px); height: 2px;
                        background: row.playing ? Studio.clip-color : #6b6c70;
                    }
                }
                rta := TouchArea { clicked => { Studio.composer-load(i); } }
            }
        }
        if !Studio.composer-shape-tab: Rectangle {
            x: 10.5px; y: prv.height - 37.5px; width: 234px; height: 27px; border-radius: 13.5px; background: Studio.clip-color;
            Text { x: 12px; text: Studio.composer-create-text; color: Studio.clip-ink; font-size: 10px; font-weight: 500; vertical-alignment: center; }
            Icon { x: parent.width - 21.5px; y: 7px; width: 13px; height: 13px; d: Icons.sparkle; ink: Studio.clip-ink; stroke-width: 1.1px; }
            TouchArea { clicked => { Studio.composer-create(); } }
        }
    }
}

// Toolbar text button (real unless `placeholder`).
component ToolText inherits Rectangle {
    in property <string> text;
    in property <string> action;
    in property <bool> placeholder: false;
    height: 14px;
    width: t.preferred-width;
    t := Text {
        x: 0; text: root.text;
        color: (!root.placeholder && Studio.pr-has-notes) ? (ta.has-hover ? #e5e5e8 : #a6a8ac) : #63656c;
        font-size: 9.75px; font-weight: 500; vertical-alignment: center;
    }
    ta := TouchArea { clicked => { Studio.pr-action(root.action); } }
}

// Footer value (lavender). Drag vertically to change it; `cycle` fields change on click.
component FooterValue inherits Rectangle {
    in property <string> text;
    in property <int> field: -1;
    in property <bool> cycle: false;
    in property <color> ink: Studio.clip-color;
    height: 14px;
    width: t.preferred-width;
    t := Text { x: 0; text: root.text; color: root.ink; font-size: 10px; font-weight: 600; letter-spacing: 0.45px; vertical-alignment: center; }
    if root.field >= 0: TouchArea {
        mouse-cursor: root.cycle ? MouseCursor.pointer : MouseCursor.ns-resize;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down && !root.cycle) { Studio.pr-value(root.field, 0, 0); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.pr-value(root.field, 2, (self.mouse-y - self.pressed-y) / 1px); }
        }
        moved => { if (!root.cycle) { Studio.pr-value(root.field, 1, (self.mouse-y - self.pressed-y) / 1px); } }
    }
}
export component FooterLabel inherits Text {
    height: 14px; color: #63656c; font-size: 9.75px; font-weight: 500; vertical-alignment: center;
}
export component FooterTitle inherits Text {
    height: 14px; color: Tokens.text-bright; font-size: 10px; font-weight: 600; vertical-alignment: center;
}
// Keyboard for a footer switch or select: Tab reaches
// it, Space or Return presses it, a select steps with Up / Down / Home / End; Escape hands the keys
// back to the shortcuts and other keys stay shortcuts. A click doesn't focus it, so the ring
// (2 pt, ink at 22 %) only marks keyboard focus.
component FooterKeys inherits FocusScope {
    in property <int> index;
    in property <bool> select;
    callback pressed();
    callback step(int);
    focus-on-click: false;
    changed has-focus => {
        if (self.has-focus) { Studio.footer-focus = root.index; } else if (Studio.footer-focus == root.index) { Studio.footer-focus = -1; }
    }
    key-pressed(e) => {
        if (e.text == Key.Escape) { return reject; }
        if (e.text == Key.Return || e.text == " ") { root.pressed(); return accept; }
        if (root.select && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
            if (e.text == Key.UpArrow) { root.step(-1); return accept; }
            if (e.text == Key.DownArrow) { root.step(1); return accept; }
            if (e.text == Key.Home) { root.step(-1000); return accept; }
            if (e.text == Key.End) { root.step(1000); return accept; }
        }
        if (Studio.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta)) { return accept; }
        reject
    }
    if root.has-focus: Rectangle { x: -2px; y: -2px; width: root.width + 4px; height: root.height + 4px; border-width: 2px; border-color: #ffffff38; border-radius: 3px; }
    @children
}

component FooterSwitch inherits Rectangle {
    in property <bool> on;
    width: 20.5px; height: 10.5px; border-radius: 5.25px;
    background: on ? Studio.clip-color : #3e3f44;
    Rectangle { x: root.on ? root.width - self.width - 1px : 1px; y: 1px; width: 8.5px; height: 8.5px; border-radius: 4.25px; background: #ffffff; }
}

// Audio clip toolbar entry: grey label, clip-coloured value, optional menu chevron.
// Typed value (double-click on Original BPM or Transpose): Enter or focus loss commits, Escape cancels.
component AcEditBox inherits Rectangle {
    in property <length> font-size;
    y: -2px; width: 30px; height: 18px; border-radius: 4px; background: #26272b;
    border-width: 0.5px; border-color: Studio.clip-color;
    input := TextInput {
        x: 3px; width: parent.width - 6px; height: parent.height;
        text: Studio.ac-edit-text; color: #ffffff; font-size: root.font-size; font-weight: 600;
        vertical-alignment: center; single-line: true;
        init => { self.focus(); self.select-all(); }
        accepted => { Studio.ac-edit-commit(self.text); }
        changed has-focus => { if (!self.has-focus) { Studio.ac-edit-commit(self.text); } }
        key-pressed(e) => {
            if (e.text == Key.Escape) { Studio.ac-edit-cancel(); return accept; }
            reject
        }
    }
}

component AcField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> value-x;
    in property <length> chevron-x: -1px;
    in property <bool> enabled: true;
    in property <int> menu: -1;   // Studio.clip-menu index this field opens
    in property <bool> bpm-drag;  // the value drags (Original BPM)
    in property <bool> toggle;    // a press toggles it (Reverse)
    height: 14px;
    // Content width, so the menu TouchArea covers this field only.
    width: max(v.x + v.preferred-width, root.chevron-x + 8px);
    Text { x: 0; text: root.label; color: root.enabled ? #a6a8ac : #3c3d43; font-size: 9.75px; font-weight: 500; vertical-alignment: center; }
    v := Text { x: root.value-x; text: root.value; color: root.enabled ? Studio.clip-color : #3c3d43; font-size: 9.75px; font-weight: 600; vertical-alignment: center; }
    if root.chevron-x >= 0: Icon {
        x: root.chevron-x; y: 3px; width: 8px; height: 8px; d: Icons.chevron-down;
        ink: root.enabled ? Studio.clip-color : #3c3d43; stroke-width: 1.4px;
    }
    if root.menu >= 0 && root.enabled: TouchArea { x: 0; width: root.chevron-x + 10px; clicked => { Studio.clip-menu-open(root.menu); } }
    if root.toggle: TouchArea {
        x: 0; width: root.value-x + 20px;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.ac-reverse-toggle(); }
        }
    }
    if root.bpm-drag: TouchArea {
        x: root.value-x - 2px; width: 30px;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.ac-bpm-drag(0, 0, 0); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.ac-bpm-drag(2, 0, 0); }
        }
        moved => { Studio.ac-bpm-drag(1, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
        double-clicked => { Studio.ac-edit-start(0); }
    }
    if root.bpm-drag && Studio.ac-edit-field == 0: AcEditBox { x: root.value-x - 3px; font-size: 9.75px; }
}


// Clip editor dropdown (Studio.clip-menu-items). A toolbar menu: #212227, 8 px radius,
// 4 px padding, 11 px semibold rows with 4 / 12 px padding, the active row tinted (ink 7 %);
// the Grid list instead marks the active row with a check and has a rule before the triplets.
export component DropMenu inherits Rectangle {
    in property <length> row-h: 18.7px;
    in property <length> text-size: 9.35px;
    in property <bool> check;
    in property <int> section: -1;
    // Rows shown at most; a longer list scrolls (the Genre menu shows 12).
    in property <int> max-rows: 99;
    callback picked(int);
    property <length> pad: 3.4px;
    property <length> gap: root.section >= 0 ? 10.2px : 0;
    height: min(Studio.clip-menu-items.length, root.max-rows) * root.row-h + 2 * root.pad + root.gap;
    border-radius: 6.8px;
    background: #212227;
    border-width: 0.85px;
    border-color: #ffffff1c;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 6.8px;
    TouchArea { }
    Flickable {
        x: 0; y: root.pad; width: root.width; height: root.height - 2 * root.pad;
        content-height: Studio.clip-menu-items.length * root.row-h + root.gap;
        // Opens scrolled so the active entry shows.
        content-y: -max(0px, (Studio.clip-menu-active - root.max-rows + 1) * root.row-h);
        for it[i] in Studio.clip-menu-items: Rectangle {
            x: 0; width: root.width; height: root.row-h;
            y: i * root.row-h + (root.section >= 0 && i >= root.section ? root.gap : 0);
            if i == root.section: Rectangle { x: 0; y: -root.gap / 2 - 0.25px; width: parent.width; height: 0.5px; background: #ffffff1c; }
            Rectangle { background: ta.has-hover || (!root.check && i == Studio.clip-menu-active) ? #ffffff12 : transparent; }
            Text {
                x: 10.2px; text: it; color: i == Studio.clip-menu-active ? #ffffff : #d6d6d9;
                font-size: root.text-size; font-weight: 600; letter-spacing: root.text-size * -0.04; vertical-alignment: center;
            }
            if root.check && i == Studio.clip-menu-active: Icon {
                x: parent.width - 18.7px; y: (parent.height - 9px) / 2; width: 9px; height: 9px; d: Icons.check; ink: #ffffff; stroke-width: 1.4px;
            }
            ta := TouchArea { clicked => { root.picked(i); } }
        }
    }
}

// Clip editor: x 255 / y 27 inside the bottom panel (window 260, 452 at the design size).
// The piano roll for MIDI clips; for audio clips (Studio.ac-visible) the same grid texture
// without keyboard, the audio toolbar and the Mix / Tune footer.
export component PianoRoll inherits Rectangle {
    // ---- toolbar (y 0..27) ----
    if !Studio.ac-visible: Rectangle {
        ToolText { x: 7px; y: 7px; text: "Quantize"; action: "quantize"; }
        ToolText { x: 55px; y: 7px; text: "Smart Quantize"; action: "smart_quantize"; }
        ToolText { x: 134px; y: 7px; text: "Humanize"; action: "humanize"; }
        ToolText { x: 187px; y: 7px; text: "Reverse"; action: "reverse"; }
        ToolText { x: 232px; y: 7px; text: "Legato"; action: "legato"; }
        ToolText { x: 270.5px; y: 7px; text: "Double"; action: "double"; }
        // Shape tab: draw curves (Shape), brush, Reset (src/shape_rack.rs).
        if Studio.composer-shape-tab: Rectangle {
            x: 322px; y: 4px; width: 200px; height: 20px;
            Rectangle {
                x: 0; y: 0; width: 56px; height: 20px; border-radius: 10px;
                background: Studio.shape-drawing ? Studio.clip-color : #292a2f;
                Icon { x: 8px; y: 4px; width: 12px; height: 12px; d: "M1 12 C 3.5 12 4.5 3 7 3 S 10.5 12 13 12"; ink: Studio.shape-drawing ? Studio.clip-ink : #a6a8ad; stroke-width: 1.4px; }
                Text { x: 23px; text: "Shape"; color: Studio.shape-drawing ? Studio.clip-ink : #a6a8ad; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                TouchArea { clicked => { Studio.shape-draw-toggle(); } }
            }
            Rectangle {
                x: 62px; y: 0; width: 66px; height: 20px; border-radius: 10px; background: #292a2f;
                opacity: Studio.shape-drawing ? 1 : 0.45;
                Rectangle { x: 2px + Studio.shape-brush * 21px; y: 2px; width: 20px; height: 16px; border-radius: 8px; background: #46474d; }
                for d[i] in ["M3 12.5 L11.5 4 L13 5.5 L4.5 14 Z M3 12.5 L2.5 14.5 L4.5 14 Z", "M2 13 H6 V8 H10 V3 H14", "M3 13 L13 3"]: Rectangle {
                    x: 2px + i * 21px; y: 2px; width: 20px; height: 16px;
                    Icon { x: 4px; y: 2px; width: 12px; height: 12px; d: d; ink: i == Studio.shape-brush ? #ffffff : #a6a8ad; stroke-width: 1.4px; }
                    TouchArea { clicked => { Studio.shape-brush-pick(i); } }
                }
            }
            Rectangle {
                x: 134px; y: 0; width: 44px; height: 20px; border-radius: 10px;
                background: Studio.shape-has-curves ? #292a2f : transparent;
                Text { text: "Reset"; color: Studio.shape-has-curves ? #d0d0d1 : #4a4b51; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: Studio.shape-has-curves; clicked => { Studio.shape-reset(); } }
            }
        }
    }
    // Audio toolbar: Original BPM (drag), Speed, Warp and Mode edit the clip's warp;
    // Reverse is real (warp.reverse plays the clip back to front); the field toggles it.
    if Studio.ac-visible: Rectangle {
        AcField { x: 7px; y: 7px; label: "Reverse"; value: Studio.ac-reversed ? "On" : "Off"; value-x: 42px; toggle: true; }
        AcField { x: 74.8px; y: 7px; label: "Original BPM"; value: Studio.ac-bpm-text; value-x: 65.4px; bpm-drag: true; }
        AcField { x: 170px; y: 7px; label: "Speed"; value: Studio.ac-speed-text; value-x: 36.2px; chevron-x: 55.2px; menu: 0; }
        AcField { x: 243.95px; y: 7px; label: "Warp"; value: Studio.ac-warped ? "On" : "Off"; value-x: 30px; chevron-x: 53.6px; menu: 1; }
        AcField { x: 315.35px; y: 7px; label: "Mode"; value: Studio.ac-mode-text; value-x: 32.25px; chevron-x: 63px; menu: 2; enabled: Studio.ac-warped; }
    }
    // pencil (pen tool B/E), zoom sliders and snap are real; the velocity lane icon is a PLACEHOLDER
    if !Studio.ac-visible: Rectangle {
        Rectangle {
            x: root.width - 304px; y: 4px; width: 20px; height: 20px; border-radius: 4px;
            background: Studio.pr-pen ? #2f3036 : transparent;
            Icon { x: 3.5px; y: 3.5px; width: 13px; height: 13px; d: Icons.pencil; ink: Studio.pr-pen ? #e5e5e8 : #6b6c70; }
            TouchArea { clicked => { Studio.pr-action("pen"); } }
        }
        Icon { x: root.width - 276.5px; y: 7.5px; width: 13px; height: 13px; d: "M3.5 13V8 M6.5 13V4 M9.5 13V6 M12.5 13V9"; ink: #8e8f93; stroke-width: 1.8px; }
        Icon { x: root.width - 246.5px; y: 7.5px; width: 13px; height: 13px; d: Icons.v-resize; ink: #8e8f93; }
        ZoomSlider { x: root.width - 224px; width: 67.5px; value: Studio.pr-vzoom; fill: true; changed(z) => { Studio.pr-zoom(0, z); } }
    }
    Icon { x: root.width - 147.5px; y: 7.5px; width: 13px; height: 13px; d: Icons.h-resize; ink: #8e8f93; }
    ZoomSlider { x: root.width - 132.5px; width: 74px; value: Studio.pr-hzoom; changed(z) => { Studio.pr-zoom(1, z); } }
    // Snap size: the same setting as the timeline toolbar's readout (click toggles, chevron opens the menu).
    Text { x: root.width - 49px; y: 7px; width: 23.5px; height: 14px; horizontal-alignment: right; text: Studio.snap-text; color: Studio.snap-text == "Off" ? #8e8f93 : Tokens.text-bright; font-size: 9px; font-weight: 600; vertical-alignment: center; }
    TouchArea { x: root.width - 47px; y: 4px; width: 24px; height: 20px; clicked => { Studio.snap-toggle(); } }
    snap-chevron := Icon { x: root.width - 22.5px; y: 8.5px; width: 11px; height: 11px; d: Icons.chevron-down; ink: Studio.snap-menu-open ? #ffffff : #c9c9cc; }
    TouchArea {
        x: root.width - 23px; y: 4px; width: 18px; height: 20px;
        clicked => { Studio.snap-menu-toggle(snap-chevron.absolute-position.x + snap-chevron.width, (self.absolute-position.y - Studio.menu-dy) + self.height); }
    }

    // ---- note grid + keyboard (wgpu texture) ----
    grid := Rectangle {
        x: 0; y: 27.5px; width: root.width - 0.5px; height: root.height - 27.5px - 54.5px;
        clip: true;
        Image { x: 0; y: 0; width: parent.width; height: parent.height; source: Studio.pr-image; image-fit: fill; }
        for l in Studio.pr-bar-labels: Text {
            x: l.x; y: 0; height: 13.5px; text: l.text; color: #bdbdbd; font-size: 7.75px; font-weight: 600; vertical-alignment: center;
        }
        if !Studio.ac-visible: Rectangle {
          for k in Studio.pr-key-labels: Text {
            x: 20.5px; y: k.y - 3.35px; width: 27.5px; height: 14.7px; text: k.text; color: #6b6b6d; font-size: 10px; font-weight: 700;
            horizontal-alignment: right; vertical-alignment: center;
          }
        }
        TouchArea {
            mouse-cursor: Studio.pr-pen ? MouseCursor.crosshair : MouseCursor.default;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    Studio.pr-pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta || e.modifiers.control);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    Studio.pr-pointer(2, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta || e.modifiers.control);
                }
            }
            moved => { Studio.pr-pointer(1, self.mouse-x, self.mouse-y, false, false, false); }
            scroll-event(e) => { Studio.pr-scroll(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.alt, e.modifiers.control); accept }
        }
        // Trackpad pinch (macOS): each update zooms time by the change since the last one.
        ScaleRotateGestureHandler {
            property <float> last: 1;
            started => { self.last = 1; }
            updated => {
                Studio.pr-pinch(self.scale / self.last, self.center.x, self.center.y);
                self.last = self.scale;
            }
        }
        // Scale button above the keys (footer Scale on): only scale rows, plus rows holding notes.
        if Studio.pr-scale-on && !Studio.ac-visible: Rectangle {
            x: 6.5px; y: 30px; width: 38px; height: 16px; border-radius: 8px;
            background: Studio.pr-scale-fold ? Studio.clip-color : #2f3036;
            Text {
                width: parent.width; height: parent.height; text: "Scale"; font-size: 9px; font-weight: 600;
                color: Studio.pr-scale-fold ? Studio.clip-ink : #c9c9cc; horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { Studio.pr-action("scale_fold"); } }
        }
    }

    // ---- footer (y height-54.5 ..) ----
    Rectangle { x: 0; y: root.height - 54.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    property <length> r1: root.height - 54.5px + 13px;   // title row top
    property <length> r2: root.height - 54.5px + 30px;   // value row top
    FooterTitle { x: 13.5px; y: root.r1; text: "Clip"; }
    FooterLabel { x: 13.5px; y: root.r2; text: "Start"; }
    FooterValue { x: 42.5px; y: root.r2; text: Studio.pr-start-text; }
    FooterLabel { x: 86px; y: root.r2; text: "End"; }
    FooterValue { x: 110px; y: root.r2; text: Studio.pr-end-text; ink: #4a4b50; }
    // Loop: the switch, the loop's Position and Length (the clip's length while it doesn't loop).
    FooterTitle { x: 173.5px; y: root.r1; text: "Loop"; }
    FooterSwitch { x: 202px; y: root.r1 + 2px; on: Studio.pr-loop-on; }
    FooterKeys {
        x: 200px; y: root.r1; width: 25px; height: 14px; index: 0; enabled: Studio.pr-loop-enabled;
        pressed => { Studio.pr-action("loop"); }
        if Studio.pr-loop-enabled: TouchArea { clicked => { Studio.pr-action("loop"); } }
    }
    FooterLabel { x: 173.5px; y: root.r2; text: "Position"; }
    FooterValue { x: 216.5px; y: root.r2; text: Studio.pr-position-text; field: Studio.pr-loop-on ? 5 : -1; ink: Studio.pr-loop-on ? Studio.clip-color : #4a4b50; }
    FooterLabel { x: 260px; y: root.r2; text: "Length"; }
    FooterValue { x: 298px; y: root.r2; text: Studio.pr-length-text; field: 4; }
    // Mix / Tune (audio): Gain is the clip gain; Transpose drags (disabled in Re-pitch).
    if Studio.ac-visible: Rectangle {
        FooterTitle { x: 361.25px; y: root.r1; text: "Mix"; }
        FooterLabel { x: 361.25px; y: root.r2; text: "Gain"; }
        FooterValue { x: 388.45px; y: root.r2; text: Studio.ac-gain-text; }
        FooterTitle { x: 464.95px; y: root.r1; text: "Tune"; }
        FooterLabel { x: 464.95px; y: root.r2; text: "Transpose"; }
        FooterValue { x: 518.5px; y: root.r2; text: Studio.ac-transpose-text; ink: Studio.ac-transpose-enabled ? Studio.clip-color : #3c3d43; }
        if Studio.ac-transpose-enabled: TouchArea {
            x: 516.5px; y: root.r2; width: 36px; height: 14px;
            mouse-cursor: MouseCursor.ew-resize;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.ac-transpose-drag(0, 0, 0); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.ac-transpose-drag(2, 0, 0); }
            }
            moved => { Studio.ac-transpose-drag(1, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
            double-clicked => { Studio.ac-edit-start(1); }
        }
        if Studio.ac-edit-field == 1: AcEditBox { x: 515.5px; y: root.r2 - 2px; font-size: 10px; }
    }
    if !Studio.ac-visible: Rectangle {
    FooterTitle { x: 362px; y: root.r1; text: "Quantize"; }
    FooterLabel { x: 362px; y: root.r2; text: "Grid"; }
    FooterValue { x: 387px; y: root.r2; text: Studio.pr-grid-text; field: 0; cycle: true; }
    FooterLabel { x: 429px; y: root.r2; text: "Amount"; }
    FooterValue { x: 472px; y: root.r2; text: Studio.pr-quant-text; field: 1; }
    FooterTitle { x: 532px; y: root.r1; text: "Humanize"; }
    FooterLabel { x: 532px; y: root.r2; text: "Amount"; }
    FooterValue { x: 574px; y: root.r2; text: Studio.pr-human-text; field: 2; }
    FooterTitle { x: 635.5px; y: root.r1; text: "Velocity"; }
    FooterLabel { x: 635.5px; y: root.r2; text: "Value"; }
    FooterValue { x: 667px; y: root.r2; text: Studio.pr-vel-text; field: 3; }
    // Scale: the switch highlights in-scale rows and keys; Root note and Scale type open menus.
    FooterTitle { x: 720px; y: root.r1; text: "Scale"; }
    FooterSwitch { x: 751px; y: root.r1 + 2px; on: Studio.pr-scale-on; }
    FooterKeys {
        x: 749px; y: root.r1; width: 25px; height: 14px; index: 1;
        pressed => { Studio.pr-action("scale_highlight"); }
        TouchArea { clicked => { Studio.pr-action("scale_highlight"); } }
    }
    scale-root := FooterValue { x: 720px; y: root.r2; text: Studio.pr-scale-root; }
    FooterKeys {
        x: 720px; y: root.r2; width: scale-root.width; height: 14px; index: 2; select: true;
        pressed => { Studio.clip-menu-open(8); }
        step(s) => { Studio.pr-scale-step(8, s); }
        TouchArea { clicked => { Studio.clip-menu-open(8); } }
    }
    scale-type := FooterValue { x: 720px + scale-root.width + 4px; y: root.r2; text: Studio.pr-scale-type; }
    FooterKeys {
        x: scale-type.x; y: root.r2; width: scale-type.width; height: 14px; index: 3; select: true;
        pressed => { Studio.clip-menu-open(9); }
        step(s) => { Studio.pr-scale-step(9, s); }
        TouchArea { clicked => { Studio.clip-menu-open(9); } }
    }
    }
}

// Clip tab without an editable clip.
export component ClipEmpty inherits Rectangle {
    Text { x: 0; y: 166px; width: root.width; height: 15px; text: "No clip selected"; color: #a5a6aa; font-size: 9.75px; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 0; y: 183px; width: root.width; height: 14px; text: "Select a clip to edit it."; color: #6c6e74; font-size: 8.75px; horizontal-alignment: center; vertical-alignment: center; }
}

// Right-click clip menu: 209 pt wide, 20.5 pt rows.
export component ContextMenu inherits Rectangle {
    in property <[MenuItem]> items;
    callback activated(int);
    width: 209px;
    border-radius: 6.8px;
    background: #212227;
    border-width: 0.85px;
    border-color: @linear-gradient(180deg, #ffffff41 0%, #ffffff26 40%, #ffffff26 100%);
    drop-shadow-offset-y: 6.8px;
    drop-shadow-blur: 20.4px;
    drop-shadow-color: #00000066;
    for it[i] in root.items: Rectangle {
        x: 0; y: it.y; width: root.width; height: 20.4px;
        if it.separator: Rectangle { x: 0; y: -5.3px - 0.2125px; width: parent.width; height: 0.425px; background: #ffffff1f; }
        Rectangle { background: ta.has-hover && it.enabled ? #ffffff12 : transparent; }
        Rectangle {
            opacity: it.enabled ? 1 : 0.4;
            Text { x: 10.2px; text: it.label; color: #ffffff; font-size: 10.2px; font-weight: 600; letter-spacing: -0.306px; vertical-alignment: center; }
            Text { x: parent.width - 10.2px - self.preferred-width; text: it.shortcut; color: #ffffff80; font-size: 11.9px; font-weight: 600; letter-spacing: -0.476px; vertical-alignment: center; }
            if it.submenu: Icon { x: parent.width - 10.2px - 11.8px; y: 5.2px; width: 10px; height: 10px; d: Icons.chevron-right; ink: #ffffff80; }
        }
        ta := TouchArea { clicked => { if (it.enabled) { root.activated(i); } } }
    }
}
