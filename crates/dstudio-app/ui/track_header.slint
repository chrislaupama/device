// Track header column: track rows, the master row and their controls.
//
// Values are for the default (100 %) zoom, converted to our design units
// (1 unit = 1/0.85 pt, see src/zoom.rs): a CSS px p is p × 0.85 here.
import { Tokens } from "tokens.slint";
import { Icon, Icons, Inset } from "widgets.slint";
import { Studio, TrackRow, TrackLevel } from "studio.slint";

// A track's name that renames on double-click (Studio.track-rename): Enter, focus loss or the
// field switching to another track commits, Escape cancels, an empty name keeps the old one. The
// rename goes to the track the field opened on. A single click passes through as `clicked`.
// Keyboard: track.rename (⌘R with a track selected) opens the header row's field; assistive
// technology: the name's default action opens the field. The typed text is mirrored to Rust
// (track-rename-draft) so it is committed even when the panel holding the field goes away.
// Both calls carry the project the field opened in (Studio.doc-epoch): a field left open while
// another project replaces the open one closes without renaming anything.
export component TrackName inherits Rectangle {
    in property <int> track-id;
    in property <string> text;
    in property <color> text-color: Tokens.text-primary;
    in property <length> font-size: 9.35px;
    in property <int> font-weight: 700;
    in property <length> letter-spacing: -0.374px;
    in property <bool> enabled: true;
    /// Review state only: start with the field open.
    in property <bool> review-edit;
    /// Opens on the keyboard rename request (Studio.rename-open-epoch) for this track.
    in property <bool> keyboard-target;
    property <int> open-epoch: root.keyboard-target ? Studio.rename-open-epoch : 0;
    changed open-epoch => { if (root.enabled && Studio.rename-open-id == root.track-id && !root.editing) { root.edit-id = root.track-id; root.edit-epoch = Studio.doc-epoch; root.editing = true; } }
    callback clicked();
    callback edit-done();
    property <bool> editing: root.review-edit;
    // The track being renamed (follows `track-id` until a field opens).
    property <int> edit-id: root.track-id;
    // The project the field opened in.
    property <int> edit-epoch: Studio.doc-epoch;
    property <int> doc-epoch: Studio.doc-epoch;
    changed doc-epoch => { if (root.editing) { root.editing = false; root.edit-done(); } }
    property <string> draft-text;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: "Rename track";
    accessible-action-default => { if (root.enabled) { root.edit-id = root.track-id; root.edit-epoch = Studio.doc-epoch; root.editing = true; } }
    // The field shows another track's name now (the selection moved): keep what was typed.
    changed track-id => { if (root.editing && root.track-id != root.edit-id) { root.editing = false; Studio.track-rename(root.edit-id, root.draft-text, root.edit-epoch); root.edit-done(); } }
    if !root.editing: Text {
        width: root.width; height: root.height;
        text: root.text; color: root.text-color; font-size: root.font-size; font-weight: root.font-weight; letter-spacing: root.letter-spacing;
        vertical-alignment: center; overflow: elide;
    }
    if !root.editing: TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        double-clicked => { root.edit-id = root.track-id; root.edit-epoch = Studio.doc-epoch; root.editing = true; }
    }
    if root.editing: Rectangle {
        x: -2.55px; width: min(root.width + 5.1px, 136px); height: root.height + 3.4px; y: -1.7px;
        border-radius: 2.55px; background: #ffffff1a; border-width: 0.85px; border-color: #ffffff59;
        TextInput {
            x: 2.55px; width: parent.width - 5.1px; height: parent.height;
            text: root.text; color: #ffffff; font-size: root.font-size; font-weight: root.font-weight; letter-spacing: root.letter-spacing;
            vertical-alignment: center; single-line: true; selection-background-color: #ffffff47;
            accessible-label: "Track name";
            init => { root.draft-text = self.text; self.focus(); self.select-all(); }
            edited => { root.draft-text = self.text; Studio.track-rename-draft(root.edit-id, self.text, root.edit-epoch); }
            accepted => { root.editing = false; Studio.track-rename(root.edit-id, self.text, root.edit-epoch); root.edit-done(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.editing = false; Studio.track-rename-cancel(); root.edit-done(); return accept; }
                reject
            }
            changed has-focus => { if (!self.has-focus && root.editing) { root.editing = false; Studio.track-rename(root.edit-id, self.text, root.edit-epoch); } }
        }
    }
}

// M / S / R / I: 12 px squares, white 9 % fill and 60 % letter at rest, 15 % fill and a white
// letter on hover, solid state colour when on. Acts on press.
export component TrackButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> on;
    in property <color> on-color;
    in property <color> on-text: #ffffff;
    callback pressed();
    width: 10.2px;
    height: 10.2px;
    border-radius: 1.7px;
    background: root.on ? root.on-color : ta.has-hover ? #ffffff26 : #ffffff17;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.on;
    Text {
        text: root.text; font-size: 6.375px; font-weight: 700;
        color: root.on ? root.on-text : ta.has-hover ? #ffffff : #ffffff99;
        horizontal-alignment: center; vertical-alignment: center;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.pressed(); }
        }
    }
}

// Pan knob (the smallest knob size): a 22 px cell, 16 px body lifted by a soft
// shadow, a faint 270° groove (r 10, 2 px), a bipolar value arc from 12 o'clock in the track
// colour, a short centre detent in the track colour while centred, and a white pointer.
export component TrackPan inherits Rectangle {
    in property <float> value;            // -1 .. 1
    in property <color> accent;
    in property <bool> enabled: true;
    callback value-changed(float);
    callback released();
    callback reset();
    callback edit();
    property <bool> reset-held;
    property <float> start-value;
    property <float> angle: root.value * 135;
    property <float> c: self.width / 1px / 2;
    property <float> rr: 8.5;             // groove radius (10 px - half its stroke)
    width: 18.7px;
    height: 18.7px;
    accessible-role: slider;
    accessible-label: "Pan";
    accessible-value: root.value;
    Rectangle {
        width: 13.6px; height: 13.6px; border-radius: self.width / 2;
        background: #2f3032;
        drop-shadow-offset-y: 1.36px; drop-shadow-blur: 2.5px; drop-shadow-color: #00000080;
    }
    Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: #ffffff0d; stroke-width: 1.7px; fill: transparent;
        MoveTo { x: root.c + root.rr * sin(-135deg); y: root.c - root.rr * cos(-135deg); }
        ArcTo { x: root.c + root.rr * sin(135deg); y: root.c - root.rr * cos(135deg); radius-x: root.rr; radius-y: root.rr; large-arc: true; sweep: true; }
    }
    if abs(root.value) >= 0.005: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.accent; stroke-width: 1.7px; fill: transparent;
        MoveTo { x: root.c; y: root.c - root.rr; }
        ArcTo {
            x: root.c + root.rr * sin(root.angle * 1deg); y: root.c - root.rr * cos(root.angle * 1deg);
            radius-x: root.rr; radius-y: root.rr; large-arc: false; sweep: root.value > 0;
        }
    }
    if abs(root.value) < 0.005: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.accent; stroke-width: 0.97px; stroke-line-cap: round;
        MoveTo { x: root.c; y: root.c - 7.29; }
        LineTo { x: root.c; y: root.c - 9.71; }
    }
    Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: #ffffff; stroke-width: 1.445px; stroke-line-cap: round;
        MoveTo { x: root.c + 3.72 * sin(root.angle * 1deg); y: root.c - 3.72 * cos(root.angle * 1deg); }
        LineTo { x: root.c + 5.37 * sin(root.angle * 1deg); y: root.c - 5.37 * cos(root.angle * 1deg); }
    }
    if root.enabled: TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.reset-held = e.modifiers.alt;
                if (e.modifiers.alt) { root.reset(); } else { root.start-value = root.value; }
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => {
            if (!root.reset-held) { root.value-changed(max(-1, min(1, root.start-value + (self.pressed-y - self.mouse-y) / 1px / 150 * 2))); }
        }
        double-clicked => { root.edit(); }
    }
}

// Volume: an 8 px rail (recessed, rim lit from below) with the track's stereo meter as two
// 2 px lines and a 4 px-radius handle (85 % white, white on hover). Travel leaves 7 px at
// each end. Press jumps, drag follows, double-click or Alt resets.
export component TrackVolume inherits Rectangle {
    in property <float> pos;              // 0 .. 1
    in property <float> level-l;          // meter 0 .. 1
    in property <float> level-r;
    in property <color> meter-color;
    /// Following automation: the handle takes the Volume lane's hue.
    in property <bool> automated;
    callback moved(float);
    callback released();
    callback reset();
    property <bool> reset-held;
    property <length> rail-y: 1.7px;
    property <length> travel: self.width - 11.9px;
    height: 11.9px;
    Inset {
        y: root.rail-y; width: root.width; height: 6.8px; border-radius: 3.4px;
        lip: 0.425px; shade: 0.425px; fill: Tokens.bg-slider-track;
    }
    if root.level-l > 0: Rectangle {
        x: 2.55px; y: root.rail-y + 1.7px; height: 1.7px; border-radius: 0.85px;
        width: 1.7px + (root.width - 6.8px) * root.level-l; background: root.meter-color;
    }
    if root.level-r > 0: Rectangle {
        x: 2.55px; y: root.rail-y + 3.4px; height: 1.7px; border-radius: 0.85px;
        width: 1.7px + (root.width - 6.8px) * root.level-r; background: root.meter-color;
    }
    Rectangle {
        x: 5.95px + root.pos * root.travel - 3.4px; y: root.rail-y;
        width: 6.8px; height: 6.8px; border-radius: 3.4px;
        background: root.automated ? #ebc542 : ta.has-hover || ta.pressed ? #ffffff : #ffffffd9;
        drop-shadow-offset-y: 0.57px; drop-shadow-blur: 2.55px; drop-shadow-color: #00000040;
    }
    accessible-role: slider;
    accessible-value: root.pos;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.reset-held = e.modifiers.alt;
                if (e.modifiers.alt) { root.reset(); } else { root.moved(max(0, min(1, (self.mouse-x - 5.95px) / root.travel))); }
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { if (!root.reset-held) { root.moved(max(0, min(1, (self.mouse-x - 5.95px) / root.travel))); } }
        double-clicked => { root.reset(); }
    }
}

// Automation pill: power toggle, "Category Parameter", chevron. 20 px high, raised; 45 %
// opacity while the lane is off or has no points (80 % on hover).
export component AutoPill inherits Rectangle {
    in property <string> cat;
    in property <string> param;
    in property <int> state;              // 0 inactive, 1 active, 2 disabled
    in property <color> accent: #ebc542;
    in property <bool> chevron: true;
    in property <bool> open-state;
    callback power();
    callback open(length, length);
    property <bool> hot: ta.has-hover || root.open-state;
    height: 17px;
    border-radius: 8.5px;
    opacity: root.state == 1 ? 1 : ta.has-hover ? 0.8 : 0.45;
    background: #ffffff26;
    drop-shadow-offset-y: 0.64px; drop-shadow-blur: 2.55px; drop-shadow-color: #00000040;
    accessible-role: combobox;
    accessible-label: "Automation parameter: " + root.cat + " " + root.param;
    Rectangle {
        y: 0.32px; width: root.width; height: root.height - 0.32px; border-radius: root.border-radius;
        background: root.hot ? #2f3035 : #292a2f;
    }
    ta := TouchArea { clicked => { root.open(self.absolute-position.x, (self.absolute-position.y - Studio.menu-dy) + root.height); } }
    power-ta := TouchArea {
        x: 0.85px; width: 15.3px;
        accessible-role: checkbox; accessible-label: root.state == 1 ? "Bypass automation" : "Enable automation"; accessible-checked: root.state == 1;
        clicked => { root.power(); }
        Icon {
            width: 10.2px; height: 10.2px; d: Icons.power; stroke-width: 1.3px;
            ink: root.state == 1 ? #ffffffe6 : power-ta.has-hover ? #ffffffb3 : #ffffff59;
        }
    }
    cat-text := Text {
        x: 17px; height: root.height; text: root.cat; font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px;
        vertical-alignment: center; color: #ffffff66;
    }
    Text {
        x: cat-text.x + cat-text.preferred-width + 4.25px; width: max(0px, root.width - self.x - 17px); height: root.height;
        text: root.param; font-size: 8.5px; font-weight: 600; letter-spacing: -0.34px; vertical-alignment: center; overflow: elide;
        color: root.accent;
    }
    if root.chevron: Icon {
        x: root.width - 15.3px; y: (root.height - 13.6px) / 2; width: 13.6px; height: 13.6px;
        d: Icons.chevron-down; ink: #81838a; stroke-width: 1.3px;
    }
}

// Shared bottom row: pan cell and volume after the 60 px M/S/R/I group, spread with
// space-between across the content box (32 px from the left, 8 px from the right).
component ChannelControls inherits Rectangle {
    in property <float> pan;
    in property <bool> pan-enabled: true;
    in property <color> accent;
    in property <float> volume-pos;
    in property <float> level-l;
    in property <float> level-r;
    in property <color> meter-color;
    in property <bool> handle-auto;
    callback pan-changed(float);
    callback pan-reset();
    callback volume(float);
    callback volume-reset();
    callback released();
    /// Inline pan entry ("C", "30L", "30R" or a number -100..100), opened by double-clicking the knob.
    callback pan-text(string);
    /// The pan field closed from the keyboard (Enter or Escape): give focus back to the window.
    callback edit-done();
    property <bool> editing;
    // root spans the content box; height 13.6 (16 px row)
    property <length> vol-w: min(68px, root.width - 51px - 18.7px);
    property <length> gap: (root.width - 51px - 18.7px - root.vol-w) / 2;
    if !root.editing: TrackPan {
        x: 51px + root.gap; y: (root.height - self.height) / 2;
        value: root.pan; accent: root.accent; enabled: root.pan-enabled;
        value-changed(v) => { root.pan-changed(v); }
        released => { root.released(); }
        reset => { root.pan-reset(); }
        edit => { root.editing = true; }
    }
    // 32 x 16 px field: white 10 % fill, 1 px white 35 % outline inside, radius 2, 12 px semibold.
    if root.editing: Rectangle {
        x: 51px + root.gap + 9.35px - 13.6px; y: (root.height - 13.6px) / 2; width: 27.2px; height: 13.6px;
        border-radius: 1.7px; background: #ffffff1a; border-width: 0.85px; border-color: #ffffff59;
        input := TextInput {
            x: 1.7px; width: parent.width - 3.4px; height: parent.height;
            text: root.pan == 0 ? "C" : round(abs(root.pan) * 100) + (root.pan < 0 ? "L" : "R");
            color: #ffffff; font-size: 10.2px; font-weight: 600; letter-spacing: -0.408px;
            horizontal-alignment: center; vertical-alignment: center; single-line: true;
            selection-background-color: #ffffff47;
            init => { self.focus(); self.select-all(); }
            accepted => { root.editing = false; root.pan-text(self.text); root.edit-done(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.editing = false; root.edit-done(); return accept; }
                reject
            }
            changed has-focus => { if (!self.has-focus && root.editing) { root.editing = false; root.pan-text(self.text); } }
        }
    }
    TrackVolume {
        x: 51px + 18.7px + 2 * root.gap; y: (root.height - self.height) / 2 + 0.85px; width: root.vol-w;
        pos: root.volume-pos; level-l: root.level-l; level-r: root.level-r; meter-color: root.meter-color;
        automated: root.handle-auto;
        moved(p) => { root.volume(p); }
        released => { root.released(); }
        reset => { root.volume-reset(); }
    }
}

export component TrackHeaderRow inherits Rectangle {
    callback edit-done();
    in property <TrackRow> t;
    in property <TrackLevel> level;
    in property <bool> automation;        // automation lanes shown (88 px rows: full chrome)
    in property <length> row-h: Tokens.track-h;
    // Layout by row height: full (48 px and up) shows the automation row
    // when lanes are shown, compact drops it, minimal (under 28 px) keeps only the name row.
    property <bool> full: root.row-h >= 40.8px;
    property <bool> minimal: root.row-h < 23.8px;
    property <bool> show-auto: root.automation && root.full;
    // Chrome block (16 + 4 + 16, plus 10 + 20 for the automation row) centred in the row.
    property <length> centre-shift: (root.row-h - Tokens.track-h) / 2;
    property <length> top-y: root.minimal ? (root.row-h - 13.6px) / 2 : (root.show-auto ? 8.5px : 21.25px) + root.centre-shift;
    property <length> bottom-y: root.top-y + 18.7px;
    accessible-role: list-item;
    accessible-label: "Track " + root.t.number + " " + root.t.name;
    ta := TouchArea { clicked => { Studio.select-track(root.t.id); } }
    Rectangle {
        height: root.row-h;
        background: root.t.selected ? Tokens.bg-track-header-selected : ta.has-hover ? #ffffff04 : transparent;
    }
    // Colour chip: 6 px wide, flush left, 8 px from the top and bottom, rounded on the right.
    Rectangle {
        x: 0; y: 6.8px; width: 5.1px; height: root.row-h - 13.6px;
        border-top-right-radius: 3.4px; border-bottom-right-radius: 3.4px;
        background: root.t.color;
    }
    Text {
        x: 8.5px; y: (root.row-h - 13.6px) / 2; width: 13.6px; height: 13.6px;
        text: root.t.number; color: #ffffff; font-size: 8.5px; font-weight: 700; letter-spacing: -0.34px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Icon {
        x: 27.2px; y: root.top-y; width: 13.6px; height: 13.6px;
        d: root.t.instrument ? Icons.track-instrument : Icons.track-audio;
        filled: root.t.instrument; stroke-width: 1.1px; ink: Tokens.text-tertiary;
    }
    TrackName {
        x: 43.35px; y: root.top-y; width: root.width - self.x - 6.8px; height: 13.6px;
        track-id: root.t.id; text: root.t.name; keyboard-target: true;
        clicked => { Studio.select-track(root.t.id); }
        edit-done => { root.edit-done(); }
    }
    if !root.minimal: TrackButton {
        x: 28.05px; y: root.bottom-y + 1.7px; text: "M"; label: root.t.mute ? "Unmute track" : "Mute track";
        on: root.t.mute; on-color: Tokens.accent; pressed => { Studio.track-mute(root.t.id); }
    }
    if !root.minimal: TrackButton {
        x: 41.65px; y: root.bottom-y + 1.7px; text: "S"; label: root.t.solo ? "Unsolo track" : "Solo track";
        on: root.t.solo; on-color: Tokens.track-solo-on; on-text: #1a1a1a; pressed => { Studio.track-solo(root.t.id); }
    }
    if !root.minimal: TrackButton {
        x: 55.25px; y: root.bottom-y + 1.7px; text: "R"; label: root.t.arm ? "Disarm track for recording" : "Arm track for recording";
        on: root.t.arm; on-color: Tokens.track-arm-on; pressed => { Studio.track-arm(root.t.id); }
    }
    if root.t.instrument && !root.minimal: TrackButton {
        x: 68.85px; y: root.bottom-y + 1.7px; text: "I"; label: root.t.monitor ? "Disable input monitoring" : "Enable input monitoring";
        on: root.t.monitor; on-color: Tokens.track-monitor-on; on-text: #1a1a1a; pressed => { Studio.track-monitor(root.t.id); }
    }
    if !root.minimal: ChannelControls {
        edit-done => { root.edit-done(); }
        x: 27.2px; y: root.bottom-y; width: root.width - 34px; height: 13.6px;
        pan: root.t.pan; accent: root.t.pan-auto ? #65bce3 : root.t.color;
        volume-pos: root.t.volume-pos; handle-auto: root.t.vol-auto;
        level-l: root.level.l; level-r: root.level.r; meter-color: root.level.clip ? Tokens.track-arm-on : root.t.color;
        pan-changed(v) => { Studio.track-pan(root.t.id, v); }
        pan-reset => { Studio.track-pan(root.t.id, 0); Studio.gesture-end(); }
        pan-text(s) => { Studio.track-pan-text(root.t.id, s); Studio.gesture-end(); }
        volume(p) => { Studio.track-volume(root.t.id, p); }
        volume-reset => { Studio.track-volume(root.t.id, Tokens.slider-zero-db); Studio.gesture-end(); }
        released => { Studio.gesture-end(); }
    }
    // Automation row: fold button in the gutter, then the pill (16 px in from the content box).
    if root.show-auto: Rectangle {
        x: 23.8px; y: 50.15px + root.centre-shift; width: 13.6px; height: 13.6px;
        accessible-role: button;
        accessible-label: (root.t.auto-expanded ? "Collapse " : "Show ") + root.t.auto-count + (root.t.auto-count == 1 ? " automated lane" : " automated lanes");
        fold-ta := TouchArea { clicked => { Studio.auto-expand(root.t.id); } }
        Icon {
            x: 1.7px; y: 1.7px; width: 10.2px; height: 10.2px; stroke-width: 1.3px;
            d: root.t.auto-expanded ? Icons.chevron-down : Icons.chevron-right; ink: fold-ta.has-hover ? #ffffff : #ffffff8c;
        }
    }
    if root.show-auto: AutoPill {
        x: 40.8px; y: 48.45px + root.centre-shift; width: root.width - 34px - 13.6px;
        cat: root.t.auto-cat; param: root.t.auto-param; state: root.t.auto-state; accent: root.t.auto-accent;
        power => { Studio.auto-power(root.t.id, -1); }
        open(x, y) => { Studio.auto-open-picker(root.t.id, x, y); }
    }
}

// Master row: pinned below the tracks; 36 px (76 px with automation lanes). No number or
// M/S/R/I; the icon and name sit 14 px left of the track content with a 12 px gap.
export component MasterHeaderRow inherits Rectangle {
    callback edit-done();
    in property <bool> automation;
    in property <float> volume-pos;
    in property <TrackLevel> level;
    in property <bool> vol-auto;
    in property <int> auto-state;
    property <length> top-c: root.automation ? 20.4px : 15.3px;
    property <length> bottom-y: root.automation ? 14.45px : 9.35px;
    Rectangle {
        x: 0; y: 6.8px; width: 5.1px; height: root.height - 13.6px;
        border-top-right-radius: 3.4px; border-bottom-right-radius: 3.4px;
        background: Tokens.track-master;
    }
    Icon { x: 15.3px; y: root.top-c - 6.8px; width: 13.6px; height: 13.6px; d: Icons.master; ink: Tokens.text-tertiary; }
    Text {
        x: 35.84px; y: root.top-c - 6.8px; height: 13.6px; text: "Master"; color: #ffffff;
        font-size: 9.35px; font-weight: 700; letter-spacing: -0.374px; vertical-alignment: center;
    }
    ChannelControls {
        edit-done => { root.edit-done(); }
        x: 27.2px; y: root.bottom-y; width: root.width - 34px; height: 13.6px;
        pan: 0; pan-enabled: false; accent: #ffffff;
        volume-pos: root.volume-pos; handle-auto: root.vol-auto;
        level-l: root.level.l; level-r: root.level.r; meter-color: root.level.clip ? Tokens.track-arm-on : Tokens.meter-master;
        volume(p) => { Studio.master-volume(p); }
        volume-reset => { Studio.master-volume(Tokens.slider-zero-db); Studio.gesture-end(); }
        released => { Studio.gesture-end(); }
    }
    if root.automation: AutoPill {
        x: 40.8px; y: 42.5px; width: root.width - 34px - 13.6px;
        cat: "Track"; param: "Volume"; state: root.auto-state;
        power => { Studio.auto-power(-1, -1); }
        open(x, y) => { Studio.auto-open-picker(-1, x, y); }
    }
}
