// Design tokens derived from reference/design-system.md (measured from the
// reference app at 1440x820 pt). Keep both files in sync.
export global Tokens {
    // Surfaces
    out property <color> bg-window: #101114;
    out property <color> border-window: #28292b;
    out property <color> bg-panel: #1a1b1e;
    out property <color> bg-raised: #212227;
    out property <color> bg-control: #292a2f;
    out property <color> bg-input: #25262b;
    out property <color> bg-track-header-selected: #232428;
    out property <color> bg-lane: #16171a;
    out property <color> bg-lane-selected: #1d1e21;
    out property <color> bg-slider-track: #1f2024;
    out property <color> bg-knob: #131417;
    out property <color> bg-meter: #19191d;
    // Lines
    out property <color> line-separator: #2c2d30;
    out property <color> line-lane: #292a2c;
    out property <color> line-grid: #131417;
    out property <color> line-panel-highlight: #36373a;
    out property <color> loop-bar: #4d4d4f;
    // Text
    out property <color> text-primary: #e5e5e8;
    out property <color> text-bright: #ffffff;
    out property <color> text-secondary: #9d9d9f;
    out property <color> text-tertiary: #767678;
    out property <color> text-title: #54565c;
    // Accent / track colours
    out property <color> accent: #2752f5;
    out property <color> on-accent: #f2f5fe;
    out property <color> track-audio: #72b6d7;
    out property <color> track-instrument: #8092eb;
    out property <color> track-master: #ffffff;
    // Typography
    out property <string> font-ui: "Inter";
    out property <length> font-size-base: 12.5px;
    out property <length> font-size-small: 11px;
    // Geometry
    out property <length> gutter: 5px;
    out property <length> header-height: 73px;
    out property <length> browser-width: 253px;
    out property <length> timeline-header-height: 27px;
    out property <length> ruler-height: 39px;
    out property <length> track-header-width: 191px;
    out property <length> master-row-height: 30px;
    out property <length> bottom-header-height: 26px;
    out property <length> bottom-height: 306px;
    out property <length> panel-radius: 8px;
    out property <length> bar-width-default: 51px;
    // ---- Additions by the UI agent (measured from 01-main-default.png, see FIDELITY.md) ----
    out property <color> panel-edge-top: #3c3d40;      // 0.5 pt top highlight of panels
    out property <color> panel-edge-bottom: #1f2023;
    out property <color> pill-border: #3e3f43;         // transport pill outline
    out property <color> separator-dim: #323338;       // transport pill separators
    out property <color> icon: #8e8f93;                // inactive header icons
    out property <color> icon-dim: #48494f;            // disabled icons (preview bar)
    out property <color> small-button: #37383b;        // M/S/R/I backgrounds
    out property <color> value-blue: #77a6bd;          // knob values, fader fill
    out property <color> value-instrument: #7b87c3;    // inspector values on instrument tracks (32-*.png)
    out property <color> handle: #dddddd;              // slider handles
    out property <color> mute-on: #e8a33d;             // ORIGINAL choice (reference "on" state not captured)
    out property <color> solo-on: #e4d65a;             // ORIGINAL choice
    out property <color> meter-green: #4fc57b;         // ORIGINAL choice
    out property <color> record-red: #e5484d;          // ORIGINAL choice: armed R and the recording record button (src/controller.rs RECORD_RED)
    out property <color> popup-border: #424347;        // "In" popup outline (50-input-selector-open.png)
    out property <color> popup-border-top: #5a5b5f;    // its 0.5 pt top highlight
    out property <length> track-pitch: 74.8px;         // 88 px row: lane + 0.5 pt rule (src/timeline.rs)
    out property <length> lane-x: 191px;               // lanes start, timeline-panel relative
    out property <float> slider-zero-db: 0.8;          // (unitless) slider pos of 0 dB, header + track sliders
    // ---- Depth (soft raised / inset surfaces), measured from the 100 % live capture 2026-11-09 ----
    // One device pixel at 100 % zoom on a 2x display is 0.425 of our units.
    out property <length> hairline: 0.45px;
    out property <color> raised-rim: #3c3d40;          // 1 px top highlight of raised controls
    out property <color> raised-rim-accent: #436af5;   // same, on accent-filled pills
    out property <color> raised-shadow: #0000004d;     // soft shadow under raised controls
    out property <color> field-rim: #35363a;           // even outline of search fields
    out property <color> box-rim: #3c3d42;             // even outline of value boxes
    out property <color> inset-top: #0e0f11;           // dark top lip of grooves and wells
    out property <color> inset-shade: #1b1c20;         // inner shadow just below that lip
    out property <color> inset-bottom: #424347;        // light bottom lip
    out property <color> knob-face: #232426;           // inspector knob body
    out property <color> knob-groove: #242528;         // inspector knob value ring track
    out property <color> fader-handle: #fcf8f1;        // warm white fader cap
    // ---- Track headers (reference CSS, saturated colours in the display-P3 values the reference
    // shows on screen; see reference/research-findings.md, "Track headers") ----
    out property <length> track-h: 74.3px;             // track-pitch minus the 0.5 pt rule (TRACK_H)
    out property <color> track-solo-on: #f2f652;
    out property <color> track-arm-on: #d53721;
    out property <color> track-monitor-on: #e89a38;
    out property <color> meter-master: #abfcb6;
}
