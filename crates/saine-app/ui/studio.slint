// Studio global: the single bridge between Rust and the Slint UI, plus the
// view-model structs. Everything here is pushed from Rust (no authoritative
// state in the UI); edits leave through the callbacks.
import { Tokens } from "tokens.slint";

export struct TrackRow {
    id: int,
    number: int,
    name: string,
    instrument: bool,
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    arm: bool,
    monitor: bool,
    volume-pos: float,
    pan: float,
    // Automation (src/automation.rs): content y and total height (expanded lanes add rows),
    // the shown parameter (category + name), its lane state (0 none/inactive, 1 active,
    // 2 disabled) and colour (the parameter's bright hue, Hue in src/automation.rs),
    // the "Show N automated lanes" count, and controls following automation.
    y: length,
    h: length,
    auto-cat: string,
    auto-param: string,
    auto-state: int,
    auto-accent: color,
    auto-count: int,
    auto-expanded: bool,
    vol-auto: bool,
    pan-auto: bool,
}

// Value label at the left of an automation row (lane-local). state, accent, dim: as TrackRow.auto-*.
export struct AutoLabel { x: length, y: length, text: string, state: int, accent: color, dim: color }
// Expanded automation row in the track header column (content y).
export struct AutoExtra { track-id: int, index: int, y: length, cat: string, param: string, state: int, accent: color }

export struct RulerLabel { x: length, text: string }

export struct ClipLabel { x: length, y: length, w: length, text: string, selected: bool }

// Browser tree row (Devices tab; src/devices.rs). icon: 0 folder, 1 instrument (keys), 2 effect.
// expander: 0 none, 1 closed, 2 open. leaf: a device (double-click / drag adds it).
export struct TreeRow { depth: int, label: string, count: string, icon: int, expander: int, selected: bool, leaf: bool }

// One plugin card in the bottom-panel device chain (src/devices.rs). x is bottom-panel relative
// and already includes the chain scroll and a drag offset.
// ---- built-in device panel (src/device_panel.rs builds these from the DeviceDef) ----
// Knob cell (dial row). face 1 = soft-knee transfer curve instead of the ring (paths in a
// 32 x 32 view box). editing: the value text is being typed (inline field).
export struct PanelKnob { param: int, x: length, label: string, value: string, norm: float, bipolar: bool, face: int, face-curve: string, face-bend: string, face-unity: string }
// Picker row item. kind 0 caption, 1 segmented choice, 2 menu pill, 3 value box, 4 flexible gap.
export struct PanelPick { kind: int, param: int, label: string, choices: [string], selected: int, value: string, enabled: bool, width: length }
// Vertical slider column (x = column left, card relative).
// zero: normalised position the fill starts from (0 = bottom; 0 dB on a range through zero).
export struct PanelSlider { param: int, x: length, label: string, value: string, norm: float, zero: float }
export struct PanelTick { y: length, text: string, rule: bool }
// Dynamics strip: caption + readout above a well; paths are in well coordinates (view box w x well-h).
export struct PanelStrip {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick],
    in-fill: string, gr-fill: string, in-line: string, out-line: string,
    thresh-param: int, thresh-y: length, thresh-dash: string, thresh-label: string, thresh-value: string, thresh-rate: float,
}

// Plotted field (View::Field): caption + readout above a well; paths in well coordinates.
// plot-*: the drag area (well relative). band: fill is a min..max band (alpha .16) instead of
// the area under the first trace (alpha .28). dot: live LFO dot at dot-x / dot-y; live: the
// live response curve or the dot's trail, in the track colour.
export struct PanelField {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick], rest: string,
    fill: string, band: bool, main: string, main-w: length, main-hot-w: length,
    alt: string, alt-alpha: float, third: string, third-alpha: float,
    live: string, dot: bool, dot-x: length, dot-y: length,
    x-param: int, y-param: int, plot-x: length, plot-y: length, plot-w: length, plot-h: length,
}

// Canvas view (EQ curve, filter response...): a well with paths, texts, dots and value pills
// built in Rust (src/device_canvas.rs) in field-local px; pointer, wheel and keys go back to
// Rust, which hit-tests and runs the gestures. cursor: 0 default, 1 ew-resize, 2 ns-resize,
// 3 move, 4 pointer.
export struct CanvasPath { commands: string, stroke: color, width: length, fill: color }
export struct CanvasText { x: length, y: length, w: length, text: string, color: color, size: length, bold: bool, align: int }
export struct CanvasDot { x: length, y: length, r: length, fill: color, ring: length, ring-color: color }
// anchor: x is the pill's left (0), centre (1) or right (2) edge; y its centre.
export struct CanvasPill { x: length, y: length, anchor: int, label: string, value: string, hot: bool, grip: bool }
export struct PanelCanvas {
    visible: bool, x: length, y: length, w: length, h: length,
    caption: string, caption-h: length, well: bool,
    paths: [CanvasPath], texts: [CanvasText], dots: [CanvasDot], pills: [CanvasPill],
    cursor: int, label: string, value: string,
}
// EQ chrome around a field (View::Eq): band tabs + On latch (+ Bank menu), type glyph picker,
// value cells. Lengths are card relative.
export struct EqTab { label: string, on: bool }
export struct EqGlyph { commands: string, name: string, choice: int }
export struct EqCell { x: length, w: length, label: string, value: string, param: int, enabled: bool, rate: float }
export struct PanelEq {
    visible: bool,
    tabs: [EqTab], selected: int, tab-w: length,
    on-param: int, on: bool, latch-x: length,
    bank-param: int, bank-value: string, bank-x: length, bank-w: length,
    glyphs: [EqGlyph], glyph-selected: int, type-param: int,
    cells: [EqCell],
}

export struct DeviceCard {
    id: int,
    x: length,
    name: string,
    vendor: string,
    format: string,        // "AU" / "VST3" / "CLAP"
    kind: string,          // "Audio effect" / "Instrument"
    enabled: bool,
    instrument: bool,      // the track's instrument plugin (replaces the built-in Synth)
    error: string,         // engine load error ("" = loaded / unknown)
    latency: string,       // "" when 0
    has-editor: bool,
    editor-supported: bool, // the host can open plugin windows on this OS (not on Linux yet)
    editor-open: bool,
    dragging: bool,
    // Built-in devices (src/device_panel.rs, ui/device_panel.slint): the panel generated
    // from the device definition. Unused (empty) on plugin cards.
    builtin: bool,
    width: length,
    accent: color,
    preset: string,
    knobs: [PanelKnob],
    picks: [PanelPick],
    sliders: [PanelSlider],
    strip: PanelStrip,
    field: PanelField,
    // Slider column rail (card relative) and cell width.
    slider-top: length,
    slider-bottom: length,
    slider-w: length,
    // Canvas view (src/device_canvas.rs) and EQ chrome.
    canvas: PanelCanvas,
    eq: PanelEq,
}

// Settings › Plugins list rows. warn: drawn with the orange "Missing"/failure badge.
export struct PluginRow { name: string, detail: string, badge: string, warn: bool }


// ---- mixer panel (bottom panel replacement) ----
export struct MixerStrip {
    id: int,
    name: string,
    instrument: bool,
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    pan: float,
    pan-text: string,
    fader: float,   // 0 (top, +6 dB) .. 1 (bottom, -inf)
}
export struct StripMeter { l: float, r: float, peak: string }   // 0 (top) .. 1 (silent)

// ---- assistant panel ----
// kind: 0 user, 1 assistant reply, 2 error, 3 pending
export struct ChatEntry { kind: int, text: string, lines: [string], worked: string, expanded: bool }
export struct HighlightRect { x: length, y: length, w: length, h: length, note: string }

// ---- clip editor / piano roll / context menu ----
export struct YLabel { y: length, text: string }
// separator: a line is drawn above the item; y: row top inside the menu.
// ---- synth device (src/synth.rs) ----
// One continuous parameter: control position 0..1, readout with units.
export struct SynthParam { norm: float, text: string, bipolar: bool, auto: bool }
// A display: SVG path of the curve and of its filled area (viewbox = element size in points).
export struct SynthDisplay { line: string, fill: string }

// Checkable popup row ("In" selector, Settings dropdowns). hint: a grey wrapped note row.
export struct ChoiceItem { label: string, checked: bool, hint: bool, y: length, h: length }

export struct MenuItem { label: string, shortcut: string, enabled: bool, separator: bool, submenu: bool, y: length }

export global Studio {
    // ---- project / status ----
    in property <string> project-name: "Untitled";
    in property <string> status-text;
    // ---- transport (driven by engine.transport() every frame) ----
    in property <bool> playing;
    in property <string> bar-text: "001";
    in property <string> time-text: "00:00.000";
    in property <string> bpm-text: "120";
    in property <string> sig-text: "4/4";
    in property <float> master-pos: 0.85;
    in-out property <bool> sounds-visible: true;
    // Loop (project transport) and metronome (app preference), both real engine features.
    in property <bool> loop-enabled: false;
    in property <bool> metronome-on: false;
    callback toggle-loop();
    callback toggle-metronome();
    // ---- timeline ----
    in property <[TrackRow]> tracks;
    in property <length> scroll-y;
    in property <image> timeline-image;
    in property <[RulerLabel]> ruler-labels;
    in property <[ClipLabel]> clip-labels;
    in property <int> lane-cursor; // 0 default, 1 ew-resize (trim), 2 move (clip body)
    // ---- inspector (selected track) ----
    in property <bool> has-selection;
    in property <int> sel-id;
    in property <int> sel-number;
    in property <string> sel-name;
    in property <bool> sel-instrument;
    in property <color> sel-color: Tokens.track-audio;
    in property <bool> sel-mute;
    in property <bool> sel-solo;
    in property <float> sel-pan;
    in property <string> sel-pan-text: "C";
    in property <float> sel-fader;      // 0 (top, +6 dB) .. 1 (bottom, -inf)
    in property <string> sel-db-text: "0.00";
    in property <float> sel-meter-l: 1; // 0 (top) .. 1 (bottom = silent)
    in property <float> sel-meter-r: 1;
    in property <string> sel-peak-text: "−∞";
    // ---- browser Devices tab (src/devices.rs; the Chains sub-tab is PLACEHOLDER data) ----
    in property <[TreeRow]> tree;
    in property <int> browser-tab;             // 0 Instruments, 1 Effects, 2 Chains
    in-out property <string> browser-search;   // tree filter (transient input)
    in-out property <bool> search-focused;     // a device search field has keyboard focus
    in property <length> tree-scroll;
    in property <string> tree-empty;           // shown when the tree has no rows
    callback browser-tab-select(int);
    callback browser-search-edited(string);
    callback tree-click(int);
    callback tree-activate(int);               // double-click: add to the selected track
    callback tree-drag(int, int, length, length); // row, phase 0 down / 1 move / 2 up, window x, y
    callback tree-scroll-by(float);
    // Drag and drop of a browser device (ghost + drop target, window coordinates).
    in property <bool> dnd-active;
    in property <bool> dnd-ok;
    in property <length> dnd-x;
    in property <length> dnd-y;
    in property <string> dnd-label;
    in property <bool> dnd-target-visible;
    in property <length> dnd-tx;
    in property <length> dnd-ty;
    in property <length> dnd-tw;
    in property <length> dnd-th;

    // ---- callbacks into Rust ----
    callback play-toggle();
    callback stop-return();
    callback record();
    callback add-track();
    callback import-audio();
    callback select-track(int);
    callback track-mute(int);
    callback track-solo(int);
    callback track-volume(int, float);
    callback track-pan(int, float);
    callback gesture-end();
    callback master-volume(float);
    callback sel-fader-moved(float);
    callback lane-pointer(int, length, length, bool, bool, bool); // kind 0=down 1=move 2=up, x, y, shift, cmd, alt
    callback lane-hover(length, length);
    callback lane-scroll(float, float, length, bool);      // dx, dy, x, zoom
    callback key(string, bool, bool, bool, bool) -> bool;   // text, primary (Cmd on macOS), shift, alt, ctrl
    // ---- panels (owned by the controller) ----
    in property <bool> mixer-open;
    in property <bool> assistant-open;
    callback toggle-mixer();
    callback toggle-assistant();
    // ---- mixer ----
    in property <[MixerStrip]> strips;
    in property <[StripMeter]> strip-meters;
    in property <float> master-fader: 0.1126;
    in property <float> master-meter-l: 1;
    in property <float> master-meter-r: 1;
    in property <string> master-peak-text: "−∞";
    callback mixer-fader(int, float);      // track id, fader fraction
    callback master-fader-moved(float);
    callback reset-peaks();
    // ---- assistant ----
    in property <[ChatEntry]> chat;
    in property <bool> chat-available;     // provider configured (API key or TEST fixture)
    in property <bool> chat-busy;
    in property <bool> chat-notice: true;
    in property <bool> teach-mode;
    in property <bool> chat-context-visible;
    in property <string> chat-context-name;
    in property <string> chat-context-scope;
    in property <color> chat-context-color: Tokens.track-audio;
    in property <bool> chat-context-instrument;
    in-out property <string> chat-draft;   // composer text (transient input, not project state)
    in-out property <bool> chat-focused;
    in property <[HighlightRect]> highlights;
    callback chat-send(string);
    callback chat-new();
    callback chat-set-mode(bool);          // true = Teach
    callback chat-dismiss-notice();
    callback chat-toggle-entry(int);
    callback chat-remove-context();
    callback chat-placeholder(string);     // PLACEHOLDER controls report "not implemented"

    // ---- bottom panel: Clip / Devices tab, piano roll ----
    in property <int> bottom-tab;            // 0 Devices, 1 Clip
    callback set-bottom-tab(int);
    in property <bool> pr-visible;           // a MIDI clip is open in the piano roll
    in property <image> pr-image;            // wgpu note grid + keyboard (src/pianoroll.rs)
    in property <bool> pr-pen;
    in property <bool> pr-has-notes;
    in property <[RulerLabel]> pr-bar-labels;
    in property <[YLabel]> pr-key-labels;
    in property <string> pr-start-text: "1.1.0";
    in property <string> pr-end-text: "2.1.0";
    in property <string> pr-position-text: "1.1.0";
    in property <string> pr-length-text: "1.0.0";
    in property <string> pr-grid-text: "1/16";
    in property <string> pr-quant-text: "100%";
    in property <string> pr-human-text: "50%";
    in property <string> pr-vel-text: "100";
    in property <string> clip-empty-title: "No clip selected";
    in property <string> clip-empty-text: "Select a clip to edit it.";
    in property <string> clip-name: "MIDI";
    in property <color> clip-color: Tokens.track-instrument;
    callback pr-pointer(int, length, length, bool, bool);   // kind 0 down 1 move 2 up, x, y, shift, alt
    callback pr-scroll(float);
    callback pr-action(string);                             // quantize|humanize|reverse|legato|double|pen|smart_quantize|velocity_lane
    callback pr-value(int, int, float);                     // field, phase 0/1/2, dy since press
    // ---- clip context menu + rename ----
    callback lane-context(length, length, length, length);  // lane x, y, window x, y
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-h;
    in property <[MenuItem]> menu-items;
    in property <bool> sub-open;
    in property <length> sub-y;
    in property <length> sub-h;
    in property <[MenuItem]> sub-items;
    callback menu-activate(int);
    callback sub-activate(int);
    callback menu-dismiss();
    in property <bool> rename-open;
    in-out property <string> rename-text;
    callback rename-commit(string);
    callback rename-cancel();

    // ---- synth device (Devices tab, instrument track; src/synth.rs) ----
    in property <bool> synth-visible;
    in property <int> synth-page;                // index into the category list
    in property <string> synth-preset: "Init";
    in property <[SynthParam]> synth-params;     // indexed by SP.* (ui/synth.slint)
    in property <[string]> synth-choices;        // dropdown value texts, indexed by SC.*
    in property <[SynthDisplay]> synth-displays; // indexed by SD.*
    in property <bool> synth-menu-open;
    in property <length> synth-menu-x;
    in property <length> synth-menu-y;
    in property <length> synth-menu-w: 110px;
    in property <length> synth-menu-h;
    in property <[MenuItem]> synth-menu-items;
    callback synth-page-select(int);
    callback synth-param(int, float);            // param id, control position 0..1 (drag preview)
    callback synth-param-end();                  // gesture end: commits ONE SetSynthParams
    callback synth-param-reset(int);             // double-click: default value
    callback synth-dropdown(int, length, length, length); // choice id (-1 = presets), window x, y, width
    callback synth-menu-pick(int);
    callback synth-menu-dismiss();
    callback synth-preset-step(int);
    callback synth-placeholder(string);          // PLACEHOLDER controls report "not implemented"
    callback toggle-clip-devices();              // header "Switch between clip editor and devices"

    // ---- recording (src/recording.rs) ----
    in property <bool> recording;               // a recording pass is running (record button red)
    in property <bool> record-ready;            // some audio track is armed with an input
    in property <bool> sel-arm;
    in property <bool> sel-monitor;
    in property <string> sel-input-text: "Select audio input";
    in property <bool> input-menu-open;
    in property <[ChoiceItem]> input-menu-items;
    in property <length> input-menu-h: 48px;
    in property <length> input-menu-w: 136px;
    callback track-arm(int);                    // SetTrackArm (audio) / placeholder status (instrument)
    callback track-monitor(int);                // SetTrackMonitor (audio) / placeholder status (instrument)
    callback open-input-menu();
    callback input-menu-pick(int);              // SetTrackInput
    callback input-menu-dismiss();
    // ---- settings window (src/settings.rs, ui/settings.slint) ----
    in property <bool> settings-open;
    in property <int> settings-page: 1;
    in property <[string]> settings-pages;
    in property <string> set-output-text: "System default";
    in property <string> set-input-text: "None";
    in property <string> set-rate-text: "48 kHz";
    in property <string> set-buffer-text: "Device default";
    in property <bool> set-input-muted;
    in property <string> settings-note;
    in property <bool> set-pdc-on: true;
    in property <string> set-latency-text;
    in property <bool> settings-menu-open;
    in property <int> settings-menu-field;      // 0 output, 1 input, 2 sample rate, 3 buffer size
    in property <[ChoiceItem]> settings-menu-items;
    in property <length> settings-menu-h;
    callback toggle-settings();
    callback close-settings();
    callback settings-page-select(int);
    callback settings-dropdown(int);
    callback settings-menu-pick(int);
    callback settings-menu-dismiss();
    callback settings-toggle-mute();
    callback settings-toggle-pdc();
    callback settings-test();

    // ---- device chain (Devices tab; src/devices.rs, ui/devices.slint) ----
    in property <[DeviceCard]> device-cards;
    in property <length> chain-scroll;          // horizontal scroll of the chain (synth card included)
    in property <length> add-device-x: 265px;   // bottom-panel relative
    in property <bool> chain-marker-visible;    // insertion marker while dragging a card or a device
    in property <length> chain-marker-x;
    in property <string> sel-inst-text: "Synth";
    in-out property <string> add-search;        // Add device card search (transient input)
    in property <[MenuItem]> add-results;       // matches while add-search is not empty
    callback device-power(int);                 // SetDeviceEnabled
    callback device-edit(int);                  // open / close the plugin window
    callback device-remove(int);                // RemoveDevice (closes its window first)
    callback device-use-synth();                // SetInstrumentPlugin(None)
    callback device-drag(int, int, length);     // card id, phase 0/1/2, window x (MoveDevice on release)
    callback chain-scroll-by(float);
    // Built-in device panels: device id, parameter index (definition order).
    callback panel-drag(int, int, int, float, float, bool); // phase 0 press / 1 move / 2 release / 3 cancel, dy since last event (px, up +), norm per px, fine
    callback panel-reset(int, int);                          // default value (Alt-click, double-click)
    callback panel-step(int, int, int, bool);                // arrow keys: +1 / -1, fine
    callback panel-choice(int, int, int);                    // choice index
    callback panel-text(int, int, string);                   // typed value (parsed by the definition)
    callback panel-menu(int, int, length, length);           // -1 sidechain source, -2 presets, >= 0 a dropdown's choices; window x, y
    callback panel-field(int, int, float, float, bool);      // field XY drag: device, phase (as panel-drag), dx, dy (px, up +), fine
    callback panel-preset-step(int, int);                    // previous (-1) / next (+1) factory preset
    // Canvas views (EQ, Auto Filter): phase 0 press / 1 drag / 2 release / 3 cancel / 4 hover / 5 exit / 6 double-click;
    // field-local x, y (px); alt, shift.
    callback panel-canvas(int, int, float, float, bool, bool);
    callback panel-canvas-wheel(int, float, float, float) -> bool; // x, y, wheel dy (px, up +): used
    callback panel-canvas-key(int, string, bool, bool) -> bool;     // key text, shift, alt: accepted
    callback panel-eq(int, int, int);                        // action 0 select band / 1 toggle On / 2 type choice / 3 reset type; value
    callback add-category(int, length, length); // row (Built-in, AU, VST3, CLAP, Chains), window x, y for the list
    callback add-search-edited(string);
    callback add-result-pick(int);
    callback open-inst-menu(length, length);    // instrument selector list at window x, y
    // Device popup list (Add device submenus, instrument selector).
    in property <bool> devmenu-open;
    in property <length> devmenu-x;
    in property <length> devmenu-y;
    in property <length> devmenu-w: 200px;
    in property <length> devmenu-h;
    in property <length> devmenu-content-h;
    in property <[MenuItem]> devmenu-items;
    callback devmenu-pick(int);
    callback devmenu-dismiss();
    // ---- Settings › Plugins ----
    in property <string> plugins-status;
    in property <bool> plugins-scanning;
    in property <[PluginRow]> scan-dirs;
    in property <[PluginRow]> plugin-rows;
    in property <[PluginRow]> plugin-failed;
    callback plugins-rescan(bool);              // false: check for new plugins (cache), true: rescan all
    callback placeholder(string);               // PLACEHOLDER controls report "not implemented"

    // ---- automation (src/automation.rs) ----
    in property <bool> auto-shown;              // timeline header "Show/Hide automation lanes"
    in property <bool> auto-draw;               // "Draw mode (B)"
    in property <bool> auto-armed;              // transport "Automation Arm"
    in property <[AutoLabel]> auto-labels;
    in property <[AutoExtra]> auto-extras;
    in property <length> tracks-height: 149px;  // content height of all track rows
    in property <length> master-h: 30px;        // master row (64.5 pt while lanes are shown)
    in property <int> master-auto-state;
    in property <bool> master-vol-auto;
    in property <bool> sel-vol-auto;
    in property <bool> sel-pan-auto;
    callback auto-toggle-shown();
    callback auto-toggle-draw();
    callback auto-toggle-arm();
    callback auto-power(int, int);              // track id (-1 master), extra row index (-1 = shown lane)
    callback auto-expand(int);                  // track id
    callback auto-show-extra(int, int);         // track id, extra row index
    callback auto-open-picker(int, length, length); // track id (-1 master), window x, y of the pill's bottom-left
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-y;
    in property <length> picker-h;
    in-out property <string> picker-query;
    in-out property <bool> picker-focused;
    in property <[MenuItem]> picker-items;
    in property <bool> picker-sub-open;
    in property <length> picker-sub-y;
    in property <length> picker-sub-h;
    in property <[MenuItem]> picker-sub-items;
    callback picker-edited(string);
    callback picker-pick(int);
    callback picker-sub-pick(int);
    callback picker-dismiss();

    callback report-bug();   // TODO: no-op placeholder
    callback feedback();     // TODO: no-op placeholder
}

