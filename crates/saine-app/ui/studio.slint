// Studio global: the single bridge between Rust and the Slint UI, plus the
// view-model structs. Everything here is pushed from Rust (no authoritative
// state in the UI); edits leave through the callbacks.
import { Tokens } from "tokens.slint";

export struct TrackRow {
    id: int,
    number: int,
    name: string,
    instrument: bool,
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    arm: bool,
    monitor: bool,
    volume-pos: float,
    pan: float,
    // Automation (src/automation.rs): content y and total height (expanded lanes add rows),
    // the shown parameter (category + name), its lane state (0 none/inactive, 1 active,
    // 2 disabled) and colour (the parameter's bright hue, Hue in src/automation.rs),
    // the "Show N automated lanes" count, and controls following automation.
    y: length,
    h: length,
    // Track row height without its 0.5 pt rule (height scale × 88 px row; src/timeline.rs).
    row-h: length,
    auto-cat: string,
    auto-param: string,
    auto-state: int,
    auto-accent: color,
    auto-count: int,
    auto-expanded: bool,
    vol-auto: bool,
    pan-auto: bool,
}

// Track-header meter: 0 (silent, below -50 dB) .. 1 (0 dB), clip latched.
export struct TrackLevel { l: float, r: float, clip: bool }

// Value label at the left of an automation row (lane-local). state, accent, dim: as TrackRow.auto-*.
export struct AutoLabel { x: length, y: length, text: string, state: int, accent: color, dim: color }
// Expanded automation row in the track header column (content y).
export struct AutoExtra { track-id: int, index: int, y: length, cat: string, param: string, state: int, accent: color }

export struct RulerLabel { x: length, text: string }

// Section name in the ruler's section lane (src/sections.rs): x and room in lane points, ink per block.
export struct SectionLabel { x: length, w: length, text: string, ink: color }

export struct ClipLabel { x: length, y: length, w: length, text: string, selected: bool }

// Browser tree row (Devices tab; src/devices.rs). icon: 0 folder, 1 instrument (keys), 2 effect.
// expander: 0 none, 1 closed, 2 open. leaf: a device (double-click / drag adds it).
export struct TreeRow { depth: int, label: string, count: string, icon: int, expander: int, selected: bool, leaf: bool }
// Browser › Files row (src/files.rs): kind 0 row, 1 group label, 2 note; y and h in list
// coordinates; glyph 0 folder, 1 audio file, 2 project, 3 audio track, 4 instrument track,
// 5 MIDI clip; expander 0 none, 1 closed, 2 open.
export struct FileRow { kind: int, depth: int, y: length, h: length, label: string, detail: string, glyph: int, expander: int, selected: bool }
// Vertical guide beside an open row's contents (list coordinates).
export struct FileGuide { x: length, y: length, h: length }

// One plugin card in the bottom-panel device chain (src/devices.rs). x is bottom-panel relative
// and already includes the chain scroll and a drag offset.
// ---- built-in device panel (src/device_panel.rs builds these from the DeviceDef) ----
// Knob cell (card relative x, y). face 1 = soft-knee transfer curve instead of the ring (paths
// in a 32 x 32 view box); face 2 = On/Off latch (value = state name, norm 0 / 1). origin: the
// arc's start as a norm. ticks: detent marks across the ring (32 x 32 view box). dim: drawn at
// 55% (the control has no effect in the current state). latch: an On/Off cluster parameter drawn
// as a latch cell (value = its text, on = lit); momentary: on only while held; inert: ignores gestures.
// mod-*: modulation display (src/device_mod.rs): the reach of every source around the set value
// (lo..hi, 0..1), the live modulated position and the first source's colour.
export struct PanelKnob {
    param: int, x: length, y: length, label: string, value: string, norm: float, origin: float, dim: bool, face: int, face-curve: string, face-bend: string, face-unity: string, ticks: string,
    mod-on: bool, mod-lo: float, mod-hi: float, mod-now: float, mod-color: color, selected: bool, mapped: bool,
    // Text the value editor starts with (empty = value).
    edit: string,
    // Knob cell width (0 = the 62 pt default).
    cell: length,
    latch: bool, on: bool, momentary: bool, inert: bool,
}
// One modulation link in a source's target list (LFO targets, macro targets).
export struct ModTarget { index: int, name: string, amount: string }
// Modulation / container body of a card (src/device_mod.rs). kind 1 LFO, 2 chain head.
export struct ModCard {
    kind: int,
    targets: [ModTarget], map-armed: bool, slot: int,
    macro-name: string, macro-open: bool, members: int, collapsed: bool,
}
// A chain head's frame around its member cards (bottom-panel relative x).
export struct ChainFrame { x: length, w: length, armed: bool, color: color, empty-x: length, empty: bool, head: int }
// Picker row item. kind 0 caption, 1 segmented choice, 2 menu pill (param -1: sidechain, else a
// choice menu), 3 value box, 4 flexible gap, 5 latch (On/Off parameter; label shows the state,
// selected 0 / 1), 6 action button, 7 view switch / tabs (choices = view names, selected = shown view; UI state). dim: a menu pill shown at 60% until hovered
// (values that follow the project, e.g. the Pitch Corrector's key while Follow is Project).
export struct PanelPick { kind: int, param: int, label: string, choices: [string], selected: int, value: string, enabled: bool, width: length, dim: bool }
// Vertical slider column (x = column left, card relative).
// zero: normalised position the fill starts from (0 = bottom; 0 dB on a range through zero).
export struct PanelSlider { param: int, x: length, label: string, value: string, norm: float, zero: float }
export struct PanelTick { y: length, text: string, rule: bool }
// Device field (View::Custom): layers of paths in field coordinates (the well below the
// caption when well = true, else the field box), texts, grip pills and drag zones.
// fill .. fill2: vertical gradient from the top to the bottom of the well (equal = solid).
// label: accessible value when it differs from the readout (e.g. the Tuner's spoken note).
export struct PanelPath { commands: string, stroke: color, width: length, fill: color, fill2: color }
// align: 0 left, 1 centre, 2 right of [x, x + w].
export struct PanelText { x: length, y: length, w: length, h: length, text: string, color: color, size: length, weight: int, align: int }
// anchor: x is the grip's left (0), centre (1) or right (2) edge; y its centre. hot: drawn
// highlighted (hovered or dragged handle); plain: no grip dots.
export struct PanelGrip { x: length, y: length, label: string, value: string, anchor: int, hot: bool, plain: bool }
// Dot (node, handle): centre x / y, radius r, optional ring of width ring.
export struct PanelDot { x: length, y: length, r: length, fill: color, ring: length, ring-color: color }
// Drag zone: param-x / param-y (-1 = axis unused), norm per px (rate-x < 0: dragging right lowers).
export struct PanelZone { x: length, y: length, w: length, h: length, param-x: int, param-y: int, rate-x: float, rate-y: float }
export struct PanelCanvas {
    visible: bool, well: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string,
    paths: [PanelPath], texts: [PanelText], dots: [PanelDot], grips: [PanelGrip], zones: [PanelZone],
    // pointer: raw pointer, wheel and key events over the well go to Rust (Studio.panel-graph*),
    // which hit-tests them. interactive: every pointer event over the whole canvas (press, drag,
    // release, hover, right press, double-click, wheel, leave) goes to Rust as
    // Studio.panel-editor, with window coordinates for menus, for editors with their own
    // gestures and menus (src/device_editors.rs). cursor: 0 default, 1 move, 2 ew-resize,
    // 3 ns-resize, 4 pointer, 5 crosshair. readout-accent: the caption value is drawn in the
    // track colour. label / value: the pointer well's accessible name and value.
    pointer: bool, interactive: bool, cursor: int, readout-accent: bool, label: string, value: string,
}
// Intensity image of a field well (Reverb tail), stretched (bilinear) over the box x/y/w/h in
// well coordinates under the paths. Kept out of PanelCanvas: an image field in that struct
// doubled the first frames' render cost of every card.
export struct PanelWash { device: int, img: image, x: length, y: length, w: length, h: length }
// Freely placed control (custom card bodies): kind 0 latch (On/Off parameter), 1 menu pill
// (choice parameter, opens a menu of its choices).
export struct PanelButton { kind: int, param: int, x: length, y: length, w: length, label: string, on: bool }
// Dynamics strip: caption + readout above a well; paths are in well coordinates (view box w x well-h).
// Draggable dashed line and an optional solid second line (Alt+drag moves both).
export struct PanelStrip {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick],
    in-fill: string, gr-fill: string, in-line: string, out-line: string,
    thresh-param: int, thresh-y: length, thresh-dash: string, thresh-label: string, thresh-value: string, thresh-rate: float,
    second-param: int, second-y: length, second-line: string, second-label: string, second-value: string, second-rate: float,
}
// Multiband field (src/panel_multiband.rs): field-relative lengths; paths in a w x h view box.
export struct PanelBand {
    x: length, w: length, selected: bool,
    level-y: length, show-level: bool, gain-y: length, gain-h: length, show-gain: bool,
    thr-y: length, floor-y: length, thr-param: int, floor-param: int, thr-active: bool, floor-active: bool,
    thr-dash: string, floor-dash: string, thr-text: string, floor-text: string,
    handle-x: length, handle-w: length, thr-hit-y: length, thr-hit-h: length, floor-hit-y: length, floor-hit-h: length,
}
export struct PanelXover { x: length, param: int, text: string, rate: float }
export struct PanelFreq { x: length, text: string, grid: bool }
export struct PanelBands {
    visible: bool, x: length, y: length, w: length, h: length, ladder: length,
    ticks: [PanelTick], freqs: [PanelFreq], bands: [PanelBand], xovers: [PanelXover],
    thr-rate: float, floor-rate: float,
}

// Sampler-family panels (src/sampler_panel.rs): every length is card relative and
// already scaled; paths are in their box's own coordinates.
export struct PanelPad { label: string, name: string, filled: bool, selected: bool, level: float, x: length, y: length, w: length, h: length }
export struct PanelHandle { x: length, y: length, active: bool }
export struct PanelSampler {
    visible: bool,
    kind: int,                 // 0 Sampler, 1 Pad Sampler, 2 Drum Rack
    pads: [PanelPad], divider-x: length,
    sub-visible: bool, sub-x: length, sub-y: length, sub-w: length, sub-h: length, sub-on: bool, sub-on-param: int, sub-title: string,
    layer-visible: bool, layer-x: length, layer-y: length, layer-text: string, layer-name: string, mapped: string, can-step: bool,
    play-visible: bool, play-x: length,
    head-x: length, head-picks: [PanelPick],
    row-y: length, row-right: length, row-picks: [PanelPick],
    well-x: length, well-y: length, well-w: length, well-h: length,
    loaded: bool, empty-text: string, hint: string, sample-name: string, can-remove: bool,
    wave: string, dim: string, fades: string, slices: string, sel-x: length, sel-w: length, heads: string,
    start-x: length, end-x: length, fade-in-x: length, fade-out-x: length, loop-x: length, grips: [length],
    tabs-visible: bool, tabs-y: length, tab-pick: PanelPick, tab-right: length, tab-picks: [PanelPick],
    knobs: [PanelKnob], knob-y: length,
    pic-visible: bool, pic-x: length, pic-y: length, pic-w: length, pic-h: length,
    pic-fill: string, pic-line: string, pic-grid: string, handles: [PanelHandle], pic-pads: [PanelPad],
}

// Plotted field (View::Field): caption + readout above a well; paths in well coordinates.
// plot-*: the drag area (well relative). band: fill is a min..max band (alpha .16) instead of
// the area under the first trace (alpha .28). dot: live LFO dot at dot-x / dot-y; live: the
// live response curve or the dot's trail, in the track colour.
export struct PanelField {
    visible: bool, x: length, y: length, w: length, h: length, well-y: length,
    caption: string, readout: string, ticks: [PanelTick], rest: string,
    fill: string, band: bool, main: string, main-w: length, main-hot-w: length,
    alt: string, alt-alpha: float, third: string, third-alpha: float,
    live: string, dot: bool, dot-x: length, dot-y: length,
    x-param: int, y-param: int, plot-x: length, plot-y: length, plot-w: length, plot-h: length,
}

// EQ chrome around a field (View::Eq): band tabs + On latch (+ Bank menu), type glyph picker,
// value cells. Lengths are card relative.
export struct EqTab { label: string, on: bool }
export struct EqGlyph { commands: string, name: string, choice: int }
export struct EqCell { x: length, w: length, label: string, value: string, param: int, enabled: bool, rate: float }
export struct PanelEq {
    visible: bool,
    tabs: [EqTab], selected: int, tab-w: length,
    on-param: int, on: bool, latch-x: length,
    bank-param: int, bank-value: string, bank-x: length, bank-w: length,
    glyphs: [EqGlyph], glyph-selected: int, type-param: int,
    cells: [EqCell],
}

export struct DeviceCard {
    id: int,
    x: length,
    name: string,
    vendor: string,
    format: string,        // "AU" / "VST3" / "CLAP"
    kind: string,          // "Audio effect" / "Instrument"
    enabled: bool,
    instrument: bool,      // the track's instrument plugin (replaces the built-in Synth)
    error: string,         // engine load error ("" = loaded / unknown)
    latency: string,       // "" when 0
    has-editor: bool,
    editor-supported: bool, // the host can open plugin windows on this OS (not on Linux yet)
    editor-open: bool,
    win-dx: length,        // device window: drag offset from its default spot (src/devices.rs window_at)
    win-dy: length,
    dragging: bool,
    // Built-in devices (src/device_panel.rs, ui/device_panel.slint): the panel generated
    // from the device definition. Unused (empty) on plugin cards.
    builtin: bool,
    width: length,
    accent: color,
    accent-text: color,    // value text: the accent as a light OKLCH tint (L .87, chroma at most .11)
    accent-light: bool,    // the accent needs dark ink on it (switch thumb, selected segment text)
    preset: string,
    knobs: [PanelKnob],
    picks: [PanelPick],
    tight-picks: bool,     // no gap around the flexible gap in the picks row (analyzer cards)
    sliders: [PanelSlider],
    slider-top: length,
    strip: PanelStrip,
    // Generic header state (every card): folded to a strip, swappable from the name, in a chain.
    folded: bool,
    swappable: bool,
    member: bool,
    modv: ModCard,
    // Plugin card (third-party plugins): shown controls (knobs), pager.
    page: int,
    pages: int,
    sampler: PanelSampler,
    field: PanelField,
    bands: PanelBands,
    // Slider column rail (card relative) and cell width.
    slider-top: length,
    slider-bottom: length,
    slider-w: length,
    // Canvas view (src/device_canvas.rs) and EQ chrome.
    canvas: PanelCanvas,
    eq: PanelEq,
    buttons: [PanelButton],
}

// Settings › Plugins list rows. warn: drawn with the orange "Missing"/failure badge.
export struct PluginRow { name: string, detail: string, badge: string, warn: bool }


// ---- mixer panel (bottom panel replacement) ----
export struct MixerStrip {
    id: int,
    name: string,
    instrument: bool,
    color: color,
    selected: bool,
    mute: bool,
    solo: bool,
    pan: float,
    pan-text: string,
    fader: float,   // 0 (top, +6 dB) .. 1 (bottom, -inf)
    gain-text: string, // gain readout: "0.0", "+1.5", "−12.0", "−∞" at or below -60 dB
}
export struct StripMeter { l: float, r: float, peak: string }   // 0 (top) .. 1 (silent)

// ---- assistant panel ----
// kind: 0 user, 1 assistant reply, 2 error, 3 pending
// kind: 0 user, 1 reply, 2 error, 3 live row. point: sent in Point mode. fresh: added since the last rebuild (entry pop).
export struct ChatEntry { kind: int, text: string, lines: [string], worked: string, expanded: bool, point: bool, fresh: bool }
// Point ring (x, y, w, h, corner radius r) and its bubble anchor (bx; by is the bubble's top, or its bottom when above).
export struct HighlightRect { x: length, y: length, w: length, h: length, r: length, bx: length, by: length, above: bool, title: string, note: string }

// ---- clip editor / piano roll / context menu ----
export struct YLabel { y: length, text: string }
// separator: a line is drawn above the item; y: row top inside the menu.
// ---- synth device (src/synth.rs) ----
// One parameter of the Synth device: control position 0..1, readout with units.
export struct SynthParam { norm: float, text: string, bipolar: bool, auto: bool }
// A picture: SVG paths (viewbox = element size in points) of the curve, its filled area,
// secondary curves, handles and grid lines; dim = the part is silent.
export struct SynthDisplay { line: string, fill: string, ghost: string, dots: string, grid: string, dim: bool }
// Axis / value text drawn inside picture slot; align 0 left, 1 centre, 2 right of x.
export struct SynthLabel { slot: int, x: length, y: length, text: string, align: int, accent: bool }
// Page elements (card coordinates; knobs, latches: centre of the dial; faders: centre x, groove top).
export struct SynthArc { d: string, c: color }
export struct SynthKnobItem { idx: int, x: length, y: length, label: string, accent: color, dim: bool, lit: bool, arcs: [SynthArc], dots: [color] }
export struct SynthFaderItem { idx: int, x: length, y: length, label: string }
export struct SynthPillItem { x: length, y: length, w: length, label: string, value: string, action: int, arg: int, ring: int, ring-idx: int, outline: bool, chevron: bool }
export struct SynthTextItem { x: length, y: length, w: length, text: string, style: int, align: int }
export struct SynthSegItem { idx: int, x: length, y: length, w: length, options: [string], sel: int, first: int }
export struct SynthScopeItem { slot: int, x: length, y: length, w: length, h: length, grid: int, hgrid: int, zero: bool }
export struct SynthLatchItem { idx: int, x: length, y: length, label: string, on: bool }
export struct SynthRouteRow { slot: int, y: length, on: bool, on-idx: int, source: int, source-text: string, target-text: string, amount: float, amount-idx: int, text: string }
export struct SynthMapRow { heading: bool, slot: int, y: length, label: string, from: float, to: float, from-idx: int, to-idx: int, from-text: string, to-text: string }

// Checkable popup row ("In" selector, Settings dropdowns). hint: a grey wrapped note row.
export struct ChoiceItem { label: string, checked: bool, hint: bool, y: length, h: length }

export struct MenuItem { label: string, shortcut: string, enabled: bool, separator: bool, submenu: bool, y: length }

export global Studio {
    // ---- project / status ----
    in property <string> project-name: "Untitled";
    in property <string> status-text;
    // ---- transport (driven by engine.transport() every frame) ----
    in property <bool> playing;
    in property <string> bar-text: "001";
    in property <string> time-text: "00:00.000";
    in property <string> bpm-text: "120";
    in property <string> sig-text: "4/4";
    in property <float> master-pos: 0.85;
    in-out property <bool> sounds-visible: true;
    // Loop (project transport) and metronome (app preference), both real engine features.
    in property <bool> loop-enabled: false;
    in property <bool> metronome-on: false;
    callback toggle-loop();
    callback toggle-metronome();
    // ---- timeline ----
    in property <[TrackRow]> tracks;
    in property <[TrackLevel]> track-levels;    // by track index
    in property <TrackLevel> master-level;
    in property <length> scroll-y;
    in property <image> timeline-image;
    in property <[RulerLabel]> ruler-labels;
    in property <[SectionLabel]> section-labels;
    in property <length> section-add-x: 8.5px;     // centre of the section lane's "+"
    callback lane-double(length, length);          // lane x, y
    in property <[ClipLabel]> clip-labels;
    in property <int> lane-cursor; // 0 default, 1 ew-resize (trim), 2 move (clip body)
    // ---- inspector (selected track) ----
    in property <bool> has-selection;
    in property <int> sel-id;
    in property <int> sel-number;
    in property <string> sel-name;
    in property <bool> sel-instrument;
    in property <color> sel-color: Tokens.track-audio;
    in property <bool> sel-mute;
    in property <bool> sel-solo;
    in property <float> sel-pan;
    in property <string> sel-pan-text: "C";
    in property <float> sel-fader;      // 0 (top, +6 dB) .. 1 (bottom, -inf)
    in property <string> sel-db-text: "0.00";
    in property <float> sel-meter-l: 1; // 0 (top) .. 1 (bottom = silent)
    in property <float> sel-meter-r: 1;
    in property <string> sel-peak-text: "−∞";
    // ---- browser Devices tab (src/devices.rs; the Chains sub-tab is PLACEHOLDER data) ----
    in property <[TreeRow]> tree;
    in property <int> browser-tab;             // 0 Instruments, 1 Effects, 2 Chains
    in-out property <string> browser-search;   // tree filter (transient input)
    in-out property <bool> search-focused;     // a device search field has keyboard focus
    in property <length> tree-scroll;
    in property <string> tree-empty;           // shown when the tree has no rows
    callback browser-tab-select(int);
    callback browser-search-edited(string);
    callback tree-click(int);
    callback tree-activate(int);               // double-click: add to the selected track
    callback tree-drag(int, int, length, length); // row, phase 0 down / 1 move / 2 up, window x, y
    callback tree-scroll-by(float);
    // ---- browser sections, Back / Forward and the Files section (src/files.rs) ----
    in property <int> browser-section: 2;      // 2 Devices, 3 Files (Search and Library have no content)
    in property <bool> browser-can-back;
    in property <bool> browser-can-forward;
    in property <int> files-tab;               // 0 Projects, 1 Folders
    in property <[FileRow]> files;
    in property <[FileGuide]> files-guides;
    in property <length> files-scroll;
    in property <length> files-list-y: 81px;   // rule above the rows (96 with the count row)
    in property <string> files-meta;           // "2 folders"; empty hides the count row
    in property <string> files-sort: "Recent";
    in property <string> files-empty-title;
    in property <string> files-empty-hint;
    callback browser-section-select(int);
    callback browser-back();
    callback browser-forward();
    callback files-tab-select(int);
    callback files-add-folder();
    callback files-sort-toggle();
    callback files-click(int, bool);           // row, on the chevron
    callback files-activate(int);              // double-click
    callback files-drag(int, int, length, length); // row, phase 0 down / 1 move / 2 up, window x, y
    callback files-scroll-by(float);
    // Drag and drop of a browser device (ghost + drop target, window coordinates).
    in property <bool> dnd-active;
    in property <bool> dnd-ok;
    in property <length> dnd-x;
    in property <length> dnd-y;
    in property <string> dnd-label;
    in property <bool> dnd-target-visible;
    in property <length> dnd-tx;
    in property <length> dnd-ty;
    in property <length> dnd-tw;
    in property <length> dnd-th;

    // ---- callbacks into Rust ----
    callback play-toggle();
    callback stop-return();
    callback record();
    callback add-track();
    callback import-audio();
    callback select-track(int);
    callback track-mute(int);
    callback track-solo(int);
    callback track-volume(int, float);
    callback track-pan(int, float);
    callback track-pan-text(int, string);       // inline pan entry in the track header
    callback gesture-end();
    // ---- splitters (src/splitters.rs): phase 0 press, 1 move, 2 release; window y ----
    in property <length> bottom-h: 306px;
    callback bottom-resize(int, length);
    callback track-resize(int, int, length);                // track id, phase, window y
    callback master-volume(float);
    callback sel-fader-moved(float);
    callback lane-pointer(int, length, length, bool, bool, bool); // kind 0=down 1=move 2=up, x, y, shift, cmd, alt
    callback lane-hover(length, length);
    callback lane-scroll(float, float, length, bool);      // dx, dy, x, zoom
    callback key(string, bool, bool, bool, bool) -> bool;   // text, primary (Cmd on macOS), shift, alt, ctrl
    // ---- app menu bar (AppWindow MenuBar) ----
    // Items with a shortcut replay that key (text, primary, shift) into the window, so they act
    // exactly like the keystroke; the others call menu-action with an id.
    callback menu-key(string, bool, bool);
    callback menu-action(string);
    // True while menu-key replays its key: the shortcut items are disabled so the replay
    // reaches the widgets instead of activating the menu item again.
    in property <bool> menu-replay;
    in property <string> undo-text: "Undo";
    in property <string> redo-text: "Redo";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-copy;
    in property <bool> project-on-disk;
    // ---- panels (owned by the controller) ----
    in property <bool> mixer-open;
    in property <bool> assistant-open;
    // Saved docked-assistant width (or the live drag); AppWindow narrows it to the room the
    // timeline header leaves (src/splitters.rs mirrors the rule).
    in property <length> assistant-pref-w: 252.45px;
    callback chat-resize(int, length);                       // phase 0/1/2, window x
    callback chat-resize-reset();
    callback toggle-mixer();
    callback toggle-assistant();
    // ---- mixer ----
    in property <[MixerStrip]> strips;
    in property <[StripMeter]> strip-meters;
    in property <float> master-fader: 0.2;
    in property <float> master-meter-l: 1;
    in property <float> master-meter-r: 1;
    in property <string> master-peak-text: "−∞";
    in property <string> master-gain-text: "0.0";
    callback mixer-fader(int, float);      // track id, fader fraction
    callback master-fader-moved(float);
    callback reset-peaks();
    // ---- assistant ----
    in property <[ChatEntry]> chat;
    in property <bool> chat-available;     // provider configured (API key or TEST fixture)
    in property <bool> chat-busy;
    in property <bool> chat-notice: true;
    in property <bool> teach-mode;
    in property <bool> chat-context-visible;
    in property <string> chat-context-name;
    in property <string> chat-context-scope;
    in property <color> chat-context-color: Tokens.track-audio;
    in property <bool> chat-context-instrument;
    in-out property <string> chat-draft;   // composer text (transient input, not project state)
    in-out property <bool> chat-focused;
    in property <[HighlightRect]> highlights;
    callback chat-send(string);
    callback chat-new();
    callback chat-set-mode(bool);          // true = Point (Mode::Teach)
    callback chat-dismiss-notice();
    callback chat-toggle-entry(int);
    callback chat-remove-context();
    callback chat-placeholder(string);     // PLACEHOLDER controls report "not implemented"

    // ---- bottom panel: Clip / Devices tab, piano roll ----
    in property <int> bottom-tab;            // 0 Devices, 1 Clip
    callback set-bottom-tab(int);
    in property <bool> pr-visible;           // a MIDI clip is open in the piano roll
    in property <image> pr-image;            // wgpu note grid + keyboard (src/pianoroll.rs)
    in property <bool> pr-pen;
    in property <bool> pr-has-notes;
    in property <[RulerLabel]> pr-bar-labels;
    in property <[YLabel]> pr-key-labels;
    in property <string> pr-start-text: "1.1.0";
    in property <string> pr-end-text: "2.1.0";
    in property <string> pr-position-text: "1.1.0";
    in property <string> pr-length-text: "1.0.0";
    in property <string> pr-grid-text: "1/16";
    in property <string> pr-quant-text: "100%";
    in property <string> pr-human-text: "50%";
    in property <string> pr-vel-text: "100";
    in property <bool> ac-visible;           // an audio clip is open in the clip editor
    in property <string> ac-gain-text: "0.0 dB";
    in property <string> ac-bpm-text: "120";
    in property <string> ac-speed-text: "1x";
    in property <bool> ac-warped;            // Warp on: Mode is enabled, markers and transients edit
    in property <string> ac-mode-text: "Auto";
    callback ac-bpm-drag(int, length, length); // Original BPM drag: phase 0 press, 1 move, 2 release; offset from the press
    in property <bool> ac-reversed;
    callback ac-reverse-toggle();
    in property <string> ac-transpose-text: "0 st";
    in property <bool> ac-transpose-enabled: true;  // off in Re-pitch (pitch follows speed)
    callback ac-transpose-drag(int, length, length); // Transpose drag, like ac-bpm-drag
    in property <string> clip-name: "MIDI";
    in property <color> clip-color: Tokens.track-instrument;
    in property <color> clip-ink: #1d2142;   // text and icons on clip-colour fills
    callback pr-pointer(int, length, length, bool, bool);   // kind 0 down 1 move 2 up, x, y, shift, alt
    callback pr-scroll(float);
    callback pr-action(string);                             // quantize|humanize|reverse|legato|double|pen|smart_quantize|velocity_lane
    // Clip editor dropdowns: 0 Speed, 1 Warp, 2 Mode, 3 Grid, 4 Type, 5 Genre; -1 when closed.
    in property <int> clip-menu: -1;
    in property <[string]> clip-menu-items;
    in property <int> clip-menu-active: -1;
    callback clip-menu-open(int);
    callback clip-menu-pick(int);
    callback pr-value(int, int, float);                     // field, phase 0/1/2, dy since press
    // ---- clip context menu + rename ----
    callback lane-context(length, length, length, length);  // lane x, y, window x, y
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-h;
    in property <[MenuItem]> menu-items;
    in property <bool> sub-open;
    in property <length> sub-y;
    in property <length> sub-h;
    in property <[MenuItem]> sub-items;
    callback menu-activate(int);
    callback sub-activate(int);
    callback menu-dismiss();
    in property <bool> rename-open;
    in property <string> rename-title: "Rename clip";
    in-out property <string> rename-text;
    callback rename-commit(string);
    callback rename-cancel();

    // ---- synth device (Devices tab, instrument track; src/synth.rs) ----
    in property <bool> synth-visible;
    in property <int> synth-page;                // index into the category list
    in property <string> synth-preset: "Init";
    in property <bool> synth-enabled: true;
    in property <DeviceCard> synth-card;                     // the Synth as a device card (shared header, folded strip)
    in property <[SynthParam]> synth-params;     // indexed like the device definition
    in property <[SynthDisplay]> synth-displays; // indexed by synth::disp
    in property <[SynthLabel]> synth-labels;
    in property <[SynthKnobItem]> synth-knobs;   // the current page's elements
    in property <[SynthFaderItem]> synth-faders;
    in property <[SynthPillItem]> synth-pills;
    in property <[SynthTextItem]> synth-texts;
    in property <[SynthSegItem]> synth-segs;
    in property <[SynthScopeItem]> synth-scopes;
    in property <[SynthLatchItem]> synth-latches;
    in property <[SynthRouteRow]> synth-routes;  // Modulation page
    in property <[SynthMapRow]> synth-map-rows;  // Macros page
    in property <length> synth-split;            // module separator x (0 = none)
    in property <length> synth-add-y;            // "+ Add modulation / mapping" row
    in property <bool> synth-add-show;
    in property <int> synth-lit;                 // lit modulation source (0 = none)
    in property <color> synth-lit-color;
    in property <int> synth-macro-sel;
    in property <bool> synth-ghost-show;         // source chip dragged from the drawer
    in property <length> synth-ghost-x;
    in property <length> synth-ghost-y;
    in property <int> synth-ghost-src;
    in property <bool> synth-menu-open;
    in property <length> synth-menu-x;
    in property <length> synth-menu-y;
    in property <length> synth-menu-w: 110px;
    in property <length> synth-menu-h;
    in property <[MenuItem]> synth-menu-items;
    callback synth-page-select(int);
    callback synth-param(int, float);            // param index, control position 0..1 (heard, not yet a command)
    callback synth-param-end(int, bool);         // gesture end (moved?): commits ONE SetDeviceParam
    callback synth-param-reset(int);             // double-click: default value
    callback synth-set(int, float);              // param index, value (switches)
    callback synth-toggle(int);                  // on/off param index
    callback synth-pill(int, int, length, length, length); // menu action, argument, window x, y, width
    callback synth-remove(int, int);             // 0 route / 1 mapping, slot
    callback synth-knob-menu(int, length, length); // right click: param index, window x, y
    callback synth-rail(int, int, length, length); // source, phase (0 down 1 move 2 up), card x, y
    callback synth-scope-drag(int, int, length, length); // picture slot, phase, local x, y
    callback synth-macro-select(int);
    callback synth-bypass();
    callback synth-menu-pick(int);
    callback synth-menu-dismiss();
    callback synth-preset-step(int);
    callback synth-placeholder(string);          // PLACEHOLDER controls report "not implemented"
    callback toggle-clip-devices();              // header "Switch between clip editor and devices"

    // ---- recording (src/recording.rs) ----
    in property <bool> recording;               // a recording pass is running (record button red)
    in property <bool> record-ready;            // some audio track is armed with an input
    in property <bool> sel-arm;
    in property <bool> sel-monitor;
    in property <string> sel-input-text: "Select audio input";
    in property <bool> input-menu-open;
    in property <[ChoiceItem]> input-menu-items;
    in property <length> input-menu-h: 48px;
    in property <length> input-menu-w: 136px;
    callback track-arm(int);                    // SetTrackArm (audio) / placeholder status (instrument)
    callback track-monitor(int);                // SetTrackMonitor (audio) / placeholder status (instrument)
    callback open-input-menu();
    callback input-menu-pick(int);              // SetTrackInput
    callback input-menu-dismiss();
    // ---- export dialog and unsaved-changes prompt (src/dialogs.rs, ui/dialogs.slint) ----
    in property <bool> export-open;
    in property <bool> export-bits24: true;
    in property <bool> export-rate48: true;      // the engine rate (the render rate)
    in property <string> export-recipe-text: "WAV 24-bit";
    in property <string> export-bars-text: "Bars 1–1";
    in property <string> export-name: "Untitled.wav";
    in property <string> export-dir;
    in property <string> export-estimate;
    in property <int> export-recipe;             // 0 Mixdown, 1 Stems
    in property <string> export-stems-text: "0 WAV files";
    in property <string> export-files-text: "0 files";   // footer label on Stems
    in property <string> export-name-label: "Name"; // "Folder" when stems go into a folder
    in property <string> export-tracks-label: "All individual tracks";
    in property <bool> export-tracks-menu-open;
    in property <length> export-tracks-menu-h;
    in property <[ChoiceItem]> export-tracks-items;
    callback export-pick-recipe(int);
    callback export-toggle-tracks();
    callback export-pick-tracks(int);
    callback export-close();
    callback export-run();
    callback export-choose-dir();
    callback export-bits(bool);                 // true = 24-bit
    callback export-name-edited(string);
    in property <bool> unsaved-open;
    callback unsaved-cancel();
    callback unsaved-dont-save();
    callback unsaved-save();
    // ---- settings window (src/settings.rs, ui/settings.slint) ----
    in property <bool> settings-open;
    in property <int> settings-page: 1;
    in property <[string]> settings-pages;
    in property <string> set-output-text: "System default";
    in property <string> set-input-text: "None";
    in property <string> set-rate-text: "48 kHz";
    in property <string> set-buffer-text: "Device default";
    in property <bool> set-input-muted;
    in property <string> settings-note;
    in property <bool> set-pdc-on: true;
    in property <string> set-latency-text;
    in property <bool> settings-menu-open;
    in property <int> settings-menu-field;      // 0 output, 1 input, 2 sample rate, 3 buffer size
    in property <[ChoiceItem]> settings-menu-items;
    in property <length> settings-menu-h;
    callback toggle-settings();
    callback close-settings();
    callback settings-page-select(int);
    callback settings-dropdown(int);
    callback settings-menu-pick(int);
    callback settings-menu-dismiss();
    callback settings-toggle-mute();
    callback settings-toggle-pdc();
    callback settings-test();

    // ---- device chain (Devices tab; src/devices.rs, ui/devices.slint) ----
    in property <[DeviceCard]> device-cards;
    in property <[DeviceCard]> device-window-cards;          // built-in cards open in a device window (any track)
    in property <length> chain-scroll;          // horizontal scroll of the chain (synth card included)
    in property <length> add-device-x: 265px;   // bottom-panel relative
    in property <bool> chain-marker-visible;    // insertion marker while dragging a card or a device
    in property <length> chain-marker-x;
    in property <string> sel-inst-text: "Synth";
    in-out property <string> add-search;        // Add device card search (transient input)
    in property <[MenuItem]> add-results;       // matches while add-search is not empty
    callback device-power(int);                 // SetDeviceEnabled
    callback device-edit(int);                  // open / close the plugin window
    callback device-remove(int);                // RemoveDevice (closes its window first)
    callback device-use-synth();                // SetInstrumentPlugin(None)
    callback device-drag(int, int, length);     // card id, phase 0/1/2, window x (MoveDevice on release)
    callback chain-scroll-by(float);
    // Built-in device panels: device id, parameter index (definition order).
    callback panel-drag-pair(int, int, int, int, float, float, bool); // device, line param, other line param, then as panel-drag
    callback panel-drag(int, int, int, float, float, bool); // phase 0 press / 1 move / 2 release / 3 cancel, dy since last event (px, up +), norm per px, fine
    callback panel-reset(int, int);                          // default value (Alt-click, double-click)
    callback panel-reset-xy(int, int, int);                  // device, param x, param y (-1 = unused): both to default, one undo step
    callback panel-step(int, int, int, bool);                // arrow keys: +1 / -1, fine
    callback panel-choice(int, int, int);                    // choice index
    callback panel-text(int, int, string);                   // typed value (parsed by the definition)
    callback panel-menu(int, int, length, length);           // -1 sidechain source, -2 presets, >= 0 a dropdown's choices; window x, y
    callback panel-drag-xy(int, int, int, int, float, float, float, float, bool); // device, param x, param y, phase, dx, dy (px, right / up +), norm per px x / y, fine
    callback panel-field(int, int, float, float, bool);      // field XY drag: device, phase (as panel-drag), dx, dy (px, up +), fine
    callback panel-preset-step(int, int);                    // previous (-1) / next (+1) factory preset
    callback panel-latch(int, int, int);                     // latch: 0 click (toggle) / 1 press / 2 release (momentary)
    // Custom view canvas: kind 0 press, 1 drag, 2 release, 3 cancel, 4 hover, 5 right press,
    // 6 double-click, 7 wheel (dy notches, up +), 8 pointer left; canvas x, y; window x, y; shift, alt.
    callback panel-editor(int, int, length, length, length, length, bool, bool, float);
    callback panel-view(int, int, float);                    // custom view action (0 select band at field x px, 1 select band n, 2 show card view n)
    // ---- modulation and containers (src/device_mod.rs) ----
    in property <[ChainFrame]> chain-frames;
    // Bumped when the chain's cards change (added, removed, moved, folded): a focused control
    // inside a rebuilt card is gone, so the window takes the keyboard back.
    in property <int> cards-epoch;
    callback device-ask(int);                                // header spark: ask the assistant about this device
    callback device-window-moved(int, length, length);       // device window dragged: its new offset, kept per device
    callback device-window(int);                             // header arrow: open / close the device's floating window
    callback device-fold(int);                               // fold / unfold the card (header double-click, minus)
    callback device-collapse(int);                           // chain head: hide / show its members
    callback device-swap-menu(int, length, length);          // "Choose effect plugin" from the card name
    callback device-rename(int, string);                     // card label (chain group name)
    callback mod-menu(int, int, length, length);             // right-click on a control: Automate, Modulators, Macros
    callback mod-map(int, int);                              // arm / disarm a source output (LFO 0, macro n) for mapping
    callback mod-add-menu(int, int, length, length);         // + : parameter list of the track to add as targets
    callback mod-amount-drag(int, int, int, float, bool);    // source, link index, phase 0/1/2/3, dy (px, up +), fine
    callback mod-amount-text(int, int, string);              // typed amount (percent)
    callback mod-amount-step(int, int, int, bool);           // arrow keys
    callback mod-remove(int, int);                           // remove link
    callback macro-select(int, int);                         // chain head: open / toggle a macro's side panel
    callback macro-rename(int, int, string);
    callback chain-add-effect(int, length, length);          // empty chain "Add effect"
    callback card-add-menu(int, length, length);             // plugin card "+ Add": parameter list (knobs use panel-*)
    callback card-page(int, int);                            // pager -1 / +1
    // Sampler-family panels (src/sampler_panel.rs).
    callback sampler-pad(int, int, int, bool);               // which (0 rack pad, 1 slice pad), index, pressed
    callback sampler-layer(int, int);                        // previous (-1) / next (+1) sound of the pad
    callback sampler-play(int, bool);                        // Play button pressed / released
    callback sampler-action(int, int);                       // pick-row button (view, add slice, clear slice)
    callback sampler-remove(int);                            // remove the shown sample
    callback sampler-load(int);                              // choose an audio file for the shown slot
    callback sampler-well(int, int, float, float, bool);     // phase, x fraction, grab distance (fraction), alt
    callback sampler-handle(int, int, int, length, length);  // picture handle i: phase, x, y (picture px)
    callback panel-graph(int, int, float, float, bool, bool); // canvas pointer (PanelCanvas.pointer): phase (0 press, 1 drag, 2 release, 3 cancel, 4 hover, 5 leave, 6 double-click), well x, y (px), shift, alt
    in property <[PanelWash]> field-washes;                  // src/panel_fields.rs: wash images of field wells
    callback panel-graph-menu(int, float, float, length, length); // canvas right press: well x, y (px), window x, y: the handle's parameter menu
    callback panel-graph-wheel(int, float, float, float) -> bool; // canvas wheel: x, y, wheel dy (px, up +): used
    callback panel-graph-key(int, string, bool, bool) -> bool;     // canvas key: text, shift, alt: accepted
    callback panel-eq(int, int, int);                        // action 0 select band / 1 toggle On / 2 type choice / 3 reset type; value
    callback add-category(int, length, length); // row (Built-in, AU, VST3, CLAP, Chains), window x, y for the list
    callback add-search-edited(string);
    callback add-result-pick(int);
    callback open-inst-menu(length, length);    // instrument selector list at window x, y
    // Device popup list (Add device submenus, instrument selector).
    in property <bool> devmenu-open;
    in property <length> devmenu-x;
    in property <length> devmenu-y;
    in property <length> devmenu-w: 200px;
    in property <length> devmenu-h;
    in property <length> devmenu-content-h;
    in property <[MenuItem]> devmenu-items;
    callback devmenu-pick(int);
    callback devmenu-dismiss();
    // ---- Settings › Plugins ----
    in property <string> plugins-status;
    in property <bool> plugins-scanning;
    in property <[PluginRow]> scan-dirs;
    in property <[PluginRow]> plugin-rows;
    in property <[PluginRow]> plugin-failed;
    callback plugins-rescan(bool);              // false: check for new plugins (cache), true: rescan all
    callback placeholder(string);               // PLACEHOLDER controls report "not implemented"

    // ---- automation (src/automation.rs) ----
    in property <bool> auto-shown;              // timeline header "Show/Hide automation lanes"
    in property <bool> auto-draw;               // "Draw mode (B)"
    in property <bool> auto-armed;              // transport "Automation Arm"
    in property <[AutoLabel]> auto-labels;
    in property <[AutoExtra]> auto-extras;
    in property <length> tracks-height: 149px;  // content height of all track rows
    in property <length> master-h: 30px;        // master row (64.5 pt while lanes are shown)
    in property <int> master-auto-state;
    in property <bool> master-vol-auto;
    in property <bool> sel-vol-auto;
    in property <bool> sel-pan-auto;
    callback auto-toggle-shown();
    callback auto-toggle-draw();
    callback auto-toggle-arm();
    callback auto-power(int, int);              // track id (-1 master), extra row index (-1 = shown lane)
    callback auto-expand(int);                  // track id
    callback auto-show-extra(int, int);         // track id, extra row index
    callback auto-open-picker(int, length, length); // track id (-1 master), window x, y of the pill's bottom-left
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-y;
    in property <length> picker-h;
    in-out property <string> picker-query;
    in-out property <bool> picker-focused;
    in property <[MenuItem]> picker-items;
    in property <bool> picker-sub-open;
    in property <length> picker-sub-y;
    in property <length> picker-sub-h;
    in property <[MenuItem]> picker-sub-items;
    callback picker-edited(string);
    callback picker-pick(int);
    callback picker-sub-pick(int);
    callback picker-dismiss();

    callback report-bug();   // TODO: no-op placeholder
    callback feedback();     // TODO: no-op placeholder
}

