// Device chain (bottom panel, Devices tab): plugin cards, the "Add device" card and the
// device popup list (src/devices.rs). Card styling follows the Synth card header measured
// from 32-real-dblclick-instrument-lane.png (power toggle at 9,8.25, name at 37.5, header
// line at 26.5). The plugin card body is ORIGINAL: there is no host-side parameter UI
// (docs/adr/0003-plugins.md), so it shows the plugin identity and opens the plugin window.
import { Tokens } from "tokens.slint";
import { Icon, Icons } from "widgets.slint";
import { Studio, MenuItem, DeviceCard } from "studio.slint";

global CardStyle {
    out property <color> card: #212227;
    out property <color> edge: #313236;
    out property <color> line: #323338;
    out property <color> dim: #818389;
    out property <color> badge: #2f3034;
    out property <color> warn-bg: #4a3415;
    out property <color> warn: #f5a524;
    out property <length> width: 220px;
}

component CardButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 22px;
    border-radius: 6px;
    background: ta.has-hover && root.enabled ? #333438 : #28292d;
    border-width: 0.5px;
    border-color: #3d3e42;
    accessible-role: button;
    accessible-label: root.text;
    Text { text: root.text; color: root.enabled ? #e5e5e8 : #66676c; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component PluginCard inherits Rectangle {
    in property <DeviceCard> card;
    width: CardStyle.width;
    height: 265px;
    border-radius: 6px;
    background: CardStyle.card;
    border-width: root.card.dragging ? 1px : 0.5px;
    border-color: root.card.dragging ? Tokens.accent : CardStyle.edge;
    drop-shadow-blur: root.card.dragging ? 12px : 0px;
    drop-shadow-color: #00000080;
    accessible-role: groupbox;
    accessible-label: root.card.name;

    // ---- header: drag to reorder (MoveDevice on release) ----
    TouchArea {
        x: 0; y: 0; width: root.width; height: 26.5px;
        mouse-cursor: root.card.instrument ? MouseCursor.default : MouseCursor.grab;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.device-drag(root.card.id, 0, self.absolute-position.x + self.mouse-x); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.device-drag(root.card.id, 2, self.absolute-position.x + self.mouse-x); }
        }
        moved => { Studio.device-drag(root.card.id, 1, self.absolute-position.x + self.mouse-x); }
    }
    // Power toggle (real: SetDeviceEnabled; off = bypassed).
    Rectangle {
        x: 9px; y: 8.25px; width: 20px; height: 10px; border-radius: 5px;
        background: root.card.enabled ? Studio.sel-color : #4a4b4f;
        accessible-role: checkbox; accessible-label: "Device on"; accessible-checked: root.card.enabled;
        Rectangle { x: root.card.enabled ? parent.width - 9px : 1px; y: 1px; width: 8px; height: 8px; border-radius: 4px; background: #ffffff; }
        TouchArea { clicked => { Studio.device-power(root.card.id); } }
    }
    Text {
        x: 37.5px; y: 6px; width: root.width - 37.5px - 56px; height: 14px;
        text: root.card.name; color: root.card.enabled ? #ffffff : #9d9d9f; font-size: 9.75px; font-weight: 700;
        vertical-alignment: center; overflow: elide;
    }
    // Plugin window (real: open/close_plugin_editor) and remove (real: RemoveDevice).
    Rectangle {
        x: root.width - 44px; y: 5px; width: 17px; height: 17px; border-radius: 4px;
        background: root.card.editor-open ? #34363c : transparent;
        accessible-role: button; accessible-label: root.card.editor-open ? "Close plugin window" : "Open plugin window";
        Icon { x: 2.5px; y: 2.5px; width: 12px; height: 12px; d: Icons.window; ink: root.card.editor-open ? #ffffff : CardStyle.dim; stroke-width: 1.2px; }
        TouchArea { clicked => { Studio.device-edit(root.card.id); } }
    }
    Rectangle {
        x: root.width - 23px; y: 5px; width: 17px; height: 17px;
        accessible-role: button; accessible-label: root.card.instrument ? "Use built-in Synth" : "Remove device";
        Icon { x: 3.5px; y: 3.5px; width: 10px; height: 10px; d: Icons.close; ink: CardStyle.dim; stroke-width: 1.3px; }
        TouchArea { clicked => { if (root.card.instrument) { Studio.device-use-synth(); } else { Studio.device-remove(root.card.id); } } }
    }
    Rectangle { x: 0; y: 26.5px; width: root.width; height: 0.5px; background: CardStyle.line; }

    // ---- body ----
    Rectangle {
        x: 0; y: 27px; width: root.width; height: root.height - 27px;
        opacity: root.card.enabled ? 1.0 : 0.5;
        badge := Rectangle {
            x: 11px; y: 11px; width: badge-text.preferred-width + 10px; height: 15px; border-radius: 4px; background: CardStyle.badge;
            badge-text := Text { text: root.card.format; color: #d4d4d7; font-size: 8.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: badge.x + badge.width + 7px; y: 11px; height: 15px; text: root.card.kind; color: CardStyle.dim; font-size: 9px; font-weight: 500; vertical-alignment: center; }
        Text {
            x: 11px; y: 34px; width: parent.width - 22px; height: 18px;
            text: root.card.name; color: #f0f0f2; font-size: 12.5px; font-weight: 700; vertical-alignment: center; overflow: elide;
        }
        Text { x: 11px; y: 53px; width: parent.width - 22px; height: 14px; text: root.card.vendor; color: Tokens.text-secondary; font-size: 9.5px; font-weight: 500; vertical-alignment: center; overflow: elide; }
        if root.card.latency != "": Text { x: 11px; y: 72px; width: parent.width - 22px; height: 14px; text: root.card.latency; color: CardStyle.dim; font-size: 9px; vertical-alignment: center; }
        Text {
            x: 11px; y: parent.height - (root.card.instrument ? 92px : 64px); width: parent.width - 22px; height: 14px;
            text: root.card.error != "" ? "Not loaded: the device passes audio through" : root.card.has-editor ? "Open the plugin window to edit" : "This plugin has no editor window";
            color: Tokens.text-tertiary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center;
        }
        CardButton {
            x: 11px; y: parent.height - (root.card.instrument ? 72px : 44px); width: parent.width - 22px;
            text: root.card.editor-open ? "Close plugin window" : "Open plugin window";
            enabled: root.card.has-editor && root.card.error == "";
            clicked => { Studio.device-edit(root.card.id); }
        }
        if root.card.instrument: CardButton {
            x: 11px; y: parent.height - 44px; width: parent.width - 22px;
            text: "Use built-in Synth";
            clicked => { Studio.device-use-synth(); }
        }
    }
    // Engine load error (not dimmed when bypassed).
    if root.card.error != "": Rectangle {
        x: 11px; y: 27px + 92px; width: root.width - 22px; height: err.preferred-height + 8px; border-radius: 4px; background: CardStyle.warn-bg;
        accessible-role: text; accessible-label: "Load error: " + root.card.error;
        err := Text { x: 6px; width: parent.width - 12px; text: root.card.error; color: CardStyle.warn; font-size: 9px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
    }
}

// "Add device" card (reference 32: 182.5 x 264, rows 22 pt from y 56.5). The reference's rows are
// Audio Units / VST3 / Chains; ours are Built-in / Audio Units / VST3 / CLAP / Chains.
export component AddDeviceCard inherits Rectangle {
    width: 182.5px;
    height: 264px;
    border-radius: 6px;
    background: Tokens.bg-raised;
    border-width: 0.5px;
    border-color: #313236;
    Text { x: 11.5px; y: 6.5px; height: 14px; text: "Add device"; color: #a0a0a3; font-size: 10px; font-weight: 600; vertical-alignment: center; }
    Rectangle { x: 0; y: 26.5px; width: parent.width; height: 0.5px; background: #313236; }
    Rectangle {
        x: 5.5px; y: 31.5px; width: 171px; height: 20px; border-radius: 10px; background: Tokens.bg-control;
        Icon { x: 8.5px; width: 13px; height: 13px; d: Icons.search; ink: #b0b0b3; }
        if Studio.add-search == "": Text { x: 26px; text: "Search devices"; color: #a5a5a8; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 26px; width: parent.width - 32px; height: parent.height;
            text: Studio.add-search; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center;
            single-line: true;
            accessible-label: "Search devices";
            edited => { Studio.add-search = self.text; Studio.add-search-edited(self.text); }
            changed has-focus => { Studio.search-focused = self.has-focus; }
        }
    }
    if Studio.add-search == "": Rectangle {
        x: 0; y: 56.5px; width: root.width; height: 5 * 22px;
        for name[i] in ["Built-in", "Audio Units", "VST3", "CLAP", "Chains"]: Rectangle {
            x: 0; y: i * 22px; width: parent.width; height: 22px;
            accessible-role: button; accessible-label: name;
            Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: row-ta.has-hover ? #2a2b30 : transparent; }
            Text { x: 11.5px; text: name; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
            Icon { x: parent.width - 18px; width: 10px; height: 10px; d: Icons.chevron-right; ink: #a0a0a3; }
            row-ta := TouchArea { clicked => { Studio.add-category(i, root.absolute-position.x + root.width - 4px, parent.absolute-position.y + parent.y); } }
        }
    }
    if Studio.add-search != "": Rectangle {
        x: 0; y: 56.5px; width: root.width; height: root.height - 60px;
        clip: true;
        for it[i] in Studio.add-results: Rectangle {
            x: 0; y: i * 22px; width: parent.width; height: 22px;
            accessible-role: button; accessible-label: it.label;
            Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: res-ta.has-hover && it.enabled ? #2a2b30 : transparent; }
            Text { x: 11.5px; width: parent.width - 52px; text: it.label; color: it.enabled ? Tokens.text-primary : Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - 10px - self.preferred-width; text: it.shortcut; color: #8a8b8e; font-size: 8.5px; font-weight: 600; vertical-alignment: center; }
            res-ta := TouchArea { enabled: it.enabled; clicked => { Studio.add-result-pick(i); } }
        }
    }
}

// Device popup list (Add device submenus, instrument selector). Disabled rows are section
// headers / empty notes. Scrolls when taller than the window.
export component DevMenuList inherits Rectangle {
    in property <[MenuItem]> items;
    in property <length> content-h;
    callback picked(int);
    border-radius: 7px;
    background: #222327;
    border-width: 0.5px;
    border-color: #3a3b40;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000090;
    clip: true;
    Flickable {
        content-height: root.content-h;
        for it[i] in root.items: Rectangle {
            x: 4px; y: it.y; width: root.width - 8px; height: 20.5px;
            accessible-role: button;
            accessible-label: it.label;
            if it.separator: Rectangle { x: 6px; y: -1.5px; width: parent.width - 12px; height: 0.5px; background: #3a3b40; }
            Rectangle { border-radius: 4px; background: ta.has-hover && it.enabled ? Tokens.accent : transparent; }
            Text {
                x: it.enabled ? 10px : 8px; width: parent.width - 70px; text: it.label;
                color: it.enabled ? #f0f0f2 : #808186; font-size: it.enabled ? 9.5px : 8.5px; font-weight: it.enabled ? 600 : 700;
                vertical-alignment: center; overflow: elide;
            }
            Text { x: parent.width - 10px - self.preferred-width; text: it.shortcut; color: #a9aaae; font-size: 8.75px; font-weight: 500; vertical-alignment: center; }
            ta := TouchArea { enabled: it.enabled; clicked => { root.picked(i); } }
        }
    }
}
