// Device chain (bottom panel, Devices tab): plugin cards, the "Add device" card and the
// device popup list (src/devices.rs). Card styling follows the Synth card header measured
// from 32-real-dblclick-instrument-lane.png (power toggle at 9,8.25, name at 37.5, header
// line at 26.5). Plugin cards show the controls the user adds (plugin-card spec); the header
// is shared with the built-in cards (device_panel.slint CardHeader).
import { Tokens } from "tokens.slint";
import { Icon, Icons, Field } from "widgets.slint";
import { Studio, MenuItem, DeviceCard } from "studio.slint";
import { KnobCell, CardHeader, FoldedStrip } from "device_panel.slint";

global CardStyle {
    out property <color> card: #212227;
    out property <color> edge: #313236;
    out property <color> line: #323338;
    out property <color> dim: #818389;
    out property <color> badge: #2f3034;
    out property <color> warn-bg: #4a3415;
    out property <color> warn: #f5a524;
    out property <length> width: 220px;
}

// Plugin card (third-party plugin, handoffs/device-specs/plugin-card.md): the generic header
// (power, name = effect picker, device window, fold, remove), then only the controls the user
// added with "+ Add" plus any the plugin's macros, LFOs or automation move; nine per page.
component PluginFace inherits Rectangle {
    in property <DeviceCard> card;
    property <float> zm: 0.85;
    width: root.card.width;
    height: 265px;
    border-radius: 6px;
    background: CardStyle.card;
    border-width: root.card.dragging ? 1px : 0.5px;
    border-color: root.card.dragging ? Tokens.accent : CardStyle.edge;
    drop-shadow-blur: root.card.dragging ? 12px : 0px;
    drop-shadow-color: #00000080;
    accessible-role: groupbox;
    accessible-label: root.card.name;

    CardHeader { x: 0; y: 0; width: root.width; card: root.card; }

    Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        opacity: root.card.enabled ? 1.0 : 0.5;
        for k in root.card.knobs: KnobCell { x: k.x + 8px; y: k.y; device: root.card.id; k: k; accent: root.card.accent; }
        // "+ Add": the only control of a new card, then under the controls.
        add := Rectangle {
            x: root.card.knobs.length == 0 ? 15px : 11px; y: root.card.knobs.length == 0 ? 40px : root.height - 27px;
            width: add-row.preferred-width; height: 18px; border-radius: 9px;
            background: add-ta.has-hover ? #333438 : #28292d; border-width: 0.5px; border-color: #3d3e42;
            accessible-role: button; accessible-label: "Add controls";
            add-row := HorizontalLayout {
                padding-left: 7px; padding-right: 9px; spacing: 4px;
                Icon { y: 4px; width: 10px; height: 10px; d: Icons.plus; ink: #e5e5e8; stroke-width: 1.4px; }
                Text { text: "Add"; color: #e5e5e8; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
            }
            add-ta := TouchArea { clicked => { Studio.card-add-menu(root.card.id, self.absolute-position.x, self.absolute-position.y + self.height + 2px); } }
        }
        if root.card.pages > 1: HorizontalLayout {
            x: root.width - 80px; y: root.height - 27px; width: 70px; height: 18px; spacing: 2px; alignment: end;
            for dir[i] in [-1, 1]: Rectangle {
                width: 16px; accessible-role: button; accessible-label: i == 0 ? "Previous page" : "Next page";
                Icon { x: 3px; y: 4px; width: 10px; height: 10px; d: i == 0 ? Icons.chevron-left : Icons.chevron-right; ink: pg-ta.has-hover ? #e5e5e8 : CardStyle.dim; stroke-width: 1.3px; }
                pg-ta := TouchArea { clicked => { Studio.card-page(root.card.id, dir); } }
            }
            Text { text: (root.card.page + 1) + "/" + root.card.pages; color: CardStyle.dim; font-size: 9px; font-weight: 600; vertical-alignment: center; }
        }
        if root.card.knobs.length == 0 && root.card.error == "": Text {
            x: 15px; y: 66px; width: root.width - 30px; wrap: word-wrap;
            text: root.card.has-editor ? "Add the controls you want on this card, or open the device window." : "Add the controls you want on this card.";
            color: Tokens.text-tertiary; font-size: 9px;
        }
        if root.card.latency != "": Text { x: 11px + add.width + 10px; y: root.height - 27px; height: 18px; text: root.card.latency; color: CardStyle.dim; font-size: 9px; vertical-alignment: center; }
    }
    // Engine load error (not dimmed when bypassed).
    if root.card.error != "": Rectangle {
        x: 11px; y: 27px + 92px; width: root.width - 22px; height: err.preferred-height + 8px; border-radius: 4px; background: CardStyle.warn-bg;
        accessible-role: text; accessible-label: "Load error: " + root.card.error;
        err := Text { x: 6px; width: parent.width - 12px; text: "Not loaded, audio passes through: " + root.card.error; color: CardStyle.warn; font-size: 9px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
    }
}

export component PluginCard inherits Rectangle {
    in property <DeviceCard> card;
    width: root.card.width;
    height: 265px;
    if root.card.folded: FoldedStrip { card: root.card; }
    if !root.card.folded: PluginFace { card: root.card; }
}

// "Add device" card (reference 32: 182.5 x 264, rows 22 pt from y 56.5). The reference's rows are
// Audio Units / VST3 / Chains; ours are Built-in / Audio Units / VST3 / CLAP / Chains.
export component AddDeviceCard inherits Rectangle {
    width: 182.5px;
    height: 264px;
    border-radius: 6px;
    background: Tokens.bg-raised;
    border-width: 0.5px;
    border-color: #313236;
    Text { x: 11.5px; y: 6.5px; height: 14px; text: "Add device"; color: #a0a0a3; font-size: 10px; font-weight: 600; vertical-alignment: center; }
    Rectangle { x: 0; y: 26.5px; width: parent.width; height: 0.5px; background: #313236; }
    Field {
        x: 5.5px; y: 31.5px; width: 171px; height: 20px; border-radius: 10px;
        Icon { x: 8.5px; width: 13px; height: 13px; d: Icons.search; ink: #b0b0b3; }
        if Studio.add-search == "": Text { x: 26px; text: "Search devices"; color: #a5a5a8; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 26px; width: parent.width - 32px; height: parent.height;
            text: Studio.add-search; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center;
            single-line: true;
            accessible-label: "Search devices";
            edited => { Studio.add-search = self.text; Studio.add-search-edited(self.text); }
            changed has-focus => { Studio.search-focused = self.has-focus; }
        }
    }
    if Studio.add-search == "": Rectangle {
        x: 0; y: 56.5px; width: root.width; height: 5 * 22px;
        for name[i] in ["Built-in", "Audio Units", "VST3", "CLAP", "Chains"]: Rectangle {
            x: 0; y: i * 22px; width: parent.width; height: 22px;
            accessible-role: button; accessible-label: name;
            Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: row-ta.has-hover ? #2a2b30 : transparent; }
            Text { x: 11.5px; text: name; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
            Icon { x: parent.width - 18px; width: 10px; height: 10px; d: Icons.chevron-right; ink: #a0a0a3; }
            row-ta := TouchArea { clicked => { Studio.add-category(i, root.absolute-position.x + root.width - 4px, parent.absolute-position.y + parent.y); } }
        }
    }
    if Studio.add-search != "": Rectangle {
        x: 0; y: 56.5px; width: root.width; height: root.height - 60px;
        clip: true;
        for it[i] in Studio.add-results: Rectangle {
            x: 0; y: i * 22px; width: parent.width; height: 22px;
            accessible-role: button; accessible-label: it.label;
            Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: res-ta.has-hover && it.enabled ? #2a2b30 : transparent; }
            Text { x: 11.5px; width: parent.width - 52px; text: it.label; color: it.enabled ? Tokens.text-primary : Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - 10px - self.preferred-width; text: it.shortcut; color: #8a8b8e; font-size: 8.5px; font-weight: 600; vertical-alignment: center; }
            res-ta := TouchArea { enabled: it.enabled; clicked => { Studio.add-result-pick(i); } }
        }
    }
}

// Device popup list (Add device submenus, instrument selector). Disabled rows are section
// headers / empty notes. Scrolls when taller than the window.
export component DevMenuList inherits Rectangle {
    in property <[MenuItem]> items;
    in property <length> content-h;
    callback picked(int);
    border-radius: 7px;
    background: #222327;
    border-width: 0.5px;
    border-color: #3a3b40;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000090;
    clip: true;
    Flickable {
        content-height: root.content-h;
        for it[i] in root.items: Rectangle {
            x: 4px; y: it.y; width: root.width - 8px; height: 20.5px;
            accessible-role: button;
            accessible-label: it.label;
            if it.separator: Rectangle { x: 6px; y: -1.5px; width: parent.width - 12px; height: 0.5px; background: #3a3b40; }
            Rectangle { border-radius: 4px; background: ta.has-hover && it.enabled ? Tokens.accent : transparent; }
            Text {
                x: it.enabled ? 10px : 8px; width: parent.width - 70px; text: it.label;
                color: it.enabled ? #f0f0f2 : #808186; font-size: it.enabled ? 9.5px : 8.5px; font-weight: it.enabled ? 600 : 700;
                vertical-alignment: center; overflow: elide;
            }
            Text { x: parent.width - 10px - self.preferred-width; text: it.shortcut; color: #a9aaae; font-size: 8.75px; font-weight: 500; vertical-alignment: center; }
            ta := TouchArea { enabled: it.enabled; clicked => { root.picked(i); } }
        }
    }
}
