// Step sequencer of a pattern clip (Clip tab > Sequencer): toolbar (Double, Clear, lane
// tabs), step numbers, pad / pitch rows with M / S, the cell grid and the Sequence footer.
// Rows, cells and numbers come from src/stepseq.rs (visible rows only, editor-local
// geometry); pointer gestures go back to Rust, which previews and commits one
// SetStepPattern per gesture. Measured from z100-clip-pattern-sequencer-*.png.
import { Tokens } from "tokens.slint";
import { Icon, Icons } from "widgets.slint";
import { Studio } from "studio.slint";
import { FooterLabel, FooterTitle } from "pianoroll.slint";

component SeqTool inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 14px;
    width: t.preferred-width;
    t := Text {
        x: 0; text: root.text;
        color: root.enabled ? (ta.has-hover ? #e5e5e8 : #a6a8ac) : #63656c;
        font-size: 9.75px; font-weight: 500; vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Footer value in the clip colour: a menu (click) or a drag value.
component SeqValue inherits Rectangle {
    in property <string> text;
    in property <int> menu: -1;
    in property <bool> drag;
    in property <color> ink: Studio.clip-color;
    height: 14px;
    width: t.preferred-width;
    t := Text { x: 0; text: root.text; color: root.ink; font-size: 10px; font-weight: 600; letter-spacing: 0.45px; vertical-alignment: center; }
    if root.menu >= 0: TouchArea { clicked => { Studio.clip-menu-open(root.menu); } }
    if root.drag: TouchArea {
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.seq-swing(0, 0); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.seq-swing(2, (self.mouse-y - self.pressed-y) / 1px); }
        }
        moved => { Studio.seq-swing(1, (self.mouse-y - self.pressed-y) / 1px); }
    }
}

component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <color> on-fill;
    in property <color> on-ink;
    width: 12px; height: 12px; border-radius: 2.5px;
    background: root.on ? root.on-fill : #232426;
    Text { text: root.text; color: root.on ? root.on-ink : #63656c; font-size: 7px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

export component StepSequencer inherits Rectangle {
    property <length> row-y0: 55px;
    property <length> row-pitch: 22px;
    property <length> cell-h: 19.5px;
    property <length> col-x0: 136.5px;
    property <length> grid-h: root.height - root.row-y0 - 54.5px;

    // ---- toolbar (y 0..27) ----
    SeqTool { x: 7px; y: 7px; text: "Double"; enabled: Studio.seq-can-double; clicked => { Studio.seq-action("double"); } }
    SeqTool { x: 46px; y: 7px; text: "Clear"; clicked => { Studio.seq-action("clear"); } }
    for name[i] in ["Steps", "Velocity", "Offset", "Repeat", "Tie"]: Rectangle {
        x: [150px, 208px, 276px, 336px, 400px][i] - 13.35px; y: 3px;
        width: lt.preferred-width + 26.7px; height: 21px; border-radius: 10.5px;
        background: Studio.seq-lane == i ? #2651f5 : transparent;
        lt := Text {
            x: 13.35px; text: name; color: Studio.seq-lane == i ? #ffffff : (pta.has-hover ? #ffffff : #d0d0d1);
            font-size: 10.2px; font-weight: 600; vertical-alignment: center;
        }
        pta := TouchArea { clicked => { Studio.seq-lane-pick(i); } }
    }
    Rectangle { x: 0; y: 27px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // ---- step numbers ----
    for n in Studio.seq-nums: Text {
        x: n.x; y: 39px; width: Studio.seq-cell-w; height: 14px; text: n.text;
        color: n.beat && n.active ? #e5e5e8 : #6b6c70; font-size: 8.5px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }

    // ---- rows and cells (y relative to the first row's top) ----
    grid := Rectangle {
        x: 0; y: root.row-y0; width: root.width; height: root.grid-h;
        clip: true;
        for r in Studio.seq-rows: Rectangle {
            x: 0; y: r.y - root.row-y0; width: root.col-x0; height: root.row-pitch;
            Rectangle { x: 0.5px; y: 2.25px; width: 3px; height: 15px; border-radius: 1.5px; background: r.audible ? #63656c : #3c3d43; }
            Text { x: 11px; y: 0; height: root.cell-h; text: r.number; color: #6c6e74; font-size: 9px; font-weight: 500; vertical-alignment: center; }
            Text {
                x: 20px; y: 0; width: 68px; height: root.cell-h; text: r.name; overflow: elide;
                color: r.audible ? #8e8f93 : #4a4b50; font-size: 9.5px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center;
            }
            RowButton { x: 95px; y: 3.75px; text: "M"; on: r.muted; on-fill: #1253ff; on-ink: #ffffff; }
            RowButton { x: 112px; y: 3.75px; text: "S"; on: r.soloed; on-fill: #f1f607; on-ink: #1a1b1e; }
        }
        for c in Studio.seq-cells: Rectangle {
            x: c.x; y: c.y - root.row-y0; width: c.w; height: root.cell-h;
            border-radius: 3px; clip: true;
            opacity: c.dim ? 0.45 : 1;
            background: c.state == 0 ? #212225 : c.state == 1 ? #28292c : #353639;
            if c.state == 2 && c.lane == 1: Rectangle { x: 0; y: parent.height * (1 - c.bar); width: parent.width; height: parent.height * c.bar; background: #4a4c52; }
            if c.state == 2 && c.lane == 2: Rectangle { x: Studio.seq-cell-w * c.bar - 1px; y: 4px; width: 2px; height: parent.height - 8px; border-radius: 1px; background: #9a9ba0; }
            if c.state == 2 && c.lane == 3: Rectangle {
                for k in c.marks - 1: Rectangle { x: (k + 1) * Studio.seq-cell-w / c.marks; y: 0; width: 1px; height: parent.height; background: #1a1b1e; }
            }
            if c.state == 2 && c.lane == 4: Icon { x: parent.width - 13px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; d: Icons.chevron-right; ink: #e5e5e8; stroke-width: 1.6px; }
            if c.label != "": Text { text: c.label; color: #ffffff; font-size: 8.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
        // hovered cell
        property <int> hc: floor((ta.mouse-x - root.col-x0) / Studio.seq-col-pitch);
        property <int> hr: floor((ta.mouse-y + Studio.seq-scroll-y) / root.row-pitch);
        if ta.has-hover && !ta.pressed && ta.mouse-x >= root.col-x0 && grid.hc < Studio.seq-cols && grid.hr >= 0 && grid.hr < Studio.seq-row-count: Rectangle {
            x: root.col-x0 + grid.hc * Studio.seq-col-pitch; y: grid.hr * root.row-pitch - Studio.seq-scroll-y;
            width: Studio.seq-cell-w; height: root.cell-h; border-radius: 3px; background: #ffffff0a;
        }
        ta := TouchArea {
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.seq-pointer(0, self.mouse-x, self.mouse-y + root.row-y0); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.seq-pointer(2, self.mouse-x, self.mouse-y + root.row-y0); }
            }
            moved => { Studio.seq-pointer(1, self.mouse-x, self.mouse-y + root.row-y0); }
            scroll-event(e) => { Studio.seq-scroll(e.delta-y / 1px); accept }
        }
    }

    // ---- footer ----
    Rectangle { x: 0; y: root.height - 54.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    property <length> r1: root.height - 54.5px + 13px;
    property <length> r2: root.height - 54.5px + 30px;
    FooterTitle { x: 13.5px; y: root.r1; text: "Clip"; }
    FooterLabel { x: 13.5px; y: root.r2; text: "Start"; }
    SeqValue { x: 42.5px; y: root.r2; text: Studio.pr-start-text; }
    FooterLabel { x: 86px; y: root.r2; text: "End"; }
    SeqValue { x: 110px; y: root.r2; text: Studio.pr-end-text; }
    FooterTitle { x: 174px; y: root.r1; text: "Sequence"; }
    FooterLabel { x: 174px; y: root.r2; text: "Length"; }
    SeqValue { x: 211.5px; y: root.r2; text: Studio.seq-length-text; menu: 6; }
    FooterLabel { x: 237.5px; y: root.r2; text: "Rate"; }
    SeqValue { x: 264px; y: root.r2; text: Studio.seq-rate-text; menu: 7; }
    FooterLabel { x: 306.5px; y: root.r2; text: "Swing"; }
    SeqValue { x: 340px; y: root.r2; text: Studio.seq-swing-text; drag: true; }
}
