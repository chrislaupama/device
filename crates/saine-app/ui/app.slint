// Saine Studio main window.
//
// Geometry follows reference/ui-inventory.md (window-relative points at 1440x820).
// Panels are positioned absolutely at the measured coordinates; right-hand
// elements are anchored to the right edge so the window stays resizable.
// The timeline lanes, ruler background, grid, loop bar, clips, waveforms and the
// playhead are a wgpu texture (`Studio.timeline-image`) rendered by src/gpu.
// Slint draws text and controls over/around it.
//
// The UI holds no authoritative state: every value comes from Rust (Studio
// global), every edit goes out through a Studio callback that becomes a
// saine_core::Command or an engine transport call.
// Inter 4.1 (SIL OFL 1.1, ui/fonts/Inter-OFL-LICENSE.txt): the reference UI's typeface.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import { Tokens } from "tokens.slint";
import { Panel, Icon, Icons, Pill, IconButton, SmallButton, HSlider, Knob, Switch, Label, Raised, Field, Inset } from "widgets.slint";

export { Tokens }

import { Studio, TrackRow, TrackLevel, AutoLabel, AutoExtra, RulerLabel, ClipLabel, TreeRow, MixerStrip, StripMeter, ChatEntry, HighlightRect, YLabel, MenuItem, SynthParam, SynthDisplay, SynthLabel, SynthArc, SynthKnobItem, SynthFaderItem, SynthPillItem, SynthTextItem, SynthSegItem, SynthScopeItem, SynthLatchItem, SynthRouteRow, SynthMapRow, ChoiceItem, DeviceCard, PluginRow } from "studio.slint";
import { ClipSidebar, PianoRoll, ClipEmpty, ContextMenu } from "pianoroll.slint";
import { MixerPanel } from "mixer.slint";
import { StripMetrics, StripCanvas, StripReadout, StripButton } from "channel_strip.slint";
import { AssistantPanel, HighlightOverlay } from "assistant.slint";
import { SynthDevice, SynthMenuList } from "synth.slint";
import { SettingsPanel, ChoiceList } from "settings.slint";
import { PluginCard, AddDeviceCard, DevMenuList } from "devices.slint";
import { BuiltinCard } from "device_panel.slint";
import { TrackHeaderRow, MasterHeaderRow, AutoPill } from "track_header.slint";

export { Studio, TrackRow, TrackLevel, AutoLabel, AutoExtra, RulerLabel, ClipLabel, TreeRow, MixerStrip, StripMeter, ChatEntry, HighlightRect, YLabel, MenuItem, SynthParam, SynthDisplay, SynthLabel, SynthArc, SynthKnobItem, SynthFaderItem, SynthPillItem, SynthTextItem, SynthSegItem, SynthScopeItem, SynthLatchItem, SynthRouteRow, SynthMapRow, ChoiceItem, DeviceCard, PluginRow }

// ------------------------------------------------------------------ header
component Header inherits Rectangle {
    // Root-relative coordinates (header panel sits at 5,5).
    Panel { x: 5px; y: 5px; width: root.width - 10px; height: 68px; }

    // Title (centred). AX: 695,11,50,18
    Text {
        x: 0; y: 11px; width: root.width; height: 18px;
        text: Studio.project-name; color: Tokens.text-title; font-size: 10px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
        accessible-role: text;
    }
    Pill { x: root.width - 220px; y: 9.45px; width: 82px; height: 22.1px; text: "Report a bug"; weight: 600; text-color: #f2f2f2; font-size: 10.2px; letter-spacing: -0.41px; clicked => { Studio.report-bug(); } }
    Pill { x: root.width - 131px; y: 9.45px; width: 118px; height: 22.1px; text: "Share your feedback"; weight: 600; text-color: #f2f2f2; font-size: 10.2px; letter-spacing: -0.41px; clicked => { Studio.feedback(); } }

    // Logo: ORIGINAL sine-wave mark + "Beta" badge.
    Icon { x: 13px; y: 44px; width: 15px; height: 16px; d: Icons.logo; ink: #ffffff; stroke-width: 2.6px; }
    Rectangle {
        x: 31px; y: 46px; width: 26px; height: 12.5px;
        border-radius: 4px; border-width: 0.75px; border-color: #6a6b6f;
        Text { text: "Beta"; color: #ffffff; font-size: 6.75px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Sounds toggle (shows/hides the browser panel). AX 67,39,62,25
    Rectangle {
        x: 67px; y: 39px; width: 62px; height: 25px;
        accessible-role: checkbox; accessible-label: "Sounds"; accessible-checked: Studio.sounds-visible;
        Icon { x: 6px; width: 14px; height: 14px; d: Icons.library; ink: Studio.sounds-visible ? #c9c9cc : Tokens.icon; }
        Text { x: 22px; y: 1.5px; height: parent.height; text: "Sounds"; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; color: Studio.sounds-visible ? #cfd0d3 : Tokens.text-tertiary; vertical-alignment: center; }
        TouchArea { clicked => { Studio.sounds-visible = !Studio.sounds-visible; } }
    }

    // Transport block (buttons, pill, master volume). Coordinates are for a 1440-unit-wide
    // window; the reference keeps the block centred, so it shifts by half the width change
    // (AX at 85 % and 100 % zoom: pill centre = window centre + 16.5 units in both).
    Rectangle {
        x: (root.width - 1440px) / 2; y: 0; width: 1440px; height: root.height;
        // Transport buttons
        IconButton { x: 368px; y: 38px; width: 28px; height: 28px; icon: Icons.rewind; filled: true; icon-size: 21.5px; ink: #63656c; tooltip: "Rewind to start (Enter)"; clicked => { Studio.stop-return(); } }
        IconButton { x: 396px; y: 38px; width: 28px; height: 28px; icon: Studio.playing ? Icons.pause : Icons.play; filled: true; icon-size: 21.5px;
            ink: Studio.playing ? Tokens.text-primary : #63656c; tooltip: "Play (Space)"; clicked => { Studio.play-toggle(); } }
        // Record (R): start/stop recording armed audio tracks. Dim (measured) when nothing is armed,
        // icon grey when ready, recording red while recording.
        IconButton { x: 423px; y: 38px; width: 28px; height: 28px; icon: Icons.record; filled: true; icon-size: 23px;
            ink: Studio.recording ? Tokens.record-red : Studio.record-ready ? #63656c : #303136;
            tooltip: "Record (R)"; active: false; clicked => { Studio.record(); } }

        // Transport capsule 464.5..1008.5 x 34.85..68.85 (40 px high in the reference CSS)
        // Inset well: 2 px dark top lip, short inner shadow, light bottom lip.
        Inset {
            x: 464.5px; y: 34.85px; width: 544px; height: 34px;
            border-radius: 17px; fill: Tokens.bg-raised;
            lip: 0.85px; shade: 1.3px; bottom: #4c4d51;
        }
        IconButton { x: 470px; y: 41px; width: 22px; height: 22px; icon: Icons.loop; ink: #63656c; tooltip: "Toggle loop (⌘L)"; active: Studio.loop-enabled; clicked => { Studio.toggle-loop(); } }
        // Automation Arm (src/automation.rs): while armed and playing, control moves write automation.
        IconButton { x: 496px; y: 41px; width: 21px; height: 22px; icon: Icons.automation; ink: #63656c; tooltip: "Automation Arm: knob moves write automation while playing";
            active: Studio.auto-armed; clicked => { Studio.auto-toggle-arm(); } }
        Label { x: 527px; y: 45px; text: "Bar"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 548px; y: 45px; text: Studio.bar-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Rectangle { x: 581.5px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 595px; y: 45px; text: "Time"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 624px; y: 45px; text: Studio.time-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Rectangle { x: 689px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 703px; y: 45px; text: "BPM"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 733px; y: 45px; text: Studio.bpm-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        // TAP: PLACEHOLDER (tap tempo not implemented)
        Rectangle {
            x: 762px; y: 44px; width: 23px; height: 15px; border-radius: 3px; background: #34353a;
            Text { text: "TAP"; color: #e5e5e8; font-size: 7.75px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { x: 798px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 812px; y: 45px; text: "Key"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        // Key selector: PLACEHOLDER (no key/scale in the model yet)
        Rectangle { x: 846px; y: 51.5px; width: 13px; height: 1.2px; background: #7a7b7e; }
        Icon { x: 873px; y: 45px; width: 14px; height: 14px; d: Icons.chevron-down; ink: #7a7b7e; }
        Rectangle { x: 901.5px; y: 43px; width: 1px; height: 18px; background: Tokens.separator-dim; }
        Label { x: 916px; y: 45px; text: "Sig"; color: #565656; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Label { x: 936.5px; y: 45px; text: Studio.sig-text; color: #ffffff; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; }
        Icon { x: 957px; y: 45px; width: 13px; height: 13px; d: Icons.chevron-down; ink: #a0a0a3; }
        IconButton { x: 981px; y: 41px; width: 22px; height: 22px; icon: Icons.metronome; filled: true; ink: #63656c; tooltip: "Metronome"; active: Studio.metronome-on; clicked => { Studio.toggle-metronome(); } }

        // Master volume (header), real: SetMasterGain
        HSlider {
            x: 1022.5px; y: 45px; width: 95px; height: 14px; handle-size: 11px; lip: 0.85px;
            pos: Studio.master-pos;
            moved(p) => { Studio.master-volume(p); }
            released => { Studio.gesture-end(); }
            reset => { Studio.master-volume(Tokens.slider-zero-db); Studio.gesture-end(); }
        }
    }

    // Right-side panel toggles. Assistant and mixer are real; the rest are PLACEHOLDERS.
    // Glyph centres at y 51.9 (61 pt at 100 %), like the reference; inactive ink #767678.
    IconButton { x: root.width - 147px; y: 39px; width: 25px; height: 25px; icon: Icons.assistant; filled: true; icon-size: 15px;
        ink: Studio.assistant-open ? #e5e5e8 : #767678; tooltip: "Toggle assistant panel (⇧⌘A)"; clicked => { Studio.toggle-assistant(); } }
    IconButton { x: root.width - 119px; y: 39px; width: 25px; height: 25px; icon: Icons.mixer;
        ink: Studio.mixer-open ? #e5e5e8 : #767678; tooltip: "Toggle mixer panel (⇧⌘X)"; clicked => { Studio.toggle-mixer(); } }
    IconButton { x: root.width - 91px; y: 39px; width: 25px; height: 25px; icon: Icons.panel-bottom; ink: #b4b5b8; tooltip: "Switch between clip editor and devices"; clicked => { Studio.toggle-clip-devices(); } }
    IconButton { x: root.width - 63px; y: 39px; width: 25px; height: 25px; icon: Icons.piano; ink: #767678; tooltip: "Musical typing (not implemented)"; }
    IconButton { x: root.width - 36px; y: 39px; width: 25px; height: 25px; icon: Icons.gear; tooltip: "Settings (⌘,)";
        ink: Studio.settings-open ? #e5e5e8 : #767678; clicked => { Studio.toggle-settings(); } }
}

// ------------------------------------------------------------------ browser
// Section tabs, back/forward and the preview bar are PLACEHOLDERS (only the Devices section
// exists). Devices › Instruments / Effects list the scanned plugin catalogue (src/devices.rs);
// Devices › Chains is PLACEHOLDER data.
component Browser inherits Panel {
    // Section tabs (static: only "Devices" content exists)
    // 12 px weight 700, -0.04 em, 8 px apart from 12 px in; rest #63656d, active white.
    HorizontalLayout {
        x: 10.2px; y: 0; width: self.preferred-width; height: 27.2px; spacing: 6.8px;
        for t in ["Search", "Library", "Devices", "Files"]: Text {
            text: t; color: t == "Devices" ? #ffffff : #63656d;
            font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center;
        }
    }
    Icon { x: 218px; y: 6.5px; width: 13px; height: 13px; d: Icons.chevron-left; ink: Tokens.icon; }
    Icon { x: 234px; y: 6.5px; width: 13px; height: 13px; d: Icons.chevron-right; ink: Tokens.icon; }
    // Section separator (01/05/06: 0.5 pt at panel y 27).
    Rectangle { x: 0; y: 27px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    // Search field (real: filters the tree)
    Field {
        x: 8.5px; y: 34px; width: 235px; height: 20px; border-radius: 10px;
        Icon { x: 8px; width: 13px; height: 13px; d: Icons.search; ink: #b0b0b3; }
        if Studio.browser-search == "": Text { x: 27px; text: "Search devices"; color: #a5a5a8; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 27px; width: parent.width - 34px; height: parent.height;
            text: Studio.browser-search; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center;
            single-line: true;
            accessible-label: "Search devices";
            edited => { Studio.browser-search = self.text; Studio.browser-search-edited(self.text); }
            changed has-focus => { Studio.search-focused = self.has-focus; }
        }
    }
    // Sub-tabs (real): 11 px weight 600, -0.03 em, 12 px apart; rest #63656d, active white with
    // a 2 px underline.
    HorizontalLayout {
        x: 10.2px; y: 59px; width: self.preferred-width; height: 16.7px; spacing: 10.2px;
        for t[i] in ["Instruments", "Effects", "Chains"]: Rectangle {
            width: label.preferred-width;
            accessible-role: tab; accessible-label: t; accessible-checked: Studio.browser-tab == i;
            label := Text {
                x: 0; y: 0; height: 15px; text: t; color: Studio.browser-tab == i ? #ffffff : #63656d;
                font-size: 9.35px; font-weight: 600; letter-spacing: -0.28px; vertical-alignment: center;
            }
            if Studio.browser-tab == i: Rectangle { x: 0; y: 15px; width: parent.width; height: 1.7px; background: #ffffff; }
            TouchArea { clicked => { Studio.browser-tab-select(i); } }
        }
    }
    Rectangle { x: 0; y: 80px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // Tree (rows supplied by Rust; scrolls with the wheel).
    Rectangle {
        x: 0; y: 81px; width: root.width; height: root.height - 81px - 36px;
        clip: true;
        TouchArea { scroll-event(e) => { Studio.tree-scroll-by(e.delta-y / 1px); accept } }
        if Studio.tree.length == 0 && Studio.tree-empty != "": Text {
            x: 14px; y: 12px; width: parent.width - 28px; text: Studio.tree-empty; color: Tokens.text-tertiary; font-size: 9px; wrap: word-wrap;
        }
        for row[i] in Studio.tree: Rectangle {
            x: 0; y: 4px + i * 22px - Studio.tree-scroll; width: parent.width; height: 21px;
            property <length> indent: row.depth * 6.75px;
            accessible-role: list-item;
            accessible-label: row.label;
            if row.selected: Rectangle { x: 4px; width: parent.width - 8px; border-radius: 4px; background: #2a2b30; }
            for k in row.depth: Rectangle { x: 14px + k * 7px; y: -4px; width: 0.5px; height: 22px; background: Tokens.line-separator; }
            if row.expander != 0: Icon {
                x: 10px + parent.indent; width: 11px; height: 11px;
                d: row.expander == 2 ? Icons.chevron-down : Icons.chevron-right; ink: #a7a7aa;
            }
            Icon {
                x: 24px + parent.indent; width: 14.5px; height: 14.5px;
                d: row.icon == 1 ? Icons.keys : row.icon == 2 ? Icons.effect : Icons.folder; ink: #d0d0d3; stroke-width: 1.3px;
            }
            Text { x: 42.5px + parent.indent; width: parent.width - 42.5px - parent.indent - 44px; text: row.label; color: Tokens.text-primary; font-size: 9.5px; font-weight: 500; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - 60px; width: 52px; text: row.count; color: #8a8b8e; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
            TouchArea {
                clicked => { Studio.tree-click(i); }
                double-clicked => { Studio.tree-activate(i); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.tree-drag(i, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { Studio.tree-drag(i, 2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                }
                moved => { Studio.tree-drag(i, 1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
        }
    }
    // Preview bar (inert placeholder)
    Rectangle {
        x: 0; y: root.height - 33px; width: root.width; height: 33px; background: Tokens.bg-panel;
        Icon { x: 8px; y: 8.5px; width: 17px; height: 17px; d: Icons.wave; ink: #6a6b6f; }
        Icon { x: 42.5px; y: 9.5px; width: 13px; height: 14px; d: Icons.skip-back; ink: #55565c; stroke-width: 1.6px; }
        Icon { x: 56.5px; y: 9.5px; width: 13px; height: 14px; d: Icons.play; ink: #55565c; filled: true; }
        Icon { x: 71.5px; y: 9.5px; width: 13px; height: 14px; d: Icons.skip-fwd; ink: #55565c; stroke-width: 1.6px; }
        Inset { x: 94.5px; y: 13px; width: 62.5px; height: 7px; border-radius: 3.5px; bottom: #3f4044; }
        Rectangle { x: 142.5px; y: 13px; width: 7px; height: 7px; border-radius: 3.5px; background: Tokens.handle; }
        Rectangle { x: 164px; y: 11px; width: 11px; height: 11px; border-radius: 2px; background: #2f3032;
            Text { text: "S"; font-size: 5.5px; font-weight: 700; color: #acacad; horizontal-alignment: center; vertical-alignment: center; } }
        Rectangle { x: 179px; y: 11px; width: 15px; height: 11px; border-radius: 2px; background: #2f3032;
            Text { text: "1×"; font-size: 5.5px; font-weight: 700; color: #acacad; horizontal-alignment: center; vertical-alignment: center; } }
        Icon { x: 227px; y: 9.5px; width: 16px; height: 15px; d: Icons.link; ink: Tokens.text-tertiary; }
    }
}

// ------------------------------------------------------------------ timeline
// "Add track" row: 12 px plus (1.6 px stroke) and a 12 px bold label, 12 px from the left,
// white 40 % (70 % on hover).
component AddTrackButton inherits Rectangle {
    property <color> ink: ta.has-hover ? #ffffffb3 : #ffffff66;
    Path {
        x: 10.2px; y: (root.height - 10.2px) / 2; width: 10.2px; height: 10.2px;
        viewbox-width: 12; viewbox-height: 12;
        commands: "M6 1.75V10.25M1.75 6H10.25"; stroke: root.ink; stroke-width: 1.36px; stroke-line-cap: round;
    }
    Text { x: 25.5px; text: "Add track"; color: root.ink; font-size: 10.2px; font-weight: 700; letter-spacing: -0.408px; vertical-alignment: center; }
    ta := TouchArea { clicked => { Studio.add-track(); } }
}

component Timeline inherits Panel {
    callback focus-main();
    out property <length> lanes-width: lanes.width;
    out property <length> lanes-height: lanes.height;

    // ---- header row (y 0..27) ----
    // The reference app hides the zoom sliders once the header can no longer give the minimap its 140 px minimum
    // (research-findings S16); widths are the right group's measured widths in design units.
    property <bool> zoom-hidden: root.width - 200.6px - 10.2px - 206.3px - 175.4px < 119px;
    Text { x: 6.8px; y: 0; height: 27.2px; text: "Timeline"; color: Tokens.text-bright; font-size: 10.2px; font-weight: 700; letter-spacing: -0.41px; vertical-alignment: center; }
    // Returns: PLACEHOLDER (no return tracks yet). Master pill: shows the master row (static on).
    // Header-row x positions/widths below are the reference's AX boxes at 100 % zoom (ax-main-100.tsv).
    Pill { x: 60.35px; y: 5px; width: 59.5px; height: 18px; text: "Returns"; icon: Icons.returns; font-size: 8.75px; text-color: #a0a1a5; }
    Pill { x: 124.1px; y: 5px; width: 59.5px; height: 18px; text: "Master"; icon: Icons.master; active: true; font-size: 8.75px; }
    // Minimap: fills the space up to the right group (PLACEHOLDER: outline of the whole-song view window only)
    Rectangle {
        x: 200.6px; y: 5.1px; width: rgroup.x - 10.2px - self.x; height: 17px;
        border-radius: 4.25px; border-width: 0.85px; border-color: #767678;
    }
    rgroup := HorizontalLayout {
        x: root.width - self.width - 10.2px; y: 0; width: self.preferred-width; height: 27.2px;
        spacing: 3.4px;
        // Smart Fill: PLACEHOLDER
        Rectangle {
            width: 63.75px + 6.8px;
            Pill { x: 0; y: 5px; width: 63.75px; height: 18px; text: "Smart Fill"; icon: Icons.marquee; font-size: 8.25px; text-color: #a0a1a5; }
        }
        // Show/Hide automation lanes and Draw mode (B) (src/automation.rs).
        Rectangle {
            width: 11.05px + 6.8px;
            Icon {
                x: 0; y: 8.1px; width: 11.05px; height: 11.05px; d: Icons.automation; ink: Studio.auto-shown ? #e5e5e8 : #6b6c70;
                accessible-role: checkbox; accessible-label: Studio.auto-shown ? "Hide automation lanes" : "Show automation lanes"; accessible-checked: Studio.auto-shown;
                TouchArea { x: -3px; y: -2px; width: 20px; height: 18px; clicked => { Studio.auto-toggle-shown(); } }
            }
        }
        Rectangle {
            width: 11.05px + 6.8px;
            Icon {
                x: 0; y: 8.1px; width: 11.05px; height: 11.05px; d: Icons.pencil; ink: Studio.auto-draw ? #e5e5e8 : #6b6c70;
                accessible-role: checkbox; accessible-label: "Draw mode (B)"; accessible-checked: Studio.auto-draw;
                TouchArea { x: -3px; y: -2px; width: 19px; height: 18px; clicked => { Studio.auto-toggle-draw(); } }
            }
        }
        Rectangle {
            width: 25px + 1.7px;
            Icon { x: 0; y: 7px; width: 13px; height: 13px; d: Icons.cursor; ink: #e5e5e8; filled: true; }
            Icon { x: 14px; y: 8px; width: 11px; height: 11px; d: Icons.chevron-down; ink: #8e8f93; }
        }
        // vertical zoom (placeholder), horizontal zoom (mirrors the real zoom level)
        if !root.zoom-hidden: Rectangle {
            width: 172px;
            Icon { x: 0; y: 7px; width: 13px; height: 13px; d: Icons.v-resize; ink: #727377; }
            Rectangle { x: 18.4px; y: 13px; width: 68px; height: 2px; border-radius: 1px; background: #2f3036; }
            Rectangle { x: 18.4px; y: 13px; width: 8px; height: 2px; background: #e5e5e8; }
            Rectangle { x: 24.5px; y: 10px; width: 8px; height: 8px; border-radius: 4px; background: #f2f2f2; }
            Icon { x: 91.4px; y: 7px; width: 13px; height: 13px; d: Icons.h-resize; ink: #727377; }
            Rectangle { x: 110.2px; y: 13px; width: 68px; height: 2px; border-radius: 1px; background: #2f3036; }
            Rectangle { x: 110.2px; y: 13px; width: 8px; height: 2px; background: #e5e5e8; }
            Rectangle { x: 116px; y: 10px; width: 8px; height: 8px; border-radius: 4px; background: #f2f2f2; }
        }
        // Snap: beat snap is always on in milestone 1 ("Auto" label mirrors that)
        Rectangle {
            width: 44.2px;
            Text { x: 0; y: 7px; width: 28.9px; height: 14px; text: "Auto"; color: Tokens.text-bright; font-size: 9px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
            Icon { x: 32.3px; y: 8px; width: 11.9px; height: 11px; d: Icons.chevron-down; ink: #c9c9cc; }
        }
    }
    Rectangle { x: 0; y: 27px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // ---- lanes: wgpu texture (ruler + lanes + master lane) ----
    lanes := Rectangle {
        x: Tokens.lane-x; y: 27.5px; width: root.width - Tokens.lane-x; height: root.height - 27.5px;
        clip: true;
        Image { x: 0; y: 0; width: parent.width; height: parent.height; source: Studio.timeline-image; image-fit: fill; }
        for l in Studio.ruler-labels: Text {
            x: l.x + 4.5px; y: 0px; height: 11px; text: l.text; color: #bdbdbd; font-size: 7.75px; font-weight: 600; vertical-alignment: center;
        }
        Icon { x: 3px; y: 26.5px; width: 11px; height: 11px; d: Icons.plus; ink: Tokens.text-tertiary; }
        for c in Studio.clip-labels: Text {
            x: c.x + 5px; y: c.y; width: max(0px, c.w - 8px); height: 17px;
            text: c.text; color: Studio.auto-shown ? #191b24 : #15161a; font-size: 7.75px; font-weight: 500; vertical-alignment: center; overflow: elide;
        }
        // Automation value labels in the parameter's hue (dim while the lane has no points, grey while off).
        for l in Studio.auto-labels: Text {
            x: l.x; y: l.y + 0.75px; height: 13px; text: l.text; font-size: 9.25px; font-weight: 600; vertical-alignment: center;
            color: l.state == 1 ? l.accent : l.state == 2 ? #6a6b6f : l.dim;
        }
        TouchArea {
            mouse-cursor: Studio.lane-cursor == 1 ? MouseCursor.ew-resize : Studio.lane-cursor == 2 ? MouseCursor.move : MouseCursor.default;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    Studio.lane-pointer(0, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    Studio.lane-pointer(2, self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                }
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    Studio.lane-context(self.mouse-x, self.mouse-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => { Studio.lane-pointer(1, self.mouse-x, self.mouse-y, false, false, false); }
            changed mouse-x => { if (!self.pressed) { Studio.lane-hover(self.mouse-x, self.mouse-y); } }
            changed mouse-y => { if (!self.pressed) { Studio.lane-hover(self.mouse-x, self.mouse-y); } }
            scroll-event(e) => {
                Studio.lane-scroll(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x, e.modifiers.control || e.modifiers.alt);
                accept
            }
        }
    }

    // ---- track header column ----
    AddTrackButton { x: 0; y: 27.5px; width: 184px; height: 39px; }
    Rectangle { x: 0; y: 66px; width: Tokens.lane-x; height: 0.5px; background: Tokens.line-separator; }
    track-area := Rectangle {
        x: 0; y: 66.5px; width: Tokens.lane-x - 0.5px; height: root.height - 66.5px - Studio.master-h - 0.5px;
        clip: true;
        TouchArea {
            scroll-event(e) => { Studio.lane-scroll(0, e.delta-y / 1px, 0, false); accept }
        }
        for t[i] in Studio.tracks: Rectangle {
            x: 0; y: t.y - Studio.scroll-y; width: parent.width; height: t.h;
            TrackHeaderRow { x: 0; y: 0; width: parent.width; height: t.row-h; row-h: t.row-h; t: t; automation: Studio.auto-shown; level: Studio.track-levels[i]; edit-done => { root.focus-main(); } }
            Rectangle { y: t.row-h; height: Tokens.track-pitch - Tokens.track-h; background: t.selected ? #353639 : Tokens.line-separator; }
            // Height handle: 6 px at the row's bottom edge.
            TouchArea {
                y: t.row-h + 0.5px - 5.1px; height: 5.1px;
                mouse-cursor: row-resize;
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.track-resize(t.id, 0, self.absolute-position.y + self.mouse-y); }
                    if (e.kind == PointerEventKind.move && self.pressed) { Studio.track-resize(t.id, 1, self.absolute-position.y + self.mouse-y); }
                    if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) { Studio.track-resize(t.id, 2, self.absolute-position.y + self.mouse-y); }
                }
            }
        }
        // Expanded automation rows (src/automation.rs, EXTRA_H + separator): well fill, a 1 px
        // white 5 % top rule, and the pill 48 px in.
        for e in Studio.auto-extras: Rectangle {
            x: 0; y: e.y - Studio.scroll-y; width: parent.width; height: 40.5px;
            background: #17181b;
            Rectangle { height: 0.85px; background: #ffffff0d; }
            AutoPill {
                x: 40.8px; y: (40px - self.height) / 2; width: parent.width - 47.6px; cat: e.cat; param: e.param; state: e.state; accent: e.accent; chevron: false;
                power => { Studio.auto-power(e.track-id, e.index); }
                open(x, y) => { Studio.auto-show-extra(e.track-id, e.index); }
            }
            Rectangle { y: 40px; height: 0.5px; background: Tokens.line-separator; }
        }
        property <length> tracks-end: Studio.tracks-height - Studio.scroll-y;
        // Fills the column below the last track (at least one track high) and runs on under the
        // pinned master row, which covers it when space is short.
        AddTrackButton {
            x: 0; y: parent.tracks-end; width: parent.width;
            height: max(Tokens.track-pitch, parent.height + Studio.master-h + 0.5px - parent.tracks-end);
        }
    }
    Rectangle { x: Tokens.lane-x - 0.5px; y: 27.5px; width: 0.5px; height: root.height - 27.5px; background: Tokens.line-separator; }

    // ---- master row (36 px; 76 px with the automation row) ----
    Rectangle { x: 0; y: root.height - Studio.master-h - 0.5px; width: Tokens.lane-x - 0.5px; height: 0.5px; background: Tokens.line-separator; }
    MasterHeaderRow {
        edit-done => { root.focus-main(); }
        x: 0; y: root.height - Studio.master-h; width: Tokens.lane-x - 0.5px; height: Studio.master-h;
        automation: Studio.auto-shown; volume-pos: Studio.master-pos; vol-auto: Studio.master-vol-auto;
        level: Studio.master-level; auto-state: Studio.master-auto-state;
    }
}

// ------------------------------------------------------------------ bottom panel
component Inspector inherits Rectangle {
    // Readouts are the track colour pulled toward grey (the reference: #c670f7 track -> #a66bca text,
    // #72b6d7 -> #77a6bd, #8092eb -> #7b87c3; this mix reproduces all three within a few levels).
    property <color> value-color: Studio.sel-color.mix(#7d7e80, 0.62);
    // inspector header
    // Colour tab flush with the panel edge: 4 x 19 pt at y 6.5 pt (100 % zoom).
    Rectangle { x: 0px; y: 5.5px; width: 3.4px; height: 16.15px; border-radius: 1.7px; background: Studio.sel-color; }
    Text { visible: Studio.has-selection; x: 10.5px; y: 7px; height: 13px; text: Studio.sel-number; color: Tokens.text-bright; font-size: 9px; font-weight: 700; vertical-alignment: center; }
    Icon { visible: Studio.has-selection; x: 21px; y: 8px; width: 11px; height: 11px; d: Studio.sel-instrument ? Icons.keys : Icons.wave; ink: #a8a8ab; stroke-width: 1.1px; }
    Label { x: 37px; y: 7px; text: Studio.has-selection ? Studio.sel-name : "No track selected"; color: Tokens.text-bright; font-size: 10px; }

    // In: audio tracks open the input selector (SetTrackInput; popup drawn by AppWindow). Instrument
    // tracks open the instrument selector (built-in Synth or an instrument plugin: SetInstrumentPlugin).
    // Out: PLACEHOLDER (fixed routing to Master).
    Raised {
        x: 10px; y: 37px; width: 149px; height: 19px; border-radius: 9.5px;
        Text { x: 7.5px; text: Studio.sel-instrument ? "Inst" : "In"; color: Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
        Text { x: Studio.sel-instrument ? 29.5px : 21px; width: 134px - self.x - 4px; text: Studio.sel-instrument ? Studio.sel-inst-text : Studio.sel-input-text; color: Tokens.text-bright; font-size: 9.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Icon { x: 134px; width: 10px; height: 10px; d: Icons.chevron-down; ink: #a0a0a3; }
        accessible-role: combobox; accessible-label: Studio.sel-instrument ? "Inst" : "In"; accessible-value: Studio.sel-instrument ? Studio.sel-inst-text : Studio.sel-input-text;
        TouchArea { clicked => { if (Studio.sel-instrument) { Studio.open-inst-menu(parent.absolute-position.x + 1px, parent.absolute-position.y + parent.height + 3px); } else if (Studio.has-selection) { Studio.open-input-menu(); } } }
    }
    Raised {
        x: 10px; y: 63px; width: 149px; height: 18px; border-radius: 9px;
        Text { x: 7.5px; text: "Out"; color: Tokens.text-tertiary; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
        Text { x: 29.5px; text: "Master"; color: Tokens.text-bright; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
        Icon { x: 134px; width: 10px; height: 10px; d: Icons.chevron-down; ink: #a0a0a3; }
    }
    // Input / Sends tabs: 24 pt row, 12 pt bold, centred 24 pt apart; the Sends tab adds a "+"
    // (add a send) after its label. View state only.
    property <int> tab: 0;
    for t[i] in [ {label: "Input", x: 56}, {label: "Sends", x: 108} ]: Text {
        x: t.x * StripMetrics.u; y: 104 * StripMetrics.u; height: 24 * StripMetrics.u;
        text: t.label; font-size: 12 * StripMetrics.u; font-weight: 700; letter-spacing: -0.48 * StripMetrics.u; vertical-alignment: center;
        color: root.tab == i ? #ffffff : tab-ta.has-hover ? #ffffffb3 : #63656d;
        tab-ta := TouchArea { clicked => { root.tab = i; } }
    }
    if root.tab == 1: Rectangle {
        x: 146 * StripMetrics.u; y: 108 * StripMetrics.u; width: 16 * StripMetrics.u; height: 16 * StripMetrics.u;
        Icon { x: 3 * StripMetrics.u; y: 3 * StripMetrics.u; width: 10 * StripMetrics.u; height: 10 * StripMetrics.u; d: Icons.plus; ink: send-add.has-hover ? #ffffffb3 : #63656d; stroke-width: 1.4px; }
        send-add := TouchArea { clicked => { Studio.chat-placeholder("Add send"); } }
    }
    Rectangle { x: 10px; y: 128 * StripMetrics.u - 0.5px; width: 150px; height: 0.5px; background: #ffffff14; }

    if root.tab == 0: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        // Trim / Width: PLACEHOLDERS (no per-track trim/width in the model). Pan: real.
        Knob { x: 28px; y: 122px; width: 38px; height: 38px; body: 20.5px; groove: true; value-angle: 0; tick-color: #ffffff; arc-color: root.value-color; }
        Text { x: 10px; y: 158px; width: 74px; height: 13px; text: "0.0 dB"; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 10px; y: 173px; width: 74px; height: 14px; text: "Trim"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Knob { x: 104px; y: 122px; width: 38px; height: 38px; body: 20.5px; groove: true; value-angle: 0; show-arc: true; arc-from: -135; tick-color: #ffffff; arc-color: root.value-color; }
        Text { x: 86px; y: 158px; width: 74px; height: 13px; text: "100%"; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 86px; y: 173px; width: 74px; height: 14px; text: "Width"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Knob {
            x: 28px; y: 191px; width: 38px; height: 38px; body: 20.5px; groove: true; arc-color: root.value-color;
            value: Studio.sel-pan; value-angle: Studio.sel-pan * 135; tick-color: Studio.sel-pan-auto ? #65bce3 : #ffffff;
            value-changed(v) => { if (Studio.has-selection) { Studio.track-pan(Studio.sel-id, v); } }
            released => { Studio.gesture-end(); }
            reset => { if (Studio.has-selection) { Studio.track-pan(Studio.sel-id, 0); Studio.gesture-end(); } }
        }
        Text { x: 10px; y: 228px; width: 74px; height: 13px; text: Studio.sel-pan-text; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 10px; y: 243px; width: 74px; height: 13px; text: "Pan"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        // Mono fold: PLACEHOLDER
        Switch { x: 112.5px; y: 205px; on: false; }
        Text { x: 86px; y: 228px; width: 74px; height: 13px; text: "Off"; color: root.value-color; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 86px; y: 243px; width: 74px; height: 13px; text: "Mono"; color: Tokens.text-primary; font-size: 9.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }

    // M / S / R / I (R / I: SetTrackArm / SetTrackMonitor on audio tracks; PLACEHOLDERS on
    // instrument tracks). 22 x 20 pt, 4 pt apart, on the peak box's row.
    for b[i] in [ {t: "M", on: Studio.sel-mute}, {t: "S", on: Studio.sel-solo}, {t: "R", on: Studio.sel-arm}, {t: "I", on: Studio.sel-monitor} ]: StripButton {
        x: (50 + i * 26) * StripMetrics.u; y: 324 * StripMetrics.u; big: true; text: b.t; kind: i; on: b.on;
        clicked => {
            if (i == 0) { Studio.track-mute(Studio.sel-id); }
            if (i == 1) { Studio.track-solo(Studio.sel-id); }
            if (i == 2) { Studio.track-arm(Studio.sel-id); }
            if (i == 3) { Studio.track-monitor(Studio.sel-id); }
        }
    }

    // Meter column (92 pt at x 196): gain readout, fader canvas, peak box (6 pt gaps).
    StripReadout { x: 218 * StripMetrics.u; y: 44.5 * StripMetrics.u; width: 70 * StripMetrics.u; height: 20 * StripMetrics.u; text: Studio.sel-db-text; }
    StripCanvas {
        x: 196 * StripMetrics.u; y: 70.5 * StripMetrics.u; height: 248 * StripMetrics.u;
        enabled: Studio.has-selection;
        fader: Studio.sel-fader; meter-l: Studio.sel-meter-l; meter-r: Studio.sel-meter-r;
        fill: Studio.sel-vol-auto ? #ebc542 : Studio.sel-color;
        cap: Studio.sel-vol-auto ? #e9d38e : #fdf8f0;
        moved(f) => { Studio.sel-fader-moved(f); }
        released => { Studio.gesture-end(); }
        reset => { Studio.sel-fader-moved(0.2); Studio.gesture-end(); }
    }
    StripReadout {
        x: 218 * StripMetrics.u; y: 324.5 * StripMetrics.u; width: 70 * StripMetrics.u; height: 20 * StripMetrics.u;
        text: Studio.sel-peak-text; ink: Studio.sel-peak-text == "−∞" ? #ffffff4d : #ffffff99;
    }
}

component BottomPanel inherits Panel {
    if Studio.bottom-tab == 0: Inspector { x: 0; y: 0; width: 254.5px; height: root.height; }
    if Studio.bottom-tab == 1: ClipSidebar { x: 0; y: 0; width: 254.5px; height: root.height; }
    Rectangle { x: 254.5px; y: 0; width: 0.5px; height: root.height; background: Tokens.line-separator; }
    Rectangle { x: 0; y: 26.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }
    // Clip / Devices tabs (real: switch the bottom panel content)
    Label {
        x: 261px; y: 7px; text: "Clip";
        color: Studio.bottom-tab == 1 ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: Studio.bottom-tab == 1 ? 600 : 500;
        TouchArea { clicked => { Studio.set-bottom-tab(1); } }
    }
    Label {
        x: 286px; y: 7px; text: "Devices";
        color: Studio.bottom-tab == 0 ? Tokens.text-bright : Tokens.text-tertiary; font-size: 10px; font-weight: Studio.bottom-tab == 0 ? 600 : 500;
        TouchArea { clicked => { Studio.set-bottom-tab(0); } }
    }
    if Studio.bottom-tab == 1 && Studio.pr-visible: PianoRoll { x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px; }
    if Studio.bottom-tab == 1 && !Studio.pr-visible: ClipEmpty { x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px; }
    IconButton { x: root.width - 53px; y: 3px; width: 21px; height: 21px; icon: Icons.panel-bottom; ink: #6b6c70; icon-size: 14px; }
    IconButton { x: root.width - 29px; y: 3px; width: 21px; height: 21px; icon: Icons.download; ink: #6b6c70; icon-size: 14px; }
    // Device chain (Devices tab): built-in Synth card (instrument tracks without an instrument
    // plugin; src/synth.rs), plugin cards (src/devices.rs), then "Add device". Positions come
    // from Rust (bottom-panel relative, scroll included); the area clips at the inspector edge.
    if Studio.bottom-tab == 0: Rectangle {
        x: 255px; y: 27px; width: root.width - 255px; height: root.height - 27px;
        clip: true;
        TouchArea {
            scroll-event(e) => { Studio.chain-scroll-by(e.delta-x != 0 ? e.delta-x / 1px : e.delta-y / 1px); accept }
        }
        if Studio.synth-visible: SynthDevice { x: 263.5px - 255px - Studio.chain-scroll; y: 34px - 27px; }
        // Chain heads frame their members; an empty chain offers "Add effect".
        for f in Studio.chain-frames: Rectangle {
            x: f.x - 255px; y: 34px - 27px - 5px; width: f.w; height: 265px + 10px; border-radius: 9px;
            background: #1b1c20; border-width: f.armed ? 1px : 0.5px; border-color: f.armed ? f.color : #3a3b40;
        }
        for f in Studio.chain-frames: Rectangle {
            visible: f.empty;
            x: f.empty-x - 255px; y: 34px - 27px; width: 182.5px; height: 265px; border-radius: 6px;
            background: empty-ta.has-hover ? #222328 : #1f2024; border-width: 0.5px; border-color: #313236;
            accessible-role: button; accessible-label: "Add effect";
            HorizontalLayout {
                alignment: center; spacing: 6px;
                Icon { y: (265px - 12px) / 2; width: 12px; height: 12px; d: Icons.plus; ink: #c5c5c8; stroke-width: 1.4px; }
                Text { text: "Add effect"; color: #c5c5c8; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            }
            empty-ta := TouchArea { enabled: f.empty; clicked => { Studio.chain-add-effect(f.head, self.absolute-position.x + 20px, self.absolute-position.y + 120px); } }
        }
        for card in Studio.device-cards: Rectangle {
            x: card.x - 255px; y: 34px - 27px; width: card.width; height: 265px;
            if !card.builtin: PluginCard { x: 0; y: 0; card: card; }
            if card.builtin: BuiltinCard { x: 0; y: 0; card: card; }
        }
        AddDeviceCard { x: Studio.add-device-x - 255px; y: 34.5px - 27px; }
        if Studio.chain-marker-visible: Rectangle { x: Studio.chain-marker-x - 255px - 1px; y: 34px - 27px; width: 2px; height: 265px; border-radius: 1px; background: Tokens.accent; }
    }
}

// Automation parameter popup: search field + category rows (or search results).
component AutoPicker inherits Rectangle {
    callback done();
    border-radius: 7px; background: #212227; border-width: 0.5px; border-color: #46474b;
    drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;
    TouchArea { }
    Rectangle {
        x: 7.5px; y: 5.5px; width: parent.width - 15px; height: 20.5px; border-radius: 10.25px;
        background: #292a2f; border-width: 0.5px; border-color: #35363a;
        Icon { x: 6.5px; y: 4.5px; width: 12px; height: 12px; d: Icons.search; ink: #a6a8ac; stroke-width: 1.5px; }
        if Studio.picker-query == "": Text { x: 24px; height: parent.height; text: "Search parameters…"; color: #a6a8ac; font-size: 9px; vertical-alignment: center; }
        TextInput {
            x: 23.5px; width: parent.width - 30px; height: parent.height;
            text: Studio.picker-query; color: Tokens.text-primary; font-size: 9px; vertical-alignment: center; single-line: true;
            accessible-label: "Search parameters";
            init => { self.focus(); }
            edited => { Studio.picker-query = self.text; Studio.picker-edited(self.text); }
            changed has-focus => { Studio.picker-focused = self.has-focus; }
            accepted => { Studio.picker-pick(0); root.done(); }
        }
    }
    for it[i] in Studio.picker-items: Rectangle {
        x: 4px; y: it.y; width: parent.width - 8px; height: 21px; border-radius: 4px;
        background: ta.has-hover && it.enabled ? #2c2d32 : transparent;
        accessible-role: list-item; accessible-label: it.label;
        Text { x: 7px; width: parent.width - 30px; height: parent.height; text: it.label; color: it.enabled ? #d3d3d4 : #6a6b6f; font-size: 9.5px; font-weight: 500; vertical-alignment: center; overflow: elide; }
        if it.submenu: Icon { x: parent.width - 19px; y: 5.5px; width: 10px; height: 10px; d: Icons.chevron-right; ink: #8c8c8f; stroke-width: 1.5px; }
        if it.shortcut != "": Text { x: parent.width - 20px; width: 14px; height: parent.height; text: it.shortcut; color: #c9a83d; font-size: 9px; vertical-alignment: center; }
        ta := TouchArea { clicked => { if (it.enabled) { if (Studio.picker-query != "") { root.done(); } Studio.picker-pick(i); } } }
    }
}

// ------------------------------------------------------------------ window
export component AppWindow inherits Window {
    title: Studio.project-name + " — Saine Studio";
    preferred-width: 1440px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 600px;
    background: Tokens.bg-window;
    default-font-size: 9.5px;
    default-font-family: Tokens.font-ui;

    out property <length> lanes-width: timeline.lanes-width;
    out property <length> lanes-height: timeline.lanes-height;
    // Panel geometry (mirrored in src/highlight.rs `Layout`).
    property <length> bottom-h: Studio.bottom-h;
    // Top row y 78.2 / browser width 252.45 / timeline x 262.65: the reference's 92 pt, 297 pt and
    // 309 pt at its default (100 %) zoom, in our 85 % units (AX dump, reference/data/ax-main-100.tsv).
    property <length> top-h: root.height - 88.4px - self.bottom-h;
    property <length> right-w: Studio.assistant-open ? 257.5px : 0px;

    property <int> cards-epoch: Studio.cards-epoch;
    changed cards-epoch => { fs.focus(); }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { self.focus(); }
            if (Studio.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta)) { return accept; }
            reject
        }
        Header { x: 0; y: 0; width: root.width; height: 73px; }
        if Studio.sounds-visible: Browser { x: 5px; y: 78.2px; width: 252.45px; height: root.top-h; }
        timeline := Timeline {
            focus-main => { fs.focus(); }
            x: Studio.sounds-visible ? 262.65px : 5px; y: 78.2px;
            width: root.width - self.x - 5px - root.right-w; height: root.top-h;
        }
        // Assistant panel: right-docked beside the timeline (nothing overlaps).
        if Studio.assistant-open: AssistantPanel {
            x: root.width - 5px - 252.5px; y: 78.2px; width: 252.5px; height: root.top-h;
            focus-main => { fs.focus(); }
        }
        // Bottom panel: inspector + devices, or the mixer (taller; the row above shrinks).
        if !Studio.mixer-open: BottomPanel { x: 5px; y: root.height - 5px - root.bottom-h; width: root.width - 10px; height: root.bottom-h; }
        if Studio.mixer-open: MixerPanel { x: 5px; y: root.height - 5px - root.bottom-h; width: root.width - 10px; height: root.bottom-h; }
        // Timeline / bottom-panel splitter: an invisible 14 px strip across the gap, 8 px of it
        // above the panel's top edge (the reference's resize handle).
        TouchArea {
            x: 5px; y: root.height - 5px - root.bottom-h - 6.8px; width: root.width - 10px; height: 11.9px;
            mouse-cursor: row-resize;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { Studio.bottom-resize(0, self.absolute-position.y + self.mouse-y); }
                if (e.kind == PointerEventKind.move && self.pressed) { Studio.bottom-resize(1, self.absolute-position.y + self.mouse-y); }
                if ((e.button == PointerEventButton.left && e.kind == PointerEventKind.up) || e.kind == PointerEventKind.cancel) { Studio.bottom-resize(2, self.absolute-position.y + self.mouse-y); }
            }
        }
        HighlightOverlay { x: 0; y: 0; width: root.width; height: root.height; }
        // Device windows: a built-in card opened from its header arrow floats above the
        // arrangement (the card stays in the chain too) and stays up across track changes;
        // its title strip moves it, the arrow or the strip's x closes it.
        for card[i] in Studio.device-window-cards: win := Rectangle {
            property <length> dx: card.win-dx;
            property <length> dy: card.win-dy;
            x: max(0px, min(root.width - self.width, (root.width - card.width) / 2 + i * 16px + self.dx));
            y: max(0px, min(root.height - 22px, 120px + i * 16px + self.dy));
            width: card.width + 8px; height: 265px + 26px;
            border-radius: 8px; background: #1a1b1e; border-width: 0.5px; border-color: #ffffff1f;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: #00000099;
            Rectangle {
                TouchArea {
                    mouse-cursor: MouseCursor.move;
                    moved => { win.dx += self.mouse-x - self.pressed-x; win.dy += self.mouse-y - self.pressed-y; }
                    pointer-event(e) => { if (e.kind == PointerEventKind.up) { Studio.device-window-moved(card.id, win.x - (root.width - card.width) / 2 - i * 16px, win.y - 120px - i * 16px); } }
                }
                Text { x: 10px; y: 0; height: 22px; text: card.name; color: #81838a; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    x: parent.width - 21px; y: 3px; width: 16px; height: 16px; border-radius: 4px;
                    background: close-ta.has-hover ? #ffffff14 : transparent;
                    accessible-role: button; accessible-label: "Close device window";
                    Icon { x: 3px; y: 3px; width: 10px; height: 10px; d: Icons.close; ink: close-ta.has-hover ? #ffffff : #81838a; stroke-width: 1.04px; }
                    close-ta := TouchArea { clicked => { Studio.device-window(card.id); } }
                }
                BuiltinCard { x: 4px; y: 22px; card: card; }
            }
        }
        // Clip context menu (click outside dismisses).
        if Studio.menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.menu-dismiss(); } } }
            ContextMenu { x: Studio.menu-x; y: Studio.menu-y; height: Studio.menu-h; items: Studio.menu-items; activated(i) => { Studio.menu-activate(i); } }
            if Studio.sub-open: ContextMenu {
                x: Studio.menu-x + 209px - 4px; y: Studio.menu-y + Studio.sub-y; height: Studio.sub-h;
                items: Studio.sub-items; activated(i) => { Studio.sub-activate(i); }
            }
        }
        // Synth dropdown / preset list (click outside dismisses).
        if Studio.synth-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.synth-menu-dismiss(); } } }
            SynthMenuList {
                x: min(Studio.synth-menu-x, root.width - 5px - Studio.synth-menu-w);
                y: max(5px, min(Studio.synth-menu-y, root.height - 5px - Studio.synth-menu-h));
                width: Studio.synth-menu-w; height: min(Studio.synth-menu-h, root.height - 10px);
                content-h: Studio.synth-menu-h;
                items: Studio.synth-menu-items;
                picked(i) => { Studio.synth-menu-pick(i); }
            }
        }
        // Inspector "In" selector (audio tracks): below the In field (bottom panel y + 59, x 5 + 11).
        if Studio.input-menu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.input-menu-dismiss(); } } }
            ChoiceList {
                x: 16px; y: root.height - 5px - root.bottom-h + 59px;
                width: Studio.input-menu-w; height: Studio.input-menu-h;
                items: Studio.input-menu-items;
                picked(i) => { Studio.input-menu-pick(i); }
            }
        }
        // Device popup list: Add device submenus, instrument selector (click outside dismisses).
        if Studio.devmenu-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.devmenu-dismiss(); } } }
            DevMenuList {
                x: max(5px, min(Studio.devmenu-x, root.width - 5px - Studio.devmenu-w));
                y: max(5px, min(Studio.devmenu-y, root.height - 5px - Studio.devmenu-h));
                width: Studio.devmenu-w; height: Studio.devmenu-h; content-h: Studio.devmenu-content-h;
                items: Studio.devmenu-items;
                picked(i) => { Studio.devmenu-pick(i); }
            }
        }
        // Browser device drag: drop target outline + ghost label at the pointer.
        if Studio.dnd-active && Studio.dnd-target-visible: Rectangle {
            x: Studio.dnd-tx; y: Studio.dnd-ty; width: Studio.dnd-tw; height: Studio.dnd-th; border-radius: 4px;
            background: #2752f522; border-width: 1.5px; border-color: Tokens.accent;
        }
        if Studio.dnd-active: Rectangle {
            x: Studio.dnd-x + 10px; y: Studio.dnd-y + 6px; height: 20px; width: ghost.preferred-width + 18px; border-radius: 10px;
            background: Studio.dnd-ok ? Tokens.accent : #3a3b40;
            ghost := Text { text: Studio.dnd-label; color: #ffffff; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
        // Automation parameter picker (61-automation-param-menu.png: 188 pt wide, search field, 21 pt rows).
        if Studio.picker-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down) { Studio.picker-dismiss(); fs.focus(); } } }
            AutoPicker {
                x: max(5px, min(Studio.picker-x, root.width - 5px - 188px));
                y: max(5px, min(Studio.picker-y, root.height - 5px - Studio.picker-h));
                width: 188px; height: Studio.picker-h;
                done => { fs.focus(); }
            }
            if Studio.picker-sub-open: DevMenuList {
                x: min(Studio.picker-x + 190px, root.width - 5px - 188px);
                y: max(5px, min(Studio.picker-y + Studio.picker-sub-y, root.height - 5px - Studio.picker-sub-h));
                width: 188px; height: min(Studio.picker-sub-h, root.height - 10px); content-h: Studio.picker-sub-h;
                items: Studio.picker-sub-items;
                picked(i) => { Studio.picker-sub-pick(i); fs.focus(); }
            }
        }
        // Rename clip popup.
        if Studio.rename-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height; background: #00000040;
            TouchArea { clicked => { Studio.rename-cancel(); fs.focus(); } }
            Rectangle {
                x: (root.width - 260px) / 2; y: 220px; width: 260px; height: 66px; border-radius: 8px;
                background: Tokens.bg-raised; border-width: 0.5px; border-color: #3a3b40;
                TouchArea { }
                Text { x: 12px; y: 8px; height: 14px; text: "Rename clip"; color: Tokens.text-bright; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Rectangle {
                    x: 12px; y: 30px; width: parent.width - 24px; height: 24px; border-radius: 5px; background: Tokens.bg-input;
                    border-width: 0.5px; border-color: Tokens.accent;
                    rename-input := TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        text: Studio.rename-text; color: Tokens.text-primary; font-size: 10px; vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); self.select-all(); }
                        edited => { Studio.rename-text = self.text; }
                        accepted => { Studio.rename-commit(self.text); fs.focus(); }
                    }
                }
            }
        }
        // Settings window (in-app modal panel at the reference window rect; outside click closes).
        if Studio.settings-open: Rectangle {
            x: 0; y: 0; width: root.width; height: root.height;
            TouchArea { clicked => { Studio.close-settings(); fs.focus(); } }
            SettingsPanel { x: max(0px, min(255px, root.width - 960px)); y: 7px; width: min(960px, root.width); height: root.height - 7px + 12px; }
        }
        // Status line (engine/device/import messages); empty most of the time.
        if Studio.status-text != "": Rectangle {
            x: root.width - self.width - 14px; y: root.height - 34px; height: 20px;
            width: status.preferred-width + 20px; border-radius: 10px; background: #2a2b30ee;
            status := Text { text: Studio.status-text; color: #e5e5e8; font-size: 8.75px; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
}
