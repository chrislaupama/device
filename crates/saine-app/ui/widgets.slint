// Fully rounded pill button (Returns, Master, Smart Fill, Report a bug).
export component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> active: false;
    in property <length> font-size: 12px;
    in property <color> text-color: active ? Tokens.on-accent : #c9c9cc;
    callback clicked;
    border-radius: self.height / 2;
    background: active ? Tokens.accent : Tokens.bg-control;
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        if root.icon != "": Rectangle {
            width: 12px;
            Icon { d: root.icon; width: 12px; height: 12px; color: root.text-color; }
        }
        Text { text: root.text; color: root.text-color; font-size: root.font-size; font-weight: 500; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Square icon toggle/button.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> color: Tokens.icon;
    in property <length> icon-size: 16px;
    in property <bool> filled: false;
    in property <string> tooltip;
    callback clicked;
    accessible-role: button;
    accessible-label: tooltip;
    Icon { d: root.icon; width: root.icon-size; height: root.icon-size; color: ta.has-hover ? Tokens.text-primary : root.color; filled: root.filled; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Tiny M/S/R/I button (11x11 in track headers, 19x18 in the inspector).
export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> on: false;
    in property <color> on-color: Tokens.text-bright;
    in property <length> font-size: 7.5px;
    callback clicked;
    border-radius: 2px;
    background: on ? on-color : Tokens.small-button;
    Text { text: root.text; color: root.on ? #18191c : #a9a9ac; font-size: root.font-size; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// Horizontal volume slider: groove + white handle. `pos` is 0..1, mapping done in Rust.
export component HSlider inherits Rectangle {
    in property <float> pos;
    in property <length> handle-size: 7px;
    callback moved(float);
    callback released();
    callback reset();
    property <length> travel: self.width - self.handle-size;
    groove := Rectangle {
        height: root.height;
        border-radius: self.height / 2;
        background: Tokens.bg-slider-track;
        border-width: 0.5px;
        border-color: #2d2e31;
    }
    Rectangle {
        x: root.pos * root.travel;
        width: root.handle-size;
        height: root.handle-size;
        border-radius: self.width / 2;
        background: Tokens.handle;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.moved(max(0, min(1, (self.mouse-x - root.handle-size / 2) / root.travel)));
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { root.moved(max(0, min(1, (self.mouse-x - root.handle-size / 2) / root.travel))); }
        double-clicked => { root.reset(); }
    }
}

// Rotary knob: dark body, value tick, optional value arc. Angles in degrees, 0 = up, clockwise.
export component Knob inherits Rectangle {
    in property <float> value-angle: 0;
    in property <bool> show-arc: false;
    in property <float> arc-from: -135;
    in property <length> body: 17px;
    in property <color> tick-color: #b9d3e4;
    in property <float> value;      // current value forwarded to drags
    in property <float> min-value: -1;
    in property <float> max-value: 1;
    in property <float> sensitivity: 150; // px for the full range
    callback changed(float);
    callback released();
    callback reset();
    property <float> start-value;
    property <float> cx: self.width / 1px / 2;
    property <float> cy: self.height / 1px / 2;
    property <float> r: self.body / 1px / 2;
    // soft outer ring
    Rectangle {
        width: root.body + 6px; height: root.body + 6px;
        border-radius: self.width / 2;
        background: #1c1d20;
    }
    Rectangle {
        width: root.body; height: root.body;
        border-radius: self.width / 2;
        background: @linear-gradient(180deg, #202125 0%, Tokens.bg-knob 100%);
        border-width: 0.5px;
        border-color: #2e2f33;
    }
    if root.show-arc: Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: Tokens.value-blue;
        stroke-width: 1.5px;
        fill: transparent;
        MoveTo {
            x: root.cx + (root.r + 2.5) * sin(root.arc-from * 1deg);
            y: root.cy - (root.r + 2.5) * cos(root.arc-from * 1deg);
        }
        ArcTo {
            x: root.cx + (root.r + 2.5) * sin(root.value-angle * 1deg);
            y: root.cy - (root.r + 2.5) * cos(root.value-angle * 1deg);
            radius-x: root.r + 2.5;
            radius-y: root.r + 2.5;
            large-arc: abs(root.value-angle - root.arc-from) > 180;
            sweep: root.value-angle > root.arc-from;
        }
    }
    Path {
        width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.tick-color;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        MoveTo { x: root.cx + root.r * 0.45 * sin(root.value-angle * 1deg); y: root.cy - root.r * 0.45 * cos(root.value-angle * 1deg); }
        LineTo { x: root.cx + root.r * 0.95 * sin(root.value-angle * 1deg); y: root.cy - root.r * 0.95 * cos(root.value-angle * 1deg); }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.start-value = root.value; }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => {
            root.changed(max(root.min-value, min(root.max-value,
                root.start-value + (self.pressed-y - self.mouse-y) / 1px / root.sensitivity * (root.max-value - root.min-value))));
        }
        double-clicked => { root.reset(); }
    }
}

// On/off switch (Mono "Fold to mono").
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 20px; height: 11px;
    border-radius: self.height / 2;
    background: on ? Tokens.value-blue : #3a3b40;
    Rectangle {
        x: root.on ? root.width - self.width - 1px : 1px;
        width: 9px; height: 9px; border-radius: 4.5px;
        background: #ffffff;
    }
    TouchArea { clicked => { root.toggled(); } }
}

// A text label positioned at an AX rect (x, y, height) with vertical centring.
export component Label inherits Text {
    color: Tokens.text-primary;
    font-size: 12.5px;
    font-weight: 600;
    vertical-alignment: center;
    height: 13px;
}
