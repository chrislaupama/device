// Reusable widgets for the Saine Studio shell.
// All icons are ORIGINAL simple vector drawings (16x16 viewbox), not reference assets.
import { Tokens } from "tokens.slint";

// Rounded panel with the 0.5 pt top highlight observed in the reference.
export component Panel inherits Rectangle {
    background: Tokens.bg-panel;
    border-radius: Tokens.panel-radius;
    border-width: 0.5px;
    border-color: @linear-gradient(180deg, Tokens.panel-edge-top 0%, Tokens.panel-edge-bottom 100%);
    clip: true;
}

// Stroked line icon. `d` is an SVG path in a 16x16 box.
export component Icon inherits Path {
    in property <string> d;
    in property <color> color: Tokens.icon;
    in property <bool> filled: false;
    width: 16px;
    height: 16px;
    commands: d;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: filled ? transparent : color;
    fill: filled ? color : transparent;
    stroke-width: 1.3px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

