// Mixer panel: replaces the bottom panel when "Toggle mixer panel" is on.
// Geometry: reference/ui-inventory.md §5 and §10 (11-mixer.png, ax-mixer.tsv).
// Panel-relative y = window y - 425; strip-relative x = window x - strip x.
// Every value comes from Rust (Studio.strips / strip-meters / master-*); every
// edit goes out through the same Studio callbacks as the track headers.
import { Tokens } from "tokens.slint";
import { Panel, Icon, Icons, IconButton, SmallButton, Knob, Raised } from "widgets.slint";
import { Studio, MixerStrip, StripMeter } from "studio.slint";

// Fader slot 12x163 with a track-colour fill and a white handle. 0 dB ... -inf
// mapping is done in Rust (`fader_from_db`); travel 143 pt, handle centre at 10.5 + f*143.
component StripFader inherits Rectangle {
    in property <float> fader;
    in property <color> fill;
    callback moved(float);
    callback released();
    width: 12px;
    height: 163px;
    border-radius: 6px;
    // Inset slot (see Inset in widgets.slint): dark top lip, short inner shadow, light bottom lip.
    background: #262628;
    Rectangle { width: parent.width; height: parent.height - 1px; border-radius: 6px; background: #0a0a0b; }
    Rectangle { y: 1px; width: parent.width; height: parent.height - 2px; border-radius: 6px; background: #0f1012; }
    Rectangle { y: 2px; width: parent.width; height: parent.height - 3px; border-radius: 6px; background: #121315; }
    Rectangle {
        x: 4.25px; y: min(parent.height - 3px, 10.5px + root.fader * 143px);
        width: 3.5px; height: max(0px, parent.height - 3px - self.y);
        border-radius: 1.75px; background: root.fill;
    }
    Rectangle {
        x: 1.75px; y: root.fader * 143px + 0.5px; width: 8.5px; height: 20px; border-radius: 3px;
        background: #f6f3ee;
        drop-shadow-blur: 2px; drop-shadow-color: #000000b3;
        Rectangle { x: 1.5px; width: parent.width - 3px; height: 0.75px; background: #8a8a8d; }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.moved(max(0, min(1, (self.mouse-y - 10.5px) / 143px)));
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { root.moved(max(0, min(1, (self.mouse-y - 10.5px) / 143px))); }
    }
}

component MeterBar inherits Rectangle {
    in property <float> level; // 0 (top) .. 1 (silent)
    width: 3.5px;
    height: 157.5px;
    border-radius: 1px;
    background: #161619;
    Rectangle { y: 0; height: 2px; background: #2d2d31; }
    Rectangle {
        y: root.level * parent.height; height: parent.height - self.y; width: parent.width;
        background: @linear-gradient(0deg, Tokens.meter-green 0%, Tokens.meter-green 70%, #e3c53a 88%, #e5484d 100%);
    }
}

// One channel strip, 91.5 pt pitch. `master` switches to the master layout
// (white header, no sends, M only) and the master callbacks.
component Strip inherits Rectangle {
    in property <MixerStrip> s;
    in property <StripMeter> m;
    in property <bool> master;
    width: 91.5px;
    // Body click selects the track (declared first so controls stay on top).
    if !root.master && root.s.selected: Rectangle { y: 27px; height: parent.height - 27px; background: Tokens.bg-track-header-selected; }
    TouchArea { y: 44.5px; height: parent.height - 44.5px; clicked => { if (!root.master) { Studio.select-track(root.s.id); } } }
    // Name header (track colour)
    Rectangle {
        y: 26.5px; height: 18px;
        background: root.master ? Tokens.track-master : root.s.color;
        Text {
            x: 6.5px; width: parent.width - 12px; text: root.master ? "Master" : root.s.name;
            color: root.master ? #111215 : root.s.color.darker(4.5); font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide;
        }
        TouchArea { clicked => { if (!root.master) { Studio.select-track(root.s.id); } } }
    }
    // "Add effect" insert slot: PLACEHOLDER (no plug-in hosting yet)
    Rectangle {
        x: 7px; y: 51px; width: 77.5px; height: 17px; border-radius: 8.5px; background: #292a2e;
        Text { text: "–"; color: #8e8f93; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { Studio.chat-placeholder("Add effect"); } }
    }
    // Sends: PLACEHOLDER (no return tracks yet)
    if !root.master: Rectangle {
        x: 7px; y: 132.5px; width: 77.5px; height: 19.5px;
        Rectangle { y: 0; height: 0.5px; background: #343539; }
        Text { x: 1.5px; text: "Sends"; color: #8e8f93; font-size: 9.5px; font-weight: 500; vertical-alignment: center; }
        Icon { x: 33.5px; width: 9px; height: 9px; d: Icons.chevron-up; ink: #8e8f93; stroke-width: 1.4px; }
        Icon { x: 65.5px; width: 10px; height: 10px; d: Icons.plus; ink: #c9c9cc; stroke-width: 1.6px; }
        TouchArea { clicked => { Studio.chat-placeholder("Sends"); } }
    }
    Rectangle { x: 7px; y: 151.5px; width: 77.5px; height: 0.5px; background: #343539; }
    // Pan knob + numeric readout (real for tracks; master pan is a PLACEHOLDER)
    Knob {
        x: 5px; y: 155px; width: 39px; height: 38px; body: 26.5px; ring: false;
        value: root.s.pan; value-angle: root.master ? 0 : root.s.pan * 135; tick-color: #d8d8da;
        value-changed(v) => { if (!root.master) { Studio.track-pan(root.s.id, v); } }
        released => { Studio.gesture-end(); }
        reset => { if (!root.master) { Studio.track-pan(root.s.id, 0); Studio.gesture-end(); } }
    }
    Raised {
        x: 49px; y: 166.5px; width: 33.5px; height: 14.5px; border-radius: 3px; outline: true; rim: Tokens.box-rim;
        Text { text: root.master ? "0.0" : root.s.pan-text; color: #e5e5e8; font-size: 9.75px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    // dB scale
    for mk in [ {t: "+6", y: 206.5px}, {t: "0", y: 223px}, {t: "−6", y: 237px}, {t: "−12", y: 251px},
                {t: "−24", y: 277.5px}, {t: "−36", y: 304px}, {t: "−48", y: 324px}, {t: "−∞", y: 349.5px} ]: Rectangle {
        x: 0; y: mk.y - 5px; width: 39px; height: 10px;
        Text { x: 0; width: 29.5px; text: mk.t; color: #a5a5a8; font-size: 7.25px; horizontal-alignment: right; vertical-alignment: center; }
        Rectangle { x: 31.5px; width: 6px; height: 0.75px; background: #6d6e71; }
    }
    StripFader {
        x: 39px; y: 196px;
        fader: root.s.fader; fill: root.master ? Tokens.track-master : root.s.color;
        moved(f) => { if (root.master) { Studio.master-fader-moved(f); } else { Studio.mixer-fader(root.s.id, f); } }
        released => { Studio.gesture-end(); }
    }
    MeterBar { x: 61.5px; y: 196px; level: root.m.l; }
    MeterBar { x: 67.5px; y: 196px; level: root.m.r; }
    // M / S. Master mute is a PLACEHOLDER (no master mute in the model).
    SmallButton {
        x: 14px; y: 368.5px; width: 15px; height: 14px; soft: true; text: "M"; font-size: 7.5px;
        on: !root.master && root.s.mute; on-color: Tokens.mute-on;
        clicked => { if (root.master) { Studio.chat-placeholder("Master mute"); } else { Studio.track-mute(root.s.id); } }
    }
    if !root.master: SmallButton {
        x: 32px; y: 368.5px; width: 15.5px; height: 14px; soft: true; text: "S"; font-size: 7.5px;
        on: root.s.solo; on-color: Tokens.solo-on;
        clicked => { Studio.track-solo(root.s.id); }
    }
    // Peak hold readout; click resets.
    Rectangle {
        x: 49px; y: 367px; width: 35px; height: 17px;
        Text { text: root.m.peak; color: #8e8f93; font-size: 8.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { Studio.reset-peaks(); } }
    }
    // Strip separator
    Rectangle {
        x: root.master ? 0 : parent.width - 0.5px; y: 26.5px; width: 0.5px; height: parent.height - 26.5px;
        background: !root.master && root.s.selected ? #343539 : Tokens.line-separator;
    }
}

export component MixerPanel inherits Panel {
    // Tabs: clicking either returns to the clip/devices view (closes the mixer).
    Text { x: 6px; y: 7px; height: 14px; text: "Clip"; color: #6c6d71; font-size: 10px; font-weight: 600; vertical-alignment: center;
        TouchArea { clicked => { Studio.toggle-mixer(); } } }
    Text { x: 31px; y: 7px; height: 14px; text: "Devices"; color: #6c6d71; font-size: 10px; font-weight: 600; vertical-alignment: center;
        TouchArea { clicked => { Studio.toggle-mixer(); } } }
    // Collapse the bottom panel: PLACEHOLDER (panel collapse not implemented)
    IconButton { x: root.width - 29px; y: 3px; width: 21px; height: 21px; icon: Icons.download; ink: #6b6c70; icon-size: 14px;
        tooltip: "Collapse the bottom panel (not implemented)"; clicked => { Studio.chat-placeholder("Collapse panel"); } }
    Rectangle { x: 0; y: 26.5px; width: root.width; height: 0.5px; background: Tokens.line-separator; }

    // Strips + "Add track" column, scrolled horizontally when they don't fit.
    strips := Rectangle {
        x: 0; y: 0; width: root.width - 92.5px; height: root.height;
        clip: true;
        property <length> content-w: Studio.strips.length * 91.5px + 92px;
        property <length> max-scroll: max(0px, self.content-w - self.width);
        property <length> scroll: 0px;
        TouchArea {
            scroll-event(e) => {
                parent.scroll = max(0px, min(parent.max-scroll, parent.scroll - e.delta-x - e.delta-y));
                accept
            }
        }
        for st[i] in Studio.strips: Strip {
            x: i * 91.5px - parent.scroll; y: 0; height: parent.height;
            s: st; m: Studio.strip-meters[i];
        }
        Rectangle {
            x: Studio.strips.length * 91.5px - parent.scroll; y: 27px; width: 92px; height: parent.height - 27px;
            Icon { x: (parent.width - 13px) / 2; y: 165.5px; width: 13px; height: 13px; d: Icons.plus; ink: Tokens.text-tertiary; stroke-width: 1.4px; }
            Text { x: 0; y: 182px; width: parent.width; height: 14px; text: "Add track"; color: Tokens.text-tertiary; font-size: 10px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { Studio.add-track(); } }
        }
        // Horizontal scroll indicator (only when strips overflow)
        if strips.max-scroll > 0: Rectangle {
            x: strips.scroll / strips.content-w * strips.width; y: strips.height - 4px;
            width: strips.width * strips.width / strips.content-w; height: 2.5px; border-radius: 1.25px; background: #3a3b3f;
        }
    }
    Strip {
        x: root.width - 92px; y: 0; height: root.height; width: 92px; master: true;
        s: { id: -1, name: "Master", color: Tokens.track-master, fader: Studio.master-fader, pan-text: "0.0" };
        m: { l: Studio.master-meter-l, r: Studio.master-meter-r, peak: Studio.master-peak-text };
    }
}
